<%- include("../partials/head", { pageTitle }) %>
<link href="/public/css/report-editor.css?v=<%= appVersion %>" rel="stylesheet" />
<%
  function formatDateShort(value) {
    if (!value) return "-";
    const raw = String(value).trim();
    const iso = raw.match(/^(\d{4})-(\d{2})-(\d{2})/);
    if (iso) return `${iso[3]}/${iso[2]}/${iso[1]}`;
    const date = new Date(raw);
    if (Number.isNaN(date.getTime())) return "-";
    const day = String(date.getDate()).padStart(2, "0");
    const month = String(date.getMonth() + 1).padStart(2, "0");
    const year = String(date.getFullYear());
    return `${day}/${month}/${year}`;
  }
%>

<section class="token-console">
  <div class="card app-card token-hero-card">
    <div class="card-body token-hero-body">
      <div class="token-hero-copy">
        <span class="token-hero-eyebrow">MEDIÇÕES UPS</span>
        <h1 class="h4 app-card-title mb-1"><%= order.service_order_display || "-" %></h1>
        <p class="text-muted mb-0"><%= order.title %> - <%= order.customer_name %></p>
      </div>
      <div class="token-hero-actions">
        <span class="badge text-bg-secondary">Status: <%= order.status || "draft" %></span>
        <% if (order.opening_date) { %><span class="badge text-bg-light border">Abertura: <%= formatDateShort(order.opening_date) %></span><% } %>
        <a class="btn btn-outline-secondary btn-sm" href="/admin/report-service/orders/<%= order.id %>/measurements">Ensaios/Medições</a>
        <a class="btn btn-outline-secondary btn-sm" href="/admin/report-service/orders/<%= order.id %>/event-log">Event Log UPS</a>
        <a class="btn btn-outline-secondary btn-sm" href="/admin/report-service/orders/<%= order.id %>/report-editor"><%= t("rs.nav.editReport") %></a>
        <a class="btn btn-outline-secondary btn-sm" href="/admin/report-service/orders/<%= order.id %>/preview-html" target="_blank" rel="noopener"><%= t("rs.nav.previewReport") %></a>
      </div>
    </div>
  </div>

  <% if (saved) { %><div class="alert alert-success mb-0">Medições UPS salvas com sucesso.</div><% } %>
  <% if (editLocked) { %><div class="alert alert-warning mb-0">OS aprovada. Edição bloqueada. Use <strong>Revalidar OS</strong> para liberar.</div><% } %>

  <div class="card app-card" id="ups-card">
    <div class="card-body">
      <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div>
          <h2 class="h6 app-card-title mb-1">Medições UPS</h2>
          <div class="text-muted small">Importe o arquivo <code>Measures.xls</code> e use a tag <code>@mesuaresUPS=ID</code> nos capítulos do relatório.</div>
        </div>
        <button class="btn btn-outline-secondary btn-sm d-none" type="button" id="upsCancelEditBtn">Cancelar edição</button>
      </div>

      <form method="post" action="/admin/report-service/orders/<%= order.id %>/ups-measures" id="ups-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <input type="hidden" name="return_to" value="ups-measures" />
        <input type="hidden" name="ups_id" id="upsIdInput" value="" />
        <input type="hidden" name="header_json" id="upsHeaderInput" value="" />
        <input type="hidden" name="sections_json" id="upsSectionsInput" value="" />

        <div class="row g-2 mb-2">
          <div class="col-12 col-md-9"><input class="form-control form-control-sm" name="title" id="upsTitleInput" placeholder="Título / Modelo (ex: EXM400 Monolithic...)" required /></div>
          <div class="col-12 col-md-3"><input class="form-control form-control-sm" name="sort_order" id="upsSortInput" placeholder="Ordem" /></div>
        </div>

        <div class="d-flex align-items-center gap-2 mb-3 flex-wrap">
          <button class="btn btn-outline-primary btn-sm" type="button" id="upsImportBtn">Importar Measures.xls</button>
          <input type="file" accept=".xls,.xlsx" id="upsFileInput" class="d-none" />
          <span class="text-muted small" id="upsFileName"></span>
          <span class="spinner-border spinner-border-sm text-primary d-none" id="upsSpinner" role="status"></span>
          <span class="text-danger small" id="upsImportMsg"></span>
        </div>

        <!-- Cabeçalho (serial / firmware) -->
        <div class="mb-3">
          <div class="d-flex justify-content-between align-items-center mb-1">
            <strong class="small">Cabeçalho (série / firmware)</strong>
            <button class="btn btn-outline-secondary btn-sm" type="button" id="upsAddHeaderBtn">+ Linha</button>
          </div>
          <div class="table-responsive">
            <table class="table table-sm app-table mb-0" id="upsHeaderTable"><tbody></tbody></table>
          </div>
        </div>

        <!-- Seções de medições -->
        <div class="d-flex justify-content-between align-items-center mb-1">
          <strong class="small">Seções de medições</strong>
          <button class="btn btn-outline-secondary btn-sm" type="button" id="upsAddSectionBtn">+ Seção</button>
        </div>
        <div id="upsSectionsContainer"></div>

        <div class="mt-2"><textarea class="form-control form-control-sm" name="notes" id="upsNotesInput" rows="2" placeholder="Observações abaixo das tabelas"></textarea></div>
        <div class="d-flex justify-content-end mt-2">
          <button class="btn btn-primary btn-sm" type="submit" id="upsSubmitBtn">Salvar medições UPS</button>
        </div>
      </form>

      <div class="table-responsive mt-3">
        <table class="table table-sm app-table mb-0">
          <thead><tr><th>ID</th><th>Título</th><th>Cabeçalho</th><th>Seções</th><th>Tag</th><th>Ações</th></tr></thead>
          <tbody>
            <% if (!(upsMeasures || []).length) { %><tr><td colspan="6" class="text-center text-muted py-3">Sem medições UPS.</td></tr><% } %>
            <% (upsMeasures || []).forEach((item) => { %>
              <tr>
                <td><code><%= item.seq_id %></code></td>
                <td><%= item.title || "-" %></td>
                <td><%= Array.isArray(item.header_json) ? item.header_json.length : 0 %></td>
                <td><%= Array.isArray(item.sections_json) ? item.sections_json.length : 0 %></td>
                <td><code>@mesuaresUPS=<%= item.seq_id %></code></td>
                <td>
                  <div class="d-flex gap-1 flex-wrap">
                    <button class="btn btn-outline-primary btn-sm ups-edit-btn" type="button" data-ups-id="<%= item.id %>">Editar</button>
                    <button class="btn btn-outline-secondary btn-sm ups-style-btn" type="button"
                      data-ups-id="<%= item.id %>"
                      data-order-id="<%= order.id %>"
                      data-has-style="<%= item.style_config && !item._uses_default_ups_style ? '1' : '0' %>">
                      🎨 Visual<% if (item.style_config && item._uses_default_ups_style) { %> <span class="badge text-bg-secondary" style="font-size:9px;">padrão</span><% } else if (item.style_config) { %> <span class="badge text-bg-success" style="font-size:9px;">custom</span><% } %>
                    </button>
                    <form method="post" action="/admin/report-service/orders/<%= order.id %>/ups-measures/<%= item.id %>/delete" class="m-0" onsubmit="return confirm('Excluir estas medições UPS?');">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                      <input type="hidden" name="return_to" value="ups-measures" />
                      <button class="btn btn-outline-danger btn-sm" type="submit">Excluir</button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

<script>
  window.upsMeasuresIndex = <%- JSON.stringify(
    (upsMeasures || []).map(function (item) {
      return {
        id: Number(item.id || 0),
        title: item.title || "",
        notes: item.notes || "",
        sortOrder: Number(item.sort_order || 0),
        header: Array.isArray(item.header_json) ? item.header_json : [],
        sections: Array.isArray(item.sections_json) ? item.sections_json : []
      };
    })
  ).replace(/</g, "\\u003c") %>;
</script>
<script>
  (function () {
    var form = document.getElementById("ups-form");
    if (!form) return;

    var idInput = document.getElementById("upsIdInput");
    var titleInput = document.getElementById("upsTitleInput");
    var sortInput = document.getElementById("upsSortInput");
    var notesInput = document.getElementById("upsNotesInput");
    var headerInput = document.getElementById("upsHeaderInput");
    var sectionsInput = document.getElementById("upsSectionsInput");
    var headerTbody = document.querySelector("#upsHeaderTable tbody");
    var sectionsContainer = document.getElementById("upsSectionsContainer");
    var submitBtn = document.getElementById("upsSubmitBtn");
    var cancelBtn = document.getElementById("upsCancelEditBtn");
    var csrfToken = (form.querySelector('[name="_csrf"]') || {}).value || "";

    var DEFAULT_COLUMNS = ["ID", "Signal Name", "Signal Value", "Unit"];
    var header = [];   // [{label, value}]
    var sections = []; // [{title, columns:[...], rows:[[...]]}]

    function esc(value) {
      return String(value == null ? "" : value)
        .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
    }

    function normalizeSection(section) {
      var cols = Array.isArray(section.columns) && section.columns.length ? section.columns.slice() : DEFAULT_COLUMNS.slice();
      var rows = (Array.isArray(section.rows) ? section.rows : []).map(function (row) {
        var src = Array.isArray(row) ? row : [];
        var next = [];
        for (var i = 0; i < cols.length; i++) next.push(String(src[i] == null ? "" : src[i]));
        return next;
      });
      if (!rows.length) rows.push(cols.map(function () { return ""; }));
      return { title: String(section.title || ""), columns: cols, rows: rows };
    }

    function renderHeader() {
      if (!header.length) header.push({ label: "", value: "" });
      headerTbody.innerHTML = header.map(function (h, i) {
        return '<tr>'
          + '<td><input class="form-control form-control-sm ups-h-label" data-i="' + i + '" value="' + esc(h.label) + '" placeholder="Rótulo" /></td>'
          + '<td><input class="form-control form-control-sm ups-h-value" data-i="' + i + '" value="' + esc(h.value) + '" placeholder="Valor" /></td>'
          + '<td class="measurement-actions-col"><button class="btn btn-outline-danger btn-sm ups-h-remove" type="button" data-i="' + i + '">x</button></td>'
          + '</tr>';
      }).join("");
    }

    function renderSections() {
      if (!sections.length) sections.push(normalizeSection({ title: "Measurements", columns: DEFAULT_COLUMNS.slice(), rows: [] }));
      sectionsContainer.innerHTML = sections.map(function (section, sIdx) {
        var cols = section.columns;
        var head = '<tr>' + cols.map(function (col, cIdx) {
          return '<th><div class="measurement-column-head"><input class="form-control form-control-sm ups-col" data-s="' + sIdx + '" data-c="' + cIdx + '" value="' + esc(col) + '" />'
            + '<button class="btn btn-outline-danger btn-sm ups-col-remove" type="button" data-s="' + sIdx + '" data-c="' + cIdx + '">x</button></div></th>';
        }).join("") + '<th class="measurement-actions-col">Ações</th></tr>';
        var body = section.rows.map(function (row, rIdx) {
          var cells = cols.map(function (_c, cIdx) {
            return '<td><input class="form-control form-control-sm ups-cell" data-s="' + sIdx + '" data-r="' + rIdx + '" data-c="' + cIdx + '" value="' + esc(row[cIdx] || "") + '" /></td>';
          }).join("");
          return '<tr>' + cells + '<td class="measurement-actions-col"><button class="btn btn-outline-danger btn-sm ups-row-remove" type="button" data-s="' + sIdx + '" data-r="' + rIdx + '">Excluir</button></td></tr>';
        }).join("");
        return '<div class="card border mb-2 ups-section" data-s="' + sIdx + '">'
          + '<div class="card-body p-2">'
          + '<div class="d-flex gap-2 align-items-center mb-2">'
          + '<input class="form-control form-control-sm ups-section-title" data-s="' + sIdx + '" value="' + esc(section.title) + '" placeholder="Título da seção" />'
          + '<button class="btn btn-outline-secondary btn-sm ups-add-col" type="button" data-s="' + sIdx + '">+ Coluna</button>'
          + '<button class="btn btn-outline-secondary btn-sm ups-add-row" type="button" data-s="' + sIdx + '">+ Linha</button>'
          + '<button class="btn btn-outline-danger btn-sm ups-remove-section" type="button" data-s="' + sIdx + '">Excluir seção</button>'
          + '</div>'
          + '<div class="table-responsive measurement-builder-wrap"><table class="table table-sm app-table measurement-builder-table mb-0"><thead>' + head + '</thead><tbody>' + body + '</tbody></table></div>'
          + '</div></div>';
      }).join("");
    }

    function renderAll() {
      renderHeader();
      renderSections();
    }

    function syncFromDom() {
      // header
      document.querySelectorAll(".ups-h-label").forEach(function (el) {
        var i = Number(el.getAttribute("data-i")); if (!header[i]) header[i] = { label: "", value: "" }; header[i].label = String(el.value || "");
      });
      document.querySelectorAll(".ups-h-value").forEach(function (el) {
        var i = Number(el.getAttribute("data-i")); if (!header[i]) header[i] = { label: "", value: "" }; header[i].value = String(el.value || "");
      });
      // section titles + columns + cells
      document.querySelectorAll(".ups-section-title").forEach(function (el) {
        var s = Number(el.getAttribute("data-s")); if (sections[s]) sections[s].title = String(el.value || "");
      });
      document.querySelectorAll(".ups-col").forEach(function (el) {
        var s = Number(el.getAttribute("data-s")); var c = Number(el.getAttribute("data-c"));
        if (sections[s] && sections[s].columns) sections[s].columns[c] = String(el.value || "");
      });
      document.querySelectorAll(".ups-cell").forEach(function (el) {
        var s = Number(el.getAttribute("data-s")); var r = Number(el.getAttribute("data-r")); var c = Number(el.getAttribute("data-c"));
        if (sections[s] && sections[s].rows[r]) sections[s].rows[r][c] = String(el.value || "");
      });
    }

    // ---- Header actions ----
    document.getElementById("upsAddHeaderBtn").addEventListener("click", function () {
      syncFromDom(); header.push({ label: "", value: "" }); renderHeader();
    });
    headerTbody.addEventListener("click", function (event) {
      var btn = event.target.closest(".ups-h-remove");
      if (!btn) return;
      syncFromDom();
      var i = Number(btn.getAttribute("data-i"));
      header.splice(i, 1);
      if (!header.length) header.push({ label: "", value: "" });
      renderHeader();
    });

    // ---- Section actions ----
    document.getElementById("upsAddSectionBtn").addEventListener("click", function () {
      syncFromDom();
      sections.push(normalizeSection({ title: "Nova seção", columns: DEFAULT_COLUMNS.slice(), rows: [] }));
      renderSections();
    });

    sectionsContainer.addEventListener("click", function (event) {
      var addCol = event.target.closest(".ups-add-col");
      if (addCol) {
        syncFromDom();
        var s = Number(addCol.getAttribute("data-s"));
        sections[s].columns.push("Nova coluna");
        sections[s].rows = sections[s].rows.map(function (row) { row.push(""); return row; });
        renderSections();
        return;
      }
      var addRow = event.target.closest(".ups-add-row");
      if (addRow) {
        syncFromDom();
        var sr = Number(addRow.getAttribute("data-s"));
        sections[sr].rows.push(sections[sr].columns.map(function () { return ""; }));
        renderSections();
        return;
      }
      var remSection = event.target.closest(".ups-remove-section");
      if (remSection) {
        syncFromDom();
        var ss = Number(remSection.getAttribute("data-s"));
        sections.splice(ss, 1);
        if (!sections.length) sections.push(normalizeSection({ title: "Measurements", columns: DEFAULT_COLUMNS.slice(), rows: [] }));
        renderSections();
        return;
      }
      var remCol = event.target.closest(".ups-col-remove");
      if (remCol) {
        syncFromDom();
        var cs = Number(remCol.getAttribute("data-s"));
        var cc = Number(remCol.getAttribute("data-c"));
        if (sections[cs].columns.length <= 1) return;
        sections[cs].columns.splice(cc, 1);
        sections[cs].rows = sections[cs].rows.map(function (row) { row.splice(cc, 1); return row; });
        renderSections();
        return;
      }
      var remRow = event.target.closest(".ups-row-remove");
      if (remRow) {
        syncFromDom();
        var rs = Number(remRow.getAttribute("data-s"));
        var rr = Number(remRow.getAttribute("data-r"));
        if (sections[rs].rows.length <= 1) return;
        sections[rs].rows.splice(rr, 1);
        renderSections();
      }
    });

    // ---- Reset / edit ----
    function resetForm() {
      idInput.value = "";
      titleInput.value = "";
      sortInput.value = "";
      notesInput.value = "";
      header = [{ label: "", value: "" }];
      sections = [normalizeSection({ title: "Measurements", columns: DEFAULT_COLUMNS.slice(), rows: [] })];
      submitBtn.textContent = "Salvar medições UPS";
      cancelBtn.classList.add("d-none");
      renderAll();
    }
    cancelBtn.addEventListener("click", resetForm);

    document.querySelectorAll(".ups-edit-btn").forEach(function (btn) {
      btn.addEventListener("click", function () {
        var id = Number(btn.getAttribute("data-ups-id") || 0);
        var item = (window.upsMeasuresIndex || []).find(function (e) { return Number(e.id) === id; });
        if (!item) return;
        idInput.value = String(item.id || "");
        titleInput.value = item.title || "";
        sortInput.value = item.sortOrder ? String(item.sortOrder) : "";
        notesInput.value = item.notes || "";
        header = (Array.isArray(item.header) && item.header.length)
          ? item.header.map(function (h) { return { label: String(h.label || ""), value: String(h.value || "") }; })
          : [{ label: "", value: "" }];
        sections = (Array.isArray(item.sections) && item.sections.length)
          ? item.sections.map(normalizeSection)
          : [normalizeSection({ title: "Measurements", columns: DEFAULT_COLUMNS.slice(), rows: [] })];
        submitBtn.textContent = "Salvar edição";
        cancelBtn.classList.remove("d-none");
        renderAll();
        document.getElementById("ups-card").scrollIntoView({ behavior: "smooth", block: "start" });
      });
    });

    // ---- Import .xls ----
    var importBtn = document.getElementById("upsImportBtn");
    var fileInput = document.getElementById("upsFileInput");
    var fileNameEl = document.getElementById("upsFileName");
    var spinner = document.getElementById("upsSpinner");
    var msgEl = document.getElementById("upsImportMsg");

    importBtn.addEventListener("click", function () { fileInput.value = ""; fileInput.click(); });

    fileInput.addEventListener("change", function () {
      var file = fileInput.files && fileInput.files[0];
      if (!file) return;
      fileNameEl.textContent = file.name;
      msgEl.textContent = "";
      spinner.classList.remove("d-none");
      importBtn.disabled = true;

      var reader = new FileReader();
      reader.onload = function (e) {
        fetch("/admin/report-service/orders/<%= order.id %>/ups-measures/upload", {
          method: "POST",
          headers: {
            "Content-Type": "application/octet-stream",
            "X-CSRF-Token": csrfToken,
            "x-file-name": encodeURIComponent(file.name)
          },
          body: e.target.result
        }).then(function (resp) {
          return resp.json().then(function (data) { return { ok: resp.ok, data: data }; });
        }).then(function (result) {
          spinner.classList.add("d-none");
          importBtn.disabled = false;
          if (!result.ok || !result.data || !result.data.ok) {
            msgEl.textContent = (result.data && result.data.error) || "Falha ao importar o arquivo.";
            return;
          }
          var parsed = result.data.data || {};
          idInput.value = "";
          titleInput.value = parsed.title || file.name.replace(/\.[^.]+$/, "");
          header = (Array.isArray(parsed.header) && parsed.header.length)
            ? parsed.header.map(function (h) { return { label: String(h.label || ""), value: String(h.value || "") }; })
            : [{ label: "", value: "" }];
          sections = (Array.isArray(parsed.sections) && parsed.sections.length)
            ? parsed.sections.map(normalizeSection)
            : [normalizeSection({ title: "Measurements", columns: DEFAULT_COLUMNS.slice(), rows: [] })];
          submitBtn.textContent = "Salvar medições UPS";
          cancelBtn.classList.add("d-none");
          renderAll();
          document.getElementById("ups-card").scrollIntoView({ behavior: "smooth", block: "start" });
        }).catch(function () {
          spinner.classList.add("d-none");
          importBtn.disabled = false;
          msgEl.textContent = "Falha na requisição.";
        });
      };
      reader.readAsArrayBuffer(file);
    });

    // ---- Submit ----
    form.addEventListener("submit", function () {
      syncFromDom();
      var cleanHeader = header.filter(function (h) { return String(h.label || "").trim() || String(h.value || "").trim(); });
      headerInput.value = JSON.stringify(cleanHeader);
      sectionsInput.value = JSON.stringify(sections.map(function (s) {
        return {
          title: String(s.title || ""),
          columns: s.columns.map(function (c) { return String(c || "").trim(); }).filter(Boolean),
          rows: s.rows
        };
      }));
    });

    resetForm();
  })();
</script>

<style>
  #upsStyleModal .usm-header { background: linear-gradient(135deg, #1e293b 0%, #334155 100%); color: #fff; padding: 14px 18px 12px; border-radius: 12px 12px 0 0; }
  #upsStyleModal .usm-preview-panel { flex: 1; min-width: 0; background: #f1f5f9; padding: 18px 20px; overflow-y: auto; display: flex; flex-direction: column; }
  #upsStyleModal .usm-paper { background: #fff; border-radius: 6px; box-shadow: 0 2px 16px rgba(0,0,0,0.10); padding: 22px 24px; flex: 1; position: relative; min-height: 180px; }
  #upsStyleModal .usm-paper-overlay { position: absolute; inset: 0; background: rgba(255,255,255,0.88); display: flex; flex-direction: column; align-items: center; justify-content: center; border-radius: 6px; z-index: 5; gap: 8px; }
  #upsStyleModal .usm-ai-panel { width: 310px; min-width: 240px; display: flex; flex-direction: column; border-left: 1px solid #e2e8f0; background: #fff; }
  #upsStyleModal .usm-ai-header { padding: 9px 14px; border-bottom: 1px solid #e2e8f0; background: #f8fafc; font-size: 11.5px; font-weight: 600; color: #475569; display: flex; align-items: center; gap: 6px; letter-spacing: 0.02em; }
  #upsStyleModal .usm-chat-area { flex: 1; overflow-y: auto; padding: 12px; display: flex; flex-direction: column; gap: 8px; min-height: 0; }
  #upsStyleModal .usm-bubble { max-width: 88%; padding: 8px 12px; border-radius: 12px; font-size: 12.5px; line-height: 1.5; word-break: break-word; }
  #upsStyleModal .usm-bubble.user { align-self: flex-end; background: #3b82f6; color: #fff; border-bottom-right-radius: 3px; }
  #upsStyleModal .usm-bubble.ai { align-self: flex-start; background: #f1f5f9; color: #334155; border: 1px solid #e2e8f0; border-bottom-left-radius: 3px; }
  #upsStyleModal .usm-bubble.err { align-self: flex-start; background: #fef2f2; color: #dc2626; border: 1px solid #fecaca; border-bottom-left-radius: 3px; }
  #upsStyleModal .usm-typing span { display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: #94a3b8; margin: 0 2px; animation: usmPulse 1.2s ease-in-out infinite; }
  #upsStyleModal .usm-typing span:nth-child(2) { animation-delay: 0.2s; }
  #upsStyleModal .usm-typing span:nth-child(3) { animation-delay: 0.4s; }
  @keyframes usmPulse { 0%,60%,100% { transform:translateY(0);opacity:.4; } 30% { transform:translateY(-5px);opacity:1; } }
  #upsStyleModal .usm-chips { padding: 7px 12px; display: flex; flex-wrap: wrap; gap: 5px; border-top: 1px solid #f1f5f9; }
  #upsStyleModal .usm-chip { font-size: 11px; padding: 3px 9px; border-radius: 20px; border: 1px solid #cbd5e1; background: #f8fafc; color: #475569; cursor: pointer; transition: background .12s, border-color .12s; white-space: nowrap; user-select: none; }
  #upsStyleModal .usm-chip:hover { background: #e2e8f0; border-color: #94a3b8; color: #1e293b; }
  #upsStyleModal .usm-input-area { padding: 10px 12px; border-top: 1px solid #e2e8f0; background: #f8fafc; }
  #upsStyleModal .usm-unsaved { display: inline-flex; align-items: center; gap: 5px; font-size: 11px; color: #fbbf24; background: rgba(251,191,36,.15); border-radius: 20px; padding: 1px 8px; }
  #upsStyleModal .usm-unsaved-dot { width: 6px; height: 6px; border-radius: 50%; background: #fbbf24; flex-shrink: 0; }
</style>

<div class="modal fade" id="upsStyleModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-scrollable" style="max-width:1060px;">
    <div class="modal-content border-0 shadow-lg" style="border-radius:12px;overflow:hidden;">
      <div class="usm-header d-flex align-items-start gap-3">
        <div class="flex-grow-1">
          <div class="d-flex align-items-center gap-2 mb-1">
            <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="opacity:.85;flex-shrink:0;"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            <span style="font-size:14px;font-weight:600;letter-spacing:.01em;">Customizar Visual das Medições UPS</span>
            <span id="usmUnsavedBadge" class="usm-unsaved d-none"><span class="usm-unsaved-dot"></span>Não salvo</span>
          </div>
          <div id="usmTableName" style="font-size:12px;opacity:.6;padding-left:22px;">—</div>
        </div>
        <button type="button" class="btn-close btn-close-white flex-shrink-0" data-bs-dismiss="modal" aria-label="Fechar" style="margin-top:2px;"></button>
      </div>

      <div class="modal-body p-0 d-flex" style="height:560px;max-height:70vh;min-height:360px;">
        <div class="usm-preview-panel">
          <div class="d-flex align-items-center justify-content-between mb-2">
            <span style="font-size:10.5px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#64748b;">Visualização</span>
            <span id="usmPreviewHint" style="font-size:11px;color:#94a3b8;"></span>
          </div>
          <div class="usm-paper">
            <div class="usm-paper-overlay" id="usmOverlay">
              <div class="spinner-border text-primary" role="status" style="width:1.6rem;height:1.6rem;border-width:2.5px;"></div>
              <div style="font-size:12px;color:#64748b;">Gerando preview...</div>
            </div>
            <div id="usmPreviewContent"></div>
          </div>
        </div>

        <div class="usm-ai-panel">
          <div class="usm-ai-header">
            <svg width="13" height="13" fill="currentColor" viewBox="0 0 20 20" style="color:#6366f1;flex-shrink:0;"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            Assistente de Design IA
          </div>
          <div class="usm-chat-area" id="usmChatArea"></div>
          <div class="usm-chips">
            <span class="usm-chip" data-s="Centralizar texto em todas as células">Centralizar texto</span>
            <span class="usm-chip" data-s="Negrito em todas as células de dados">Negrito dados</span>
            <span class="usm-chip" data-s="Cabeçalho azul marinho, texto branco">Cabeçalho azul</span>
            <span class="usm-chip" data-s="Aumentar fonte das células para 13px">Fonte maior</span>
            <span class="usm-chip" data-s="Remover o fundo alternado nas linhas, deixar todas brancas">Sem zebra</span>
            <span class="usm-chip" data-s="Borda preta mais grossa 2px sólida">Borda grossa</span>
          </div>
          <div class="usm-input-area">
            <div class="d-flex gap-2 align-items-center">
              <input class="form-control form-control-sm flex-grow-1" id="usmInput" placeholder="Descreva a alteração desejada..." style="border-radius:18px;font-size:12.5px;" />
              <button class="btn btn-primary btn-sm d-flex align-items-center justify-content-center" id="usmSendBtn" type="button" style="border-radius:50%;width:32px;height:32px;flex-shrink:0;padding:0;">
                <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
              </button>
            </div>
          </div>
        </div>
      </div>

      <div class="modal-footer py-2" style="background:#f8fafc;border-top:1px solid #e2e8f0;">
        <button type="button" class="btn btn-sm btn-outline-secondary me-auto d-flex align-items-center gap-1" id="usmResetBtn">Restaurar padrão</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Fechar</button>
        <button type="button" class="btn btn-sm btn-outline-success d-flex align-items-center gap-1" id="usmDefaultBtn">Salvar como padrão</button>
        <button type="button" class="btn btn-sm btn-success d-flex align-items-center gap-1" id="usmSaveBtn">Salvar visual</button>
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    var modal = document.getElementById("upsStyleModal");
    if (!modal) return;
    var bsModal = null;
    function getModal() { if (!bsModal) bsModal = new bootstrap.Modal(modal); return bsModal; }

    var previewContent = document.getElementById("usmPreviewContent");
    var chatArea      = document.getElementById("usmChatArea");
    var overlay       = document.getElementById("usmOverlay");
    var inputEl       = document.getElementById("usmInput");
    var sendBtn       = document.getElementById("usmSendBtn");
    var saveBtn       = document.getElementById("usmSaveBtn");
    var defaultBtn    = document.getElementById("usmDefaultBtn");
    var resetBtn      = document.getElementById("usmResetBtn");
    var unsavedBadge  = document.getElementById("usmUnsavedBadge");
    var tableName     = document.getElementById("usmTableName");
    var previewHint   = document.getElementById("usmPreviewHint");

    var activeUpsId = null, activeOrderId = null, pendingStyle = null;
    var csrfToken = (document.querySelector('[name="_csrf"]') || {}).value || "";
    var typingEl = null;

    function setUnsaved(on) { unsavedBadge.classList.toggle("d-none", !on); saveBtn.disabled = !on && !pendingStyle; }
    function showOverlay(on) { overlay.style.display = on ? "flex" : "none"; }
    function setInputBusy(on) { sendBtn.disabled = on; inputEl.disabled = on; resetBtn.disabled = on; if (defaultBtn) defaultBtn.disabled = on; }

    function addBubble(type, text) {
      removeTyping();
      var div = document.createElement("div");
      div.className = "usm-bubble " + type;
      div.textContent = text;
      chatArea.appendChild(div);
      chatArea.scrollTop = chatArea.scrollHeight;
      return div;
    }
    function showTyping() {
      removeTyping();
      typingEl = document.createElement("div");
      typingEl.className = "usm-bubble ai usm-typing";
      typingEl.innerHTML = "<span></span><span></span><span></span>";
      chatArea.appendChild(typingEl);
      chatArea.scrollTop = chatArea.scrollHeight;
    }
    function removeTyping() { if (typingEl && typingEl.parentNode) typingEl.parentNode.removeChild(typingEl); typingEl = null; }
    function updatePreview(html) { previewContent.innerHTML = html || ""; }

    async function callAi(instruction, apply) {
      var body = new URLSearchParams();
      body.set("_csrf", csrfToken);
      if (instruction) body.set("instruction", instruction);
      if (pendingStyle) body.set("current_style", JSON.stringify(pendingStyle));
      if (apply) body.set("apply", "true");
      var resp = await fetch(
        "/admin/report-service/orders/" + activeOrderId + "/ups-measures/" + activeUpsId + "/style-ai",
        { method: "POST", headers: { "Content-Type": "application/x-www-form-urlencoded" }, body: body.toString() }
      );
      if (!resp.ok) { var data = await resp.json().catch(function () { return {}; }); throw new Error(data.error || "Erro na requisição."); }
      return resp.json();
    }
    async function callReset() {
      var body = new URLSearchParams();
      body.set("_csrf", csrfToken);
      var resp = await fetch(
        "/admin/report-service/orders/" + activeOrderId + "/ups-measures/" + activeUpsId + "/style-reset",
        { method: "POST", headers: { "Content-Type": "application/x-www-form-urlencoded" }, body: body.toString() }
      );
      if (!resp.ok) throw new Error("Erro ao resetar.");
      return resp.json();
    }
    async function callDefault() {
      var body = new URLSearchParams();
      body.set("_csrf", csrfToken);
      if (pendingStyle) body.set("current_style", JSON.stringify(pendingStyle));
      var resp = await fetch(
        "/admin/report-service/orders/" + activeOrderId + "/ups-measures/" + activeUpsId + "/style-default",
        { method: "POST", headers: { "Content-Type": "application/x-www-form-urlencoded" }, body: body.toString() }
      );
      if (!resp.ok) { var data = await resp.json().catch(function () { return {}; }); throw new Error(data.error || "Erro ao salvar padrão."); }
      return resp.json();
    }

    document.querySelectorAll(".ups-style-btn").forEach(function (btn) {
      btn.addEventListener("click", function () {
        activeUpsId   = Number(btn.getAttribute("data-ups-id") || 0);
        activeOrderId = btn.getAttribute("data-order-id") || "";
        pendingStyle  = null;
        chatArea.innerHTML = "";
        inputEl.value = "";
        previewHint.textContent = "";
        setUnsaved(false);
        saveBtn.disabled = true;
        if (defaultBtn) defaultBtn.disabled = true;

        var item = (window.upsMeasuresIndex || []).find(function (e) { return Number(e.id) === activeUpsId; });
        tableName.textContent = (item && item.title) ? item.title : "Medições UPS #" + activeUpsId;

        showOverlay(true);
        getModal().show();

        callAi(null, false).then(function (r) {
          showOverlay(false);
          updatePreview(r.previewHtml);
          pendingStyle = r.styleConfig || null;
          if (defaultBtn) defaultBtn.disabled = !pendingStyle;
          previewHint.textContent = "Envie uma instrução para personalizar";
          addBubble("ai", "Olá! Descreva o que deseja alterar no visual das tabelas UPS: cores, fontes, bordas, tamanhos ou alinhamento. Use os atalhos abaixo ou escreva livremente.");
        }).catch(function (err) {
          showOverlay(false);
          previewContent.innerHTML = "<p style='color:#dc2626;font-size:12px;'>Erro ao carregar preview: " + (err.message || "") + "</p>";
        });
      });
    });

    function sendInstruction() {
      var instruction = (inputEl.value || "").trim();
      if (!instruction || sendBtn.disabled) return;
      setInputBusy(true);
      addBubble("user", instruction);
      inputEl.value = "";
      showTyping();
      previewHint.textContent = "Aplicando alterações...";
      callAi(instruction, false).then(function (r) {
        removeTyping();
        updatePreview(r.previewHtml);
        pendingStyle = r.styleConfig || null;
        setUnsaved(true);
        saveBtn.disabled = false;
        if (defaultBtn) defaultBtn.disabled = false;
        previewHint.textContent = "Preview atualizado — salve quando estiver satisfeito";
        addBubble("ai", "Feito! Verifique o preview ao lado. Você pode continuar ajustando ou salvar.");
      }).catch(function (err) {
        removeTyping();
        addBubble("err", "Erro: " + (err.message || "Falha na IA."));
        previewHint.textContent = "";
      }).finally(function () { setInputBusy(false); inputEl.focus(); });
    }

    sendBtn.addEventListener("click", sendInstruction);
    inputEl.addEventListener("keydown", function (e) { if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); sendInstruction(); } });
    modal.querySelectorAll(".usm-chip").forEach(function (chip) {
      chip.addEventListener("click", function () { inputEl.value = chip.getAttribute("data-s") || ""; inputEl.focus(); });
    });

    function markBtnState(state) {
      var styleBtn = document.querySelector('.ups-style-btn[data-ups-id="' + activeUpsId + '"]');
      if (!styleBtn) return;
      var badge = styleBtn.querySelector(".badge");
      if (badge) badge.remove();
      if (state === "custom") {
        styleBtn.setAttribute("data-has-style", "1");
        styleBtn.insertAdjacentHTML("beforeend", ' <span class="badge text-bg-success" style="font-size:9px;">custom</span>');
      } else if (state === "padrao") {
        styleBtn.setAttribute("data-has-style", "0");
        styleBtn.insertAdjacentHTML("beforeend", ' <span class="badge text-bg-secondary" style="font-size:9px;">padrão</span>');
      } else {
        styleBtn.setAttribute("data-has-style", "0");
      }
    }

    saveBtn.addEventListener("click", function () {
      if (!pendingStyle) return;
      setInputBusy(true);
      saveBtn.disabled = true;
      callAi(null, true).then(function () {
        markBtnState("custom");
        setUnsaved(false);
        getModal().hide();
      }).catch(function (err) {
        addBubble("err", "Erro ao salvar: " + (err.message || "Tente novamente."));
        saveBtn.disabled = false;
      }).finally(function () { setInputBusy(false); });
    });

    if (defaultBtn) {
      defaultBtn.addEventListener("click", function () {
        if (!pendingStyle) return;
        setInputBusy(true);
        defaultBtn.disabled = true;
        callDefault().then(function (r) {
          updatePreview(r.previewHtml);
          pendingStyle = r.styleConfig || pendingStyle;
          markBtnState("custom");
          setUnsaved(false);
          saveBtn.disabled = true;
          previewHint.textContent = "Estilo salvo como padrão para novas tabelas UPS";
          addBubble("ai", "Este visual foi salvo como padrão. Outras medições UPS sem estilo próprio usarão este visual automaticamente.");
        }).catch(function (err) {
          addBubble("err", "Erro ao salvar padrão: " + (err.message || "Tente novamente."));
        }).finally(function () { setInputBusy(false); defaultBtn.disabled = !pendingStyle; });
      });
    }

    resetBtn.addEventListener("click", function () {
      if (!confirm("Restaurar o visual padrão destas medições UPS?")) return;
      setInputBusy(true);
      callReset().then(function (r) {
        updatePreview(r.previewHtml);
        pendingStyle = r.styleConfig || null;
        chatArea.innerHTML = "";
        setUnsaved(false);
        saveBtn.disabled = true;
        if (defaultBtn) defaultBtn.disabled = !pendingStyle;
        previewHint.textContent = "Visual padrão restaurado";
        addBubble("ai", "Visual restaurado para o padrão. Envie novas instruções para personalizar novamente.");
        markBtnState(pendingStyle ? "padrao" : "none");
      }).catch(function (err) {
        addBubble("err", "Erro ao restaurar: " + (err.message || "Tente novamente."));
      }).finally(function () { setInputBusy(false); });
    });
  })();
</script>
<%- include("../partials/footer") %>
