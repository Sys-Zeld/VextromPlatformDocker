    <div class="modal-content border-0 shadow-lg" style="border-radius:12px;overflow:hidden;">

      <div class="msm-header d-flex align-items-start gap-3">
        <div class="flex-grow-1">
          <div class="d-flex align-items-center gap-2 mb-1">
            <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="opacity:.85;flex-shrink:0;"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            <span style="font-size:14px;font-weight:600;letter-spacing:.01em;">Customizar Visual da Tabela</span>
            <span id="msmUnsavedBadge" class="msm-unsaved d-none"><span class="msm-unsaved-dot"></span>Não salvo</span>
          </div>
          <div id="msmTableName" style="font-size:12px;opacity:.6;padding-left:22px;">—</div>
        </div>
        <button type="button" class="btn-close btn-close-white flex-shrink-0" data-bs-dismiss="modal" aria-label="Fechar" style="margin-top:2px;"></button>
      </div>

      <div class="modal-body p-0 d-flex" style="height:560px;max-height:70vh;min-height:360px;">

        <div class="msm-preview-panel">
          <div class="d-flex align-items-center justify-content-between mb-2">
            <span style="font-size:10.5px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#64748b;">Visualização</span>
            <span id="msmPreviewHint" style="font-size:11px;color:#94a3b8;"></span>
          </div>
          <div class="msm-paper">
            <div class="msm-paper-overlay" id="msmOverlay">
              <div class="spinner-border text-primary" role="status" style="width:1.6rem;height:1.6rem;border-width:2.5px;"></div>
              <div style="font-size:12px;color:#64748b;">Gerando preview...</div>
            </div>
            <div id="msmPreviewContent"></div>
          </div>
        </div>

        <div class="msm-ai-panel">
          <div class="msm-ai-header">
            <svg width="13" height="13" fill="currentColor" viewBox="0 0 20 20" style="color:#6366f1;flex-shrink:0;"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            Assistente de Design IA
          </div>
          <div class="msm-chat-area" id="msmChatArea"></div>
          <div class="msm-chips">
            <span class="msm-chip" data-s="Centralizar texto em todas as células">Centralizar texto</span>
            <span class="msm-chip" data-s="Negrito em todas as células de dados">Negrito dados</span>
            <span class="msm-chip" data-s="Cabeçalho azul marinho, texto branco">Cabeçalho azul</span>
            <span class="msm-chip" data-s="Aumentar fonte das células para 13px">Fonte maior</span>
            <span class="msm-chip" data-s="Remover o fundo alternado nas linhas, deixar todas brancas">Sem zebra</span>
            <span class="msm-chip" data-s="Borda preta mais grossa 2px sólida">Borda grossa</span>
            <span class="msm-chip" data-s="Itálico nas células de dados">Itálico dados</span>
          </div>
          <div class="msm-input-area">
            <div class="d-flex gap-2 align-items-center">
              <input class="form-control form-control-sm flex-grow-1" id="msmInput" placeholder="Descreva a alteração desejada..." style="border-radius:18px;font-size:12.5px;" />
              <button class="btn btn-primary btn-sm d-flex align-items-center justify-content-center" id="msmSendBtn" type="button" style="border-radius:50%;width:32px;height:32px;flex-shrink:0;padding:0;">
                <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
              </button>
            </div>
          </div>
        </div>
      </div>

      <div class="modal-footer py-2" style="background:#f8fafc;border-top:1px solid #e2e8f0;">
        <button type="button" class="btn btn-sm btn-outline-secondary me-auto d-flex align-items-center gap-1" id="msmResetBtn">
          <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
          Restaurar padrão
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Fechar</button>
        <button type="button" class="btn btn-sm btn-outline-success d-flex align-items-center gap-1" id="msmDefaultBtn">
          <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 5h14v14H5z"/><path stroke-linecap="round" stroke-linejoin="round" d="M9 9h6M9 13h6"/></svg>
          Salvar como padrão
        </button>
        <button type="button" class="btn btn-sm btn-success d-flex align-items-center gap-1" id="msmSaveBtn">
          <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          Salvar visual
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    var modal = document.getElementById("mStyleModal");
    if (!modal) return;
    var bsModal = null;
    function getModal() { if (!bsModal) bsModal = new bootstrap.Modal(modal); return bsModal; }

    var previewContent = document.getElementById("msmPreviewContent");
    var chatArea      = document.getElementById("msmChatArea");
    var overlay       = document.getElementById("msmOverlay");
    var inputEl       = document.getElementById("msmInput");
    var sendBtn       = document.getElementById("msmSendBtn");
    var saveBtn       = document.getElementById("msmSaveBtn");
    var defaultBtn    = document.getElementById("msmDefaultBtn");
    var resetBtn      = document.getElementById("msmResetBtn");
    var unsavedBadge  = document.getElementById("msmUnsavedBadge");
    var tableName     = document.getElementById("msmTableName");
    var previewHint   = document.getElementById("msmPreviewHint");

    var activeMeasId = null, activeOrderId = null, pendingStyle = null;
    var csrfToken = (document.querySelector('[name="_csrf"]') || {}).value || "";
    var typingEl = null;

    function setUnsaved(on) {
      unsavedBadge.classList.toggle("d-none", !on);
      saveBtn.disabled = !on && !pendingStyle;
    }

    function showOverlay(on) {
      overlay.style.display = on ? "flex" : "none";
    }

    function setInputBusy(on) {
      sendBtn.disabled = on;
      inputEl.disabled = on;
      resetBtn.disabled = on;
      if (defaultBtn) defaultBtn.disabled = on;
    }

    function addBubble(type, text) {
      removeTyping();
      var div = document.createElement("div");
      div.className = "msm-bubble " + type;
      div.textContent = text;
      chatArea.appendChild(div);
      chatArea.scrollTop = chatArea.scrollHeight;
      return div;
    }

    function showTyping() {
      removeTyping();
      typingEl = document.createElement("div");
      typingEl.className = "msm-bubble ai msm-typing";
      typingEl.innerHTML = "<span></span><span></span><span></span>";
      chatArea.appendChild(typingEl);
      chatArea.scrollTop = chatArea.scrollHeight;
    }

    function removeTyping() {
      if (typingEl && typingEl.parentNode) typingEl.parentNode.removeChild(typingEl);
      typingEl = null;
    }

    function updatePreview(html) {
      previewContent.innerHTML = html || "";
    }

    async function callAi(instruction, apply) {
      var body = new URLSearchParams();
      body.set("_csrf", csrfToken);
      if (instruction) body.set("instruction", instruction);
      if (pendingStyle) body.set("current_style", JSON.stringify(pendingStyle));
      if (apply) body.set("apply", "true");
      var resp = await fetch(
        "/admin/report-service/orders/" + activeOrderId + "/measurements/" + activeMeasId + "/style-ai",
        { method: "POST", headers: { "Content-Type": "application/x-www-form-urlencoded" }, body: body.toString() }
      );
      if (!resp.ok) {
        var data = await resp.json().catch(function () { return {}; });
        throw new Error(data.error || "Erro na requisição.");
      }
      return resp.json();
    }

    async function callReset() {
      var body = new URLSearchParams();
      body.set("_csrf", csrfToken);
      var resp = await fetch(
        "/admin/report-service/orders/" + activeOrderId + "/measurements/" + activeMeasId + "/style-reset",
        { method: "POST", headers: { "Content-Type": "application/x-www-form-urlencoded" }, body: body.toString() }
      );
      if (!resp.ok) throw new Error("Erro ao resetar.");
      return resp.json();
    }

    async function callDefault() {
      var body = new URLSearchParams();
      body.set("_csrf", csrfToken);
      if (pendingStyle) body.set("current_style", JSON.stringify(pendingStyle));
      var resp = await fetch(
        "/admin/report-service/orders/" + activeOrderId + "/measurements/" + activeMeasId + "/style-default",
        { method: "POST", headers: { "Content-Type": "application/x-www-form-urlencoded" }, body: body.toString() }
      );
      if (!resp.ok) {
        var data = await resp.json().catch(function () { return {}; });
        throw new Error(data.error || "Erro ao salvar padrão.");
      }
      return resp.json();
    }

    // Abre o modal
    document.querySelectorAll(".measurement-style-btn").forEach(function (btn) {
      btn.addEventListener("click", function () {
        activeMeasId  = Number(btn.getAttribute("data-measurement-id") || 0);
        activeOrderId = btn.getAttribute("data-order-id") || "";
        pendingStyle  = null;
        chatArea.innerHTML = "";
        inputEl.value = "";
        previewHint.textContent = "";
        setUnsaved(false);
        saveBtn.disabled = true;
        if (defaultBtn) defaultBtn.disabled = true;

        var item = (window.measurementTablesIndex || []).find(function (e) { return Number(e.id) === activeMeasId; });
        tableName.textContent = (item && item.title) ? item.title : "Tabela #" + activeMeasId;

        showOverlay(true);
        getModal().show();

        callAi(null, false).then(function (r) {
          showOverlay(false);
          updatePreview(r.previewHtml);
          pendingStyle = r.styleConfig || null;
          if (defaultBtn) defaultBtn.disabled = !pendingStyle;
          previewHint.textContent = "Envie uma instrução para personalizar";
          addBubble("ai", "Olá! Descreva o que deseja alterar: cores, fontes, bordas, tamanhos, alinhamento ou estilos por coluna. Use os atalhos abaixo ou escreva livremente.");
        }).catch(function (err) {
          showOverlay(false);
          previewContent.innerHTML = "<p style='color:#dc2626;font-size:12px;'>Erro ao carregar preview: " + (err.message || "") + "</p>";
        });
      });
    });

    // Enviar instrução à IA
    function sendInstruction() {
      var instruction = (inputEl.value || "").trim();
      if (!instruction || sendBtn.disabled) return;
      setInputBusy(true);
      addBubble("user", instruction);
      inputEl.value = "";
      showTyping();
      previewHint.textContent = "Aplicando alterações...";
      callAi(instruction, false).then(function (r) {
        removeTyping();
        updatePreview(r.previewHtml);
        pendingStyle = r.styleConfig || null;
        setUnsaved(true);
        saveBtn.disabled = false;
        if (defaultBtn) defaultBtn.disabled = false;
        previewHint.textContent = "Preview atualizado — salve quando estiver satisfeito";
        addBubble("ai", "Feito! Verifique o preview ao lado. Você pode continuar ajustando ou salvar.");
      }).catch(function (err) {
        removeTyping();
        addBubble("err", "Erro: " + (err.message || "Falha na IA."));
        previewHint.textContent = "";
      }).finally(function () {
        setInputBusy(false);
        inputEl.focus();
      });
    }

    sendBtn.addEventListener("click", sendInstruction);
    inputEl.addEventListener("keydown", function (e) {
      if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); sendInstruction(); }
    });

    // Chips de sugestão
    modal.querySelectorAll(".msm-chip").forEach(function (chip) {
      chip.addEventListener("click", function () {
        inputEl.value = chip.getAttribute("data-s") || "";
        inputEl.focus();
      });
    });

    // Salvar
    saveBtn.addEventListener("click", function () {
      if (!pendingStyle) return;
      setInputBusy(true);
      saveBtn.disabled = true;
      callAi(null, true).then(function () {
        var styleBtn = document.querySelector('.measurement-style-btn[data-measurement-id="' + activeMeasId + '"]');
        if (styleBtn) {
          styleBtn.setAttribute("data-has-style", "1");
          var badge = styleBtn.querySelector(".badge");
          if (badge) badge.remove();
          styleBtn.insertAdjacentHTML("beforeend", ' <span class="badge text-bg-success" style="font-size:9px;">custom</span>');
        }
        setUnsaved(false);
        getModal().hide();
      }).catch(function (err) {
        addBubble("err", "Erro ao salvar: " + (err.message || "Tente novamente."));
        saveBtn.disabled = false;
      }).finally(function () {
        setInputBusy(false);
      });
    });

    if (defaultBtn) {
      defaultBtn.addEventListener("click", function () {
        if (!pendingStyle) return;
        setInputBusy(true);
        defaultBtn.disabled = true;
        callDefault().then(function (r) {
          updatePreview(r.previewHtml);
          pendingStyle = r.styleConfig || pendingStyle;
          var styleBtn = document.querySelector('.measurement-style-btn[data-measurement-id="' + activeMeasId + '"]');
          if (styleBtn) {
            styleBtn.setAttribute("data-has-style", "1");
            var badge = styleBtn.querySelector(".badge");
            if (badge) badge.remove();
            styleBtn.insertAdjacentHTML("beforeend", ' <span class="badge text-bg-success" style="font-size:9px;">custom</span>');
          }
          setUnsaved(false);
          saveBtn.disabled = true;
          previewHint.textContent = "Estilo salvo como padrão para novas tabelas";
          addBubble("ai", "Este visual foi salvo como padrão. Outras tabelas de ensaios sem estilo próprio usarão este visual automaticamente.");
        }).catch(function (err) {
          addBubble("err", "Erro ao salvar padrão: " + (err.message || "Tente novamente."));
        }).finally(function () {
          setInputBusy(false);
          defaultBtn.disabled = !pendingStyle;
        });
      });
    }

    // Resetar
    resetBtn.addEventListener("click", function () {
      if (!confirm("Restaurar o visual padrão desta tabela?")) return;
      setInputBusy(true);
      callReset().then(function (r) {
        updatePreview(r.previewHtml);
        pendingStyle = r.styleConfig || null;
        chatArea.innerHTML = "";
        setUnsaved(false);
        saveBtn.disabled = true;
        if (defaultBtn) defaultBtn.disabled = !pendingStyle;
        previewHint.textContent = "Visual padrão restaurado";
        addBubble("ai", "Visual restaurado para o padrão. Envie novas instruções para personalizar novamente.");
        var styleBtn = document.querySelector('.measurement-style-btn[data-measurement-id="' + activeMeasId + '"]');
        if (styleBtn) {
          styleBtn.setAttribute("data-has-style", "0");
          var badge = styleBtn.querySelector(".badge");
          if (badge) badge.remove();
          if (pendingStyle) {
            styleBtn.insertAdjacentHTML("beforeend", ' <span class="badge text-bg-secondary" style="font-size:9px;">padrão</span>');
          }
        }
      }).catch(function (err) {
        addBubble("err", "Erro ao restaurar: " + (err.message || "Tente novamente."));
      }).finally(function () {
        setInputBusy(false);
      });
    });
  })();
</script>
<%- include("../partials/footer") %>
