<script>
(function () {
  var orderId = <%= order.id %>;
  var csrfToken = "<%= csrfToken %>";
  var baseUrl = "/admin/report-service/orders/" + orderId + "/attachments";

  function formatBytes(bytes) {
    if (!bytes) return "0 B";
    var b = Number(bytes);
    if (b < 1024) return b + " B";
    if (b < 1024 * 1024) return (b / 1024).toFixed(1) + " KB";
    return (b / (1024 * 1024)).toFixed(2) + " MB";
  }

  function formatDate(iso) {
    if (!iso) return "-";
    var d = new Date(iso);
    if (isNaN(d.getTime())) return "-";
    var dd = String(d.getDate()).padStart(2, "0");
    var mm = String(d.getMonth() + 1).padStart(2, "0");
    var yyyy = d.getFullYear();
    var hh = String(d.getHours()).padStart(2, "0");
    var min = String(d.getMinutes()).padStart(2, "0");
    return dd + "/" + mm + "/" + yyyy + " " + hh + ":" + min;
  }

  function showFeedback(msg, type) {
    var el = document.getElementById("attach-feedback");
    if (!el) return;
    el.className = "alert py-2 mb-3 alert-" + (type || "info");
    el.textContent = msg;
    el.classList.remove("d-none");
    setTimeout(function () { el.classList.add("d-none"); }, 5000);
  }

  function renderRows(items) {
    var tbody = document.getElementById("attach-tbody");
    var emptyRow = document.getElementById("attach-empty-row");
    if (!tbody) return;
    var existing = tbody.querySelectorAll("tr[data-attach-id]");
    existing.forEach(function (r) { r.remove(); });
    if (!items || !items.length) {
      if (emptyRow) emptyRow.style.display = "";
      return;
    }
    if (emptyRow) emptyRow.style.display = "none";
    items.forEach(function (item) {
      var tr = document.createElement("tr");
      tr.setAttribute("data-attach-id", item.id);
      var labelCell = document.createElement("td");
      labelCell.textContent = item.label || "-";
      var nameCell = document.createElement("td");
      nameCell.textContent = item.original_name || item.originalName || "-";
      var sizeCell = document.createElement("td");
      sizeCell.textContent = formatBytes(item.file_size || item.fileSize);
      var dateCell = document.createElement("td");
      dateCell.textContent = formatDate(item.created_at || item.createdAt);
      var actCell = document.createElement("td");
      var dlLink = document.createElement("a");
      dlLink.href = baseUrl + "/" + item.id + "/download";
      dlLink.className = "btn btn-outline-secondary btn-sm me-1";
      dlLink.textContent = "Baixar";
      dlLink.setAttribute("download", "");
      var delBtn = document.createElement("button");
      delBtn.type = "button";
      delBtn.className = "btn btn-outline-danger btn-sm";
      delBtn.textContent = "Excluir";
      delBtn.onclick = function () { attachDelete(item.id); };
      actCell.appendChild(dlLink);
      actCell.appendChild(delBtn);
      tr.appendChild(labelCell);
      tr.appendChild(nameCell);
      tr.appendChild(sizeCell);
      tr.appendChild(dateCell);
      tr.appendChild(actCell);
      tbody.appendChild(tr);
    });
  }

  function loadAttachments() {
    fetch(baseUrl, { credentials: "same-origin" })
      .then(function (r) { return r.json(); })
      .then(function (payload) {
        if (payload && payload.ok) renderRows(payload.data || []);
      })
      .catch(function () { /* silencioso */ });
  }

  window.attachUpload = function (e) {
    e.preventDefault();
    var fileInput = document.getElementById("attach-file-input");
    var labelInput = document.getElementById("attach-label-input");
    var submitBtn = document.getElementById("attach-submit-btn");
    if (!fileInput || !fileInput.files || !fileInput.files[0]) return;
    var file = fileInput.files[0];
    if (file.size > 50 * 1024 * 1024) {
      showFeedback("Arquivo muito grande. Limite: 50 MB.", "danger");
      return;
    }
    submitBtn.disabled = true;
    submitBtn.textContent = "Enviando...";
    fetch(baseUrl, {
      method: "POST",
      credentials: "same-origin",
      headers: {
        "Content-Type": file.type || "application/octet-stream",
        "X-CSRF-Token": csrfToken,
        "X-File-Name": encodeURIComponent(file.name),
        "X-Label": encodeURIComponent((labelInput && labelInput.value) ? labelInput.value.trim() : "")
      },
      body: file
    })
      .then(function (r) { return r.json(); })
      .then(function (payload) {
        if (payload && payload.ok) {
          showFeedback("Arquivo enviado com sucesso.", "success");
          fileInput.value = "";
          if (labelInput) labelInput.value = "";
          loadAttachments();
        } else {
          showFeedback((payload && payload.error) ? payload.error : "Falha ao enviar arquivo.", "danger");
        }
      })
      .catch(function () { showFeedback("Erro ao enviar arquivo.", "danger"); })
      .finally(function () { submitBtn.disabled = false; submitBtn.textContent = "Enviar"; });
  };

  window.attachDelete = function (attachId) {
    if (!confirm("Excluir este arquivo? Acao irreversivel.")) return;
    fetch(baseUrl + "/" + attachId + "/delete", {
      method: "POST",
      credentials: "same-origin",
      headers: {
        "Content-Type": "application/json",
        "X-CSRF-Token": csrfToken
      }
    })
      .then(function (r) { return r.json(); })
      .then(function (payload) {
        if (payload && payload.ok) {
          showFeedback("Arquivo excluido.", "success");
          loadAttachments();
        } else {
          showFeedback((payload && payload.error) ? payload.error : "Falha ao excluir.", "danger");
        }
      })
      .catch(function () { showFeedback("Erro ao excluir arquivo.", "danger"); });
  };

  loadAttachments();
})();
</script>
