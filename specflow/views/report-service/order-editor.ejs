<script>
  (function () {
    var modal = document.getElementById("cmpStyleModal");
    if (!modal) return;
    var bsModal = null;
    function getModal() { if (!bsModal) bsModal = new bootstrap.Modal(modal); return bsModal; }

    var previewContent = document.getElementById("csmPreviewContent");
    var chatArea      = document.getElementById("csmChatArea");
    var overlay       = document.getElementById("csmOverlay");
    var inputEl       = document.getElementById("csmInput");
    var sendBtn       = document.getElementById("csmSendBtn");
    var saveBtn       = document.getElementById("csmSaveBtn");
    var defaultBtn    = document.getElementById("csmDefaultBtn");
    var resetBtn      = document.getElementById("csmResetBtn");
    var unsavedBadge  = document.getElementById("csmUnsavedBadge");
    var previewHint   = document.getElementById("csmPreviewHint");

    var activeOrderId = null, pendingStyle = null;
    var csrfToken = (document.querySelector('[name="_csrf"]') || {}).value || "";
    var typingEl = null;

    function setUnsaved(on) {
      unsavedBadge.classList.toggle("d-none", !on);
      saveBtn.disabled = !on && !pendingStyle;
    }

    function showOverlay(on) {
      overlay.style.display = on ? "flex" : "none";
    }

    function setInputBusy(on) {
      sendBtn.disabled = on;
      inputEl.disabled = on;
      resetBtn.disabled = on;
      if (defaultBtn) defaultBtn.disabled = on;
    }

    function addBubble(type, text) {
      removeTyping();
      var div = document.createElement("div");
      div.className = "msm-bubble " + type;
      div.textContent = text;
      chatArea.appendChild(div);
      chatArea.scrollTop = chatArea.scrollHeight;
      return div;
    }

    function showTyping() {
      removeTyping();
      typingEl = document.createElement("div");
      typingEl.className = "msm-bubble ai msm-typing";
      typingEl.innerHTML = "<span></span><span></span><span></span>";
      chatArea.appendChild(typingEl);
      chatArea.scrollTop = chatArea.scrollHeight;
    }

    function removeTyping() {
      if (typingEl && typingEl.parentNode) typingEl.parentNode.removeChild(typingEl);
      typingEl = null;
    }

    function updatePreview(html) {
      previewContent.innerHTML = html || "";
    }

    async function callAi(instruction, apply) {
      var body = new URLSearchParams();
      body.set("_csrf", csrfToken);
      if (instruction) body.set("instruction", instruction);
      if (pendingStyle) body.set("current_style", JSON.stringify(pendingStyle));
      if (apply) body.set("apply", "true");
      var resp = await fetch(
        "/admin/report-service/orders/" + activeOrderId + "/components/style-ai",
        { method: "POST", headers: { "Content-Type": "application/x-www-form-urlencoded" }, body: body.toString() }
      );
      if (!resp.ok) {
        var data = await resp.json().catch(function () { return {}; });
        throw new Error(data.error || "Erro na requisição.");
      }
      return resp.json();
    }

    async function callReset() {
      var body = new URLSearchParams();
      body.set("_csrf", csrfToken);
      var resp = await fetch(
        "/admin/report-service/orders/" + activeOrderId + "/components/style-reset",
        { method: "POST", headers: { "Content-Type": "application/x-www-form-urlencoded" }, body: body.toString() }
      );
      if (!resp.ok) throw new Error("Erro ao resetar.");
      return resp.json();
    }

    async function callDefault() {
      var body = new URLSearchParams();
      body.set("_csrf", csrfToken);
      if (pendingStyle) body.set("current_style", JSON.stringify(pendingStyle));
      var resp = await fetch(
        "/admin/report-service/orders/" + activeOrderId + "/components/style-default",
        { method: "POST", headers: { "Content-Type": "application/x-www-form-urlencoded" }, body: body.toString() }
      );
      if (!resp.ok) {
        var data = await resp.json().catch(function () { return {}; });
        throw new Error(data.error || "Erro ao salvar padrão.");
      }
      return resp.json();
    }

    var triggerBtn = document.getElementById("componentsStyleBtn");
    if (triggerBtn) {
      triggerBtn.addEventListener("click", function () {
        activeOrderId = triggerBtn.getAttribute("data-order-id") || "";
        pendingStyle = null;
        chatArea.innerHTML = "";
        inputEl.value = "";
        previewHint.textContent = "";
        setUnsaved(false);
        saveBtn.disabled = true;
        if (defaultBtn) defaultBtn.disabled = true;

        showOverlay(true);
        getModal().show();

        callAi(null, false).then(function (r) {
          showOverlay(false);
          updatePreview(r.previewHtml);
          pendingStyle = r.styleConfig || null;
          if (defaultBtn) defaultBtn.disabled = !pendingStyle;
          previewHint.textContent = "Envie uma instrução para personalizar";
          addBubble("ai", "Olá! Descreva o que deseja alterar nas tabelas de componentes: cores, fontes, bordas, tamanhos ou alinhamento. Use os atalhos abaixo ou escreva livremente.");
        }).catch(function (err) {
          showOverlay(false);
          previewContent.innerHTML = "<p style='color:#dc2626;font-size:12px;'>Erro ao carregar preview: " + (err.message || "") + "</p>";
        });
      });
    }

    function sendInstruction() {
      var instruction = (inputEl.value || "").trim();
      if (!instruction || sendBtn.disabled) return;
      setInputBusy(true);
      addBubble("user", instruction);
      inputEl.value = "";
      showTyping();
      previewHint.textContent = "Aplicando alterações...";
      callAi(instruction, false).then(function (r) {
        removeTyping();
        updatePreview(r.previewHtml);
        pendingStyle = r.styleConfig || null;
        setUnsaved(true);
        saveBtn.disabled = false;
        if (defaultBtn) defaultBtn.disabled = false;
        previewHint.textContent = "Preview atualizado — salve quando estiver satisfeito";
        addBubble("ai", "Feito! Verifique o preview ao lado. Você pode continuar ajustando ou salvar.");
      }).catch(function (err) {
        removeTyping();
        addBubble("err", "Erro: " + (err.message || "Falha na IA."));
        previewHint.textContent = "";
      }).finally(function () {
        setInputBusy(false);
        inputEl.focus();
      });
    }

    sendBtn.addEventListener("click", sendInstruction);
    inputEl.addEventListener("keydown", function (e) {
      if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); sendInstruction(); }
    });

    modal.querySelectorAll(".msm-chip").forEach(function (chip) {
      chip.addEventListener("click", function () {
        inputEl.value = chip.getAttribute("data-s") || "";
        inputEl.focus();
      });
    });

    saveBtn.addEventListener("click", function () {
      if (!pendingStyle) return;
      setInputBusy(true);
      saveBtn.disabled = true;
      callAi(null, true).then(function () {
        var styleBtn = document.getElementById("componentsStyleBtn");
        if (styleBtn) {
          styleBtn.setAttribute("data-has-style", "1");
          var badge = styleBtn.querySelector(".badge");
          if (badge) badge.remove();
          styleBtn.insertAdjacentHTML("beforeend", ' <span class="badge text-bg-success" style="font-size:9px;">custom</span>');
        }
        setUnsaved(false);
        getModal().hide();
      }).catch(function (err) {
        addBubble("err", "Erro ao salvar: " + (err.message || "Tente novamente."));
        saveBtn.disabled = false;
      }).finally(function () {
        setInputBusy(false);
      });
    });

    if (defaultBtn) {
      defaultBtn.addEventListener("click", function () {
        if (!pendingStyle) return;
        setInputBusy(true);
        defaultBtn.disabled = true;
        callDefault().then(function (r) {
          updatePreview(r.previewHtml);
          pendingStyle = r.styleConfig || pendingStyle;
          setUnsaved(false);
          addBubble("ai", "Estilo salvo como padrão e aplicado a esta OS.");
        }).catch(function (err) {
          addBubble("err", "Erro: " + (err.message || "Tente novamente."));
        }).finally(function () {
          setInputBusy(false);
          defaultBtn.disabled = false;
        });
      });
    }

    resetBtn.addEventListener("click", function () {
      setInputBusy(true);
      callReset().then(function (r) {
        updatePreview(r.previewHtml);
        pendingStyle = r.styleConfig || null;
        setUnsaved(false);
        var styleBtn = document.getElementById("componentsStyleBtn");
        if (styleBtn) {
          styleBtn.setAttribute("data-has-style", "0");
          var badge = styleBtn.querySelector(".badge");
          if (badge) badge.remove();
        }
        addBubble("ai", "Estilo restaurado ao padrão.");
      }).catch(function (err) {
        addBubble("err", "Erro ao restaurar: " + (err.message || "Tente novamente."));
      }).finally(function () {
        setInputBusy(false);
      });
    });

    modal.addEventListener("hidden.bs.modal", function () {
      chatArea.innerHTML = "";
      inputEl.value = "";
      pendingStyle = null;
      setUnsaved(false);
      saveBtn.disabled = true;
      if (defaultBtn) defaultBtn.disabled = true;
    });
  })();
</script>
<script src="https://cdn.jsdelivr.net/npm/gridjs/dist/gridjs.umd.js"></script>
<script>
  (function () {
    // Components per equipment: Grid.js with pagination (max 20 per page).
    var gridTarget = document.getElementById("componentsGrid");
    if (!gridTarget) return;

    var componentsData = <%- JSON.stringify(components || []).replace(/</g, "\\u003c") %>;
    var orderId = <%- JSON.stringify(String(order.id)) %>;
    var deleteForm = document.getElementById("deleteComponentForm");

    function esc(v) {
      return String(v == null ? "" : v)
        .replace(/&/g, "&amp;").replace(/</g, "&lt;")
        .replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#39;");
    }

    if (!componentsData.length) {
      gridTarget.innerHTML = "<div class=\"text-center text-muted py-3\">Sem componentes.</div>";
      return;
    }
    if (!window.gridjs || !window.gridjs.Grid) return;

    function componentActions(item) {
      var attrs = ""
        + " data-id=\"" + esc(item.id) + "\""
        + " data-category=\"" + esc(item.category || "") + "\""
        + " data-equipment_id=\"" + esc(item.equipment_id == null ? "" : item.equipment_id) + "\""
        + " data-quantity=\"" + Number(item.quantity || 1) + "\""
        + " data-description=\"" + esc(item.description || "") + "\""
        + " data-part_number=\"" + esc(item.part_number || "") + "\""
        + " data-notes=\"" + esc(item.notes || "") + "\"";
      return "<div class=\"d-flex gap-1 justify-content-center\">"
        + "<button type=\"button\" class=\"btn btn-outline-primary btn-sm\" data-edit-component=\"" + esc(item.id) + "\"" + attrs + ">Editar</button>"
        + "<button type=\"button\" class=\"btn btn-outline-danger btn-sm\" data-delete-component=\"" + esc(item.id) + "\">Excluir</button>"
        + "</div>";
    }

    var data = componentsData.map(function (item) {
      return {
        category: esc(item.category || "-"),
        tag: esc(item.equipment_tag || "-"),
        description: esc(item.description || "-"),
        partNumber: esc(item.part_number || "-"),
        quantity: Number(item.quantity || 0),
        actions: componentActions(item)
      };
    });

    new window.gridjs.Grid({
      columns: [
        { id: "category", name: "Categoria", formatter: function (c) { return window.gridjs.html(c); } },
        { id: "tag", name: "TAG", formatter: function (c) { return window.gridjs.html(c); } },
        { id: "description", name: "Descricao", formatter: function (c) { return window.gridjs.html(c); } },
        { id: "partNumber", name: "P/N", formatter: function (c) { return window.gridjs.html(c); } },
        { id: "quantity", name: "Qtd", width: "70px" },
        { id: "actions", name: "Acoes", sort: false, width: "150px", formatter: function (c) { return window.gridjs.html(c); } }
      ],
      data: data,
      search: true,
      sort: true,
      pagination: { limit: 20, summary: false },
      language: {
        search: { placeholder: "Buscar..." },
        loading: "Carregando...",
        noRecordsFound: "Nenhum registro encontrado",
        error: "Erro ao carregar"
      }
    }).render(gridTarget);

    var editModalEl = document.getElementById("editComponentModal");
    var editForm = document.getElementById("editComponentForm");

    function openComponentEdit(btn) {
      if (!editForm) return;
      var id = btn.getAttribute("data-id");
      editForm.action = "/admin/report-service/orders/" + encodeURIComponent(orderId) + "/components/" + encodeURIComponent(String(id)) + "/update";
      var cat = document.getElementById("editCmpCategory");
      var eqp = document.getElementById("editCmpEquipment");
      // Match category case-insensitively: stored value is lowercased, but the
      // option values keep their original casing (e.g. "Para_troca").
      if (cat) {
        var wanted = (btn.getAttribute("data-category") || "").toLowerCase();
        cat.selectedIndex = 0;
        for (var i = 0; i < cat.options.length; i += 1) {
          if (cat.options[i].value.toLowerCase() === wanted) { cat.selectedIndex = i; break; }
        }
      }
      if (eqp) eqp.value = btn.getAttribute("data-equipment_id") || "";
      document.getElementById("editCmpQuantity").value = btn.getAttribute("data-quantity") || "1";
      document.getElementById("editCmpDescription").value = btn.getAttribute("data-description") || "";
      document.getElementById("editCmpPartNumber").value = btn.getAttribute("data-part_number") || "";
      document.getElementById("editCmpNotes").value = btn.getAttribute("data-notes") || "";
      if (window.bootstrap && editModalEl) {
        window.bootstrap.Modal.getOrCreateInstance(editModalEl).show();
      }
    }

    gridTarget.addEventListener("click", function (ev) {
      var editBtn = ev.target.closest("[data-edit-component]");
      if (editBtn) {
        openComponentEdit(editBtn);
        return;
      }
      var delBtn = ev.target.closest("[data-delete-component]");
      if (!delBtn) return;
      if (!window.confirm("Excluir este spare/componente da OS?")) return;
      var id = delBtn.getAttribute("data-delete-component");
      deleteForm.action = "/admin/report-service/orders/" + encodeURIComponent(orderId) + "/components/" + encodeURIComponent(String(id)) + "/delete";
      deleteForm.submit();
    });
  })();
</script>
