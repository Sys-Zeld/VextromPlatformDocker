<script>
  window.orderSparePartsByEquipment = <%- JSON.stringify(orderSparePartsByEquipment || {}).replace(/</g, "\\u003c") %>;
  window.sparePartsCatalog = <%- JSON.stringify(sparePartsCatalog || []).replace(/</g, "\\u003c") %>;
</script>
<script>
  (function () {
    var equipmentSelect = document.getElementById("componentEquipmentSelect");
    var descriptionSelect = document.getElementById("componentDescriptionSelect");
    var partNumberInput = document.getElementById("componentPartNumberInput");
    var quantityInput = document.getElementById("componentQuantityInput");
    var pnListEl = document.getElementById("componentPartNumberList");
    var source = window.orderSparePartsByEquipment || {};
    var catalog = Array.isArray(window.sparePartsCatalog) ? window.sparePartsCatalog : [];
    if (!equipmentSelect || !descriptionSelect || !partNumberInput) return;

    function esc(value) {
      return String(value || "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");
    }

    function normPn(value) {
      return String(value || "").trim().toLowerCase();
    }

    // Quantidade do cadastro (vinculo equipamento <-> spare-part), indexada por P/N.
    var qtyByPn = {};
    Object.keys(source).forEach(function (key) {
      var list = Array.isArray(source[key]) ? source[key] : [];
      list.forEach(function (item) {
        var pn = normPn(item.part_number);
        if (pn && qtyByPn[pn] == null && item.quantity != null) {
          qtyByPn[pn] = item.quantity;
        }
      });
    });

    // Catalogo completo indexado por P/N, para a busca manual.
    var catalogByPn = {};
    catalog.forEach(function (sp) {
      var pn = normPn(sp.part_number);
      if (pn && !catalogByPn[pn]) catalogByPn[pn] = sp;
    });

    function setQuantityFromPn(pn) {
      var qty = qtyByPn[normPn(pn)];
      if (qty != null && quantityInput) {
        quantityInput.value = qty;
      }
    }

    function fillDescriptions(equipmentId) {
      var key = String(equipmentId || "");
      var list = Array.isArray(source[key]) ? source[key] : [];
      descriptionSelect.innerHTML = "";

      var defaultOpt = document.createElement("option");
      defaultOpt.value = "";
      defaultOpt.textContent = list.length
        ? "Selecione a descricao (spare-part)"
        : "Sem spare-parts associados ao equipamento";
      descriptionSelect.appendChild(defaultOpt);

      list.forEach(function (item) {
        var opt = document.createElement("option");
        opt.value = String(item.description || "");
        opt.setAttribute("data-part-number", String(item.part_number || ""));
        if (item.quantity != null) opt.setAttribute("data-quantity", String(item.quantity));
        var pn = item.part_number ? esc(item.part_number) + " - " : "";
        opt.innerHTML = pn + esc(item.description || "-");
        descriptionSelect.appendChild(opt);
      });

      descriptionSelect.value = "";
      partNumberInput.value = "";
    }

    // Garante que a descricao selecionada exista no select (usada pela busca manual de P/N).
    function ensureDescriptionOption(description, pn) {
      var desc = String(description || "");
      for (var i = 0; i < descriptionSelect.options.length; i += 1) {
        if (descriptionSelect.options[i].value === desc) {
          descriptionSelect.selectedIndex = i;
          return;
        }
      }
      var opt = document.createElement("option");
      opt.value = desc;
      opt.setAttribute("data-part-number", String(pn || ""));
      var prefix = pn ? esc(pn) + " - " : "";
      opt.innerHTML = prefix + esc(desc || "-");
      descriptionSelect.appendChild(opt);
      descriptionSelect.value = desc;
    }

    equipmentSelect.addEventListener("change", function () {
      fillDescriptions(equipmentSelect.value);
    });

    descriptionSelect.addEventListener("change", function () {
      var selected = descriptionSelect.options[descriptionSelect.selectedIndex];
      var pn = selected ? String(selected.getAttribute("data-part-number") || "") : "";
      partNumberInput.value = pn;
      // Quantidade do cadastro, mas o usuario pode alterar livremente.
      var dataQty = selected ? selected.getAttribute("data-quantity") : null;
      if (dataQty != null && quantityInput) {
        quantityInput.value = dataQty;
      } else {
        setQuantityFromPn(pn);
      }
    });

    // ---- Autocomplete customizado do Part Number (lista pesquisavel na base) ----
    var activeIndex = -1;
    var currentMatches = [];

    function applySpare(match) {
      partNumberInput.value = match.part_number || partNumberInput.value;
      ensureDescriptionOption(match.description, match.part_number);
      setQuantityFromPn(match.part_number);
    }

    function closeList() {
      if (!pnListEl) return;
      pnListEl.classList.add("d-none");
      pnListEl.innerHTML = "";
      partNumberInput.setAttribute("aria-expanded", "false");
      activeIndex = -1;
      currentMatches = [];
    }

    function filterCatalog(term) {
      var q = normPn(term);
      if (!q) return catalog.slice(0, 50);
      return catalog.filter(function (sp) {
        return normPn(sp.part_number).indexOf(q) !== -1 ||
          String(sp.description || "").toLowerCase().indexOf(q) !== -1;
      }).slice(0, 50);
    }

    function highlight(idx) {
      if (!pnListEl) return;
      var items = pnListEl.querySelectorAll(".pn-autocomplete-item");
      items.forEach(function (el, i) {
        if (i === idx) {
          el.classList.add("is-active");
          el.scrollIntoView({ block: "nearest" });
        } else {
          el.classList.remove("is-active");
        }
      });
    }

    function renderList(term) {
      if (!pnListEl) return;
      currentMatches = filterCatalog(term);
      activeIndex = -1;
      pnListEl.innerHTML = "";

      if (!currentMatches.length) {
        var empty = document.createElement("li");
        empty.className = "pn-autocomplete-empty";
        empty.textContent = "Nenhum spare-part encontrado. P/N sera adicionado como digitado.";
        pnListEl.appendChild(empty);
      } else {
        currentMatches.forEach(function (sp, i) {
          var li = document.createElement("li");
          li.className = "pn-autocomplete-item";
          li.setAttribute("role", "option");
          li.setAttribute("data-index", String(i));
          li.innerHTML =
            '<span class="pn-code">' + esc(sp.part_number || "-") + '</span>' +
            '<span class="pn-desc">' + esc(sp.description || "") + '</span>';
          li.addEventListener("mousedown", function (ev) {
            ev.preventDefault(); // evita blur antes do clique
            applySpare(sp);
            closeList();
          });
          pnListEl.appendChild(li);
        });
      }

      pnListEl.classList.remove("d-none");
      partNumberInput.setAttribute("aria-expanded", "true");
    }

    partNumberInput.addEventListener("input", function () {
      renderList(partNumberInput.value);
    });

    partNumberInput.addEventListener("focus", function () {
      renderList(partNumberInput.value);
    });

    partNumberInput.addEventListener("keydown", function (ev) {
      if (pnListEl.classList.contains("d-none")) return;
      if (ev.key === "ArrowDown") {
        ev.preventDefault();
        if (currentMatches.length) {
          activeIndex = (activeIndex + 1) % currentMatches.length;
          highlight(activeIndex);
        }
      } else if (ev.key === "ArrowUp") {
        ev.preventDefault();
        if (currentMatches.length) {
          activeIndex = (activeIndex - 1 + currentMatches.length) % currentMatches.length;
          highlight(activeIndex);
        }
      } else if (ev.key === "Enter") {
        if (activeIndex >= 0 && currentMatches[activeIndex]) {
          ev.preventDefault();
          applySpare(currentMatches[activeIndex]);
          closeList();
        }
      } else if (ev.key === "Escape") {
        closeList();
      }
    });

    // Fecha ao clicar fora; aplica match exato se o usuario apenas digitou e saiu.
    partNumberInput.addEventListener("blur", function () {
      var match = catalogByPn[normPn(partNumberInput.value)];
      if (match) applySpare(match); // P/N manual sem match: mantem o digitado.
      window.setTimeout(closeList, 120);
    });

    fillDescriptions(equipmentSelect.value);
  })();
</script>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    var btn = document.getElementById("generateConclusionBtn");
    var confirmBtn = document.getElementById("generateConclusionConfirmBtn");
    var promptTextarea = document.getElementById("conclusionPromptTextarea");
    var modalErrorEl = document.getElementById("generateConclusionModalError");
    var successEl = document.getElementById("generateConclusionSuccess");
    var errorEl = document.getElementById("generateConclusionError");
    if (!btn || !confirmBtn) return;

    var DEFAULT_PROMPT = "Crie um resumo de todas as atividades para servir como uma conclusao tecnica. Escreva em paragrafos claros, objetivos e resumidos, em portugues. Nao repita datas, sintetize o que foi feito. Separe cada paragrafo com uma linha em branco.";
    var csrfInput = document.querySelector('input[name="_csrf"]');
    var csrfToken = csrfInput ? csrfInput.value : "";
    var endpoint = "/admin/report-service/orders/<%= order.id %>/daily-logs/generate-conclusion";
    var bsModal = null;

    function getModal() {
      if (!bsModal) {
        var el = document.getElementById("generateConclusionModal");
        if (el && window.bootstrap) bsModal = new window.bootstrap.Modal(el);
      }
      return bsModal;
    }

    function setLoading(loading) {
      var labelDefault = confirmBtn.querySelector(".gcm-label-default");
      var labelLoading = confirmBtn.querySelector(".gcm-label-loading");
      var cancelBtn = document.getElementById("generateConclusionCancelBtn");
      confirmBtn.disabled = loading;
      if (cancelBtn) cancelBtn.disabled = loading;
      if (labelDefault) labelDefault.classList.toggle("d-none", loading);
      if (labelLoading) labelLoading.classList.toggle("d-none", !loading);
    }

    btn.addEventListener("click", function () {
      if (promptTextarea) promptTextarea.value = DEFAULT_PROMPT;
      if (modalErrorEl) modalErrorEl.classList.add("d-none");
      var modal = getModal();
      if (modal) modal.show();
    });

    confirmBtn.addEventListener("click", async function () {
      var prompt = promptTextarea ? promptTextarea.value.trim() : DEFAULT_PROMPT;
      if (!prompt) {
        if (modalErrorEl) {
          modalErrorEl.textContent = "Informe a instrucao para a IA.";
          modalErrorEl.classList.remove("d-none");
        }
        return;
      }
      setLoading(true);
      if (modalErrorEl) modalErrorEl.classList.add("d-none");
      try {
        var response = await fetch(endpoint, {
          method: "POST",
          headers: { "Content-Type": "application/json", "X-CSRF-Token": csrfToken },
          credentials: "same-origin",
          body: JSON.stringify({ prompt: prompt })
        });
        var payload = await response.json().catch(function () { return {}; });
        if (!response.ok || !payload.ok) {
          throw new Error(payload.message || "Falha ao gerar conclusao.");
        }
        var modal = getModal();
        if (modal) modal.hide();
        if (successEl) successEl.classList.remove("d-none");
        if (errorEl) errorEl.classList.add("d-none");
        setTimeout(function () { window.location.reload(); }, 1500);
      } catch (err) {
        setLoading(false);
        if (modalErrorEl) {
          modalErrorEl.textContent = err.message || "Falha ao gerar conclusao com IA.";
          modalErrorEl.classList.remove("d-none");
        }
      }
    });

    var modalEl = document.getElementById("generateConclusionModal");
    if (modalEl) {
      modalEl.addEventListener("hidden.bs.modal", function () {
        setLoading(false);
        if (modalErrorEl) modalErrorEl.classList.add("d-none");
      });
    }

    // ── Modal: Revisar com IA — Log Diário ───────────────────────────────────
    (function () {
      var dlConfirmBtn = document.getElementById("aiReviseConfirmBtn");
      var dlPromptTextarea = document.getElementById("aiRevisePromptTextarea");
      var dlModalError = document.getElementById("aiReviseModalError");
      var dlModalEl = document.getElementById("aiReviseModal");
      if (!dlConfirmBtn) return;

      function setDlLoading(loading) {
        var labelDefault = dlConfirmBtn.querySelector(".dlrm-label-default");
        var labelLoading = dlConfirmBtn.querySelector(".dlrm-label-loading");
        var cancelBtn = document.getElementById("aiReviseModalCancelBtn");
        dlConfirmBtn.disabled = loading;
        if (cancelBtn) cancelBtn.disabled = loading;
        if (labelDefault) labelDefault.classList.toggle("d-none", loading);
        if (labelLoading) labelLoading.classList.toggle("d-none", !loading);
      }

      dlConfirmBtn.addEventListener("click", async function () {
        var prompt = dlPromptTextarea ? dlPromptTextarea.value.trim() : "";
        if (!prompt) {
          if (dlModalError) { dlModalError.textContent = "Informe a instrucao para a IA."; dlModalError.classList.remove("d-none"); }
          return;
        }
        var p = window._dlRevisePayload;
        if (!p) return;
        setDlLoading(true);
        if (dlModalError) dlModalError.classList.add("d-none");
        try {
          var response = await fetch("/admin/report-service/orders/<%= order.id %>/daily-logs/revise-text", {
            method: "POST",
            headers: { "Content-Type": "application/json", "X-CSRF-Token": p.csrfToken },
            credentials: "same-origin",
            body: JSON.stringify({ text: p.sourceText, html: p.sourceHtml, prompt: prompt, preserveFormatting: true })
          });
          var data = await response.json().catch(function () { return {}; });
          if (!response.ok || !data.ok) throw new Error(data && data.message ? data.message : "Falha ao revisar.");
          var revisedHtml = String(data.revisedHtml || "").trim();
          if (revisedHtml) {
            p.quill.setText("");
            p.quill.clipboard.dangerouslyPasteHTML(revisedHtml);
          } else {
            var revisedText = String(data.revisedText || "").trim();
            if (!revisedText) throw new Error("A IA nao retornou texto.");
            p.quill.setText(revisedText);
          }
          if (dlModalEl && window.bootstrap) window.bootstrap.Modal.getOrCreateInstance(dlModalEl).hide();
          if (p.aiStatus) p.aiStatus.textContent = "Texto revisado com IA.";
        } catch (err) {
          setDlLoading(false);
          if (dlModalError) { dlModalError.textContent = err.message || "Falha ao revisar."; dlModalError.classList.remove("d-none"); }
        }
      });

      if (dlModalEl) {
        dlModalEl.addEventListener("hidden.bs.modal", function () {
          setDlLoading(false);
          if (dlModalError) dlModalError.classList.add("d-none");
        });
      }
    })();
  });
</script>
<script>
  (function () {
    var form = document.getElementById("timesheet-form");
    var entryIdInput = document.getElementById("timesheetEntryId");
    var submitBtn = document.getElementById("timesheetSubmitBtn");
    var cancelBtn = document.getElementById("timesheetCancelEditBtn");
    var overlapError = document.getElementById("timesheetOverlapError");
    if (!form) return;

    var csrfInput = form.querySelector('input[name="_csrf"]');
    var csrfToken = csrfInput ? csrfInput.value : "";

    // ---- timesheet data index for client-side overlap check ----
    var tsIndex = <%- JSON.stringify(
      (timesheet || []).map(function(item) {
        return {
          id: Number(item.id),
          date: String(item.activity_date || "").slice(0, 10),
          inClient: item.check_in_client || item.check_in_base || "",
          outClient: item.check_out_client || item.check_out_base || ""
        };
      })
    ) %>;

    function parseTime(str) {
      if (!str) return null;
      var m = String(str).trim().match(/^(\d{1,2}):(\d{2})$/);
      if (!m) return null;
      return Number(m[1]) * 60 + Number(m[2]);
    }

    function checkOverlap(date, inTime, outTime, excludeId) {
      var newStart = parseTime(inTime);
      var newEnd = parseTime(outTime);
      if (newStart === null || newEnd === null || newEnd <= newStart) return null;
      for (var i = 0; i < tsIndex.length; i++) {
        var entry = tsIndex[i];
        if (excludeId !== null && entry.id === excludeId) continue;
        if (entry.date !== date) continue;
        var eStart = parseTime(entry.inClient);
        var eEnd = parseTime(entry.outClient);
        if (eStart === null || eEnd === null) continue;
        if (newStart < eEnd && newEnd > eStart) return entry;
      }
      return null;
    }

    function calcTimesheetHours() {
      var inVal = (document.getElementById("tsCheckInClient").value || "").trim();
      var outVal = (document.getElementById("tsCheckOutClient").value || "").trim();
      var display = document.getElementById("tsWorkedHoursDisplay");
      if (!display) return;
      var inMin = parseTime(inVal);
      var outMin = parseTime(outVal);
      if (inMin !== null && outMin !== null && outMin > inMin) {
        var diff = (outMin - inMin) / 60;
        display.value = diff.toFixed(2) + " h";
      } else {
        display.value = "";
      }
    }

    document.getElementById("tsCheckInClient").addEventListener("change", calcTimesheetHours);
    document.getElementById("tsCheckOutClient").addEventListener("change", calcTimesheetHours);
    document.getElementById("tsCheckInClient").addEventListener("input", calcTimesheetHours);
    document.getElementById("tsCheckOutClient").addEventListener("input", calcTimesheetHours);

    function resetForm() {
      entryIdInput.value = "";
      form.action = "/admin/report-service/orders/<%= order.id %>/timesheet";
      submitBtn.textContent = "Adicionar";
      cancelBtn.classList.add("d-none");
      form.reset();
      if (overlapError) overlapError.classList.add("d-none");
      document.getElementById("tsWorkedHoursDisplay").value = "";
    }

    if (cancelBtn) {
      cancelBtn.addEventListener("click", resetForm);
    }

    // Edit buttons
    var editBtns = document.querySelectorAll(".ts-edit-btn");
    editBtns.forEach(function (btn) {
      btn.addEventListener("click", function () {
        var row = btn.closest("tr");
        if (!row) return;
        var id = row.getAttribute("data-ts-id");
        document.getElementById("tsActivityDate").value = row.getAttribute("data-ts-date") || "";
        document.getElementById("tsTechnicianName").value = row.getAttribute("data-ts-technician") || "";
        document.getElementById("tsCheckInBase").value = row.getAttribute("data-ts-in-base") || "";
        document.getElementById("tsCheckInClient").value = row.getAttribute("data-ts-in-client") || "";
        document.getElementById("tsCheckOutClient").value = row.getAttribute("data-ts-out-client") || "";
        document.getElementById("tsCheckOutBase").value = row.getAttribute("data-ts-out-base") || "";
        document.getElementById("tsNotes").value = row.getAttribute("data-ts-notes") || "";
        calcTimesheetHours();
        entryIdInput.value = id;
        form.action = "/admin/report-service/orders/<%= order.id %>/timesheet/" + id + "/update";
        submitBtn.textContent = "Salvar edicao";
        cancelBtn.classList.remove("d-none");
        if (overlapError) overlapError.classList.add("d-none");
        document.getElementById("timesheet-card").scrollIntoView({ behavior: "smooth", block: "start" });
      });
    });

    // Client-side overlap validation on submit
    form.addEventListener("submit", function (e) {
      if (overlapError) overlapError.classList.add("d-none");
      var date = document.getElementById("tsActivityDate").value;
      var inClient = document.getElementById("tsCheckInClient").value.trim();
      var outClient = document.getElementById("tsCheckOutClient").value.trim();
      if (!inClient || !outClient) return; // server will handle empty
      var excludeId = entryIdInput.value ? Number(entryIdInput.value) : null;
      var conflict = checkOverlap(date, inClient, outClient, excludeId);
      if (conflict) {
        e.preventDefault();
        var msg = "Sobreposicao de horario: conflito com " + (conflict.inClient || "-") + " - " + (conflict.outClient || "-") + " no mesmo dia. Verifique o horario e tente novamente.";
        if (overlapError) {
          overlapError.textContent = msg;
          overlapError.classList.remove("d-none");
          overlapError.scrollIntoView({ behavior: "smooth", block: "nearest" });
        }
      }
    });
  })();
</script>
