<script>
  (function () {
    var aModal = document.getElementById("aStyleModal");
    if (!aModal) return;
    var bsAModal = null;
    function getAModal() { if (!bsAModal) bsAModal = new bootstrap.Modal(aModal); return bsAModal; }

    var previewContent = document.getElementById("asmPreviewContent");
    var chatArea      = document.getElementById("asmChatArea");
    var overlay       = document.getElementById("asmOverlay");
    var inputEl       = document.getElementById("asmInput");
    var sendBtn       = document.getElementById("asmSendBtn");
    var saveBtn       = document.getElementById("asmSaveBtn");
    var defaultBtn    = document.getElementById("asmDefaultBtn");
    var resetBtn      = document.getElementById("asmResetBtn");
    var unsavedBadge  = document.getElementById("asmUnsavedBadge");
    var leituraName   = document.getElementById("asmLeituraName");
    var previewHint   = document.getElementById("asmPreviewHint");

    var activeLeituraId = null, activeOrderId = null, pendingStyle = null;
    var csrfToken = (document.querySelector('[name="_csrf"]') || {}).value || "";
    var typingEl = null;

    function setUnsaved(on) { unsavedBadge.classList.toggle("d-none", !on); saveBtn.disabled = !on && !pendingStyle; }
    function showOverlay(on) { overlay.style.display = on ? "flex" : "none"; }
    function setInputBusy(on) {
      sendBtn.disabled = on;
      inputEl.disabled = on;
      resetBtn.disabled = on;
      if (defaultBtn) defaultBtn.disabled = on;
    }

    function addBubble(type, text) {
      removeTyping();
      var div = document.createElement("div");
      div.className = "msm-bubble " + type;
      div.textContent = text;
      chatArea.appendChild(div);
      chatArea.scrollTop = chatArea.scrollHeight;
      return div;
    }

    function showTyping() {
      removeTyping();
      typingEl = document.createElement("div");
      typingEl.className = "msm-bubble ai msm-typing";
      typingEl.innerHTML = "<span></span><span></span><span></span>";
      chatArea.appendChild(typingEl);
      chatArea.scrollTop = chatArea.scrollHeight;
    }

    function removeTyping() { if (typingEl && typingEl.parentNode) typingEl.parentNode.removeChild(typingEl); typingEl = null; }
    function updatePreview(html) { previewContent.innerHTML = html || ""; }

    async function callAi(instruction, apply) {
      var body = new URLSearchParams();
      body.set("_csrf", csrfToken);
      if (instruction) body.set("instruction", instruction);
      if (pendingStyle) body.set("current_style", JSON.stringify(pendingStyle));
      if (apply) body.set("apply", "true");
      var resp = await fetch(
        "/admin/report-service/orders/" + activeOrderId + "/alber/" + activeLeituraId + "/style-ai",
        { method: "POST", headers: { "Content-Type": "application/x-www-form-urlencoded" }, body: body.toString() }
      );
      if (!resp.ok) { var data = await resp.json().catch(function () { return {}; }); throw new Error(data.error || "Erro na requisição."); }
      return resp.json();
    }

    async function callReset() {
      var body = new URLSearchParams();
      body.set("_csrf", csrfToken);
      var resp = await fetch(
        "/admin/report-service/orders/" + activeOrderId + "/alber/" + activeLeituraId + "/style-reset",
        { method: "POST", headers: { "Content-Type": "application/x-www-form-urlencoded" }, body: body.toString() }
      );
      if (!resp.ok) throw new Error("Erro ao resetar.");
      return resp.json();
    }

    async function callDefault() {
      var body = new URLSearchParams();
      body.set("_csrf", csrfToken);
      if (pendingStyle) body.set("current_style", JSON.stringify(pendingStyle));
      var resp = await fetch(
        "/admin/report-service/orders/" + activeOrderId + "/alber/" + activeLeituraId + "/style-default",
        { method: "POST", headers: { "Content-Type": "application/x-www-form-urlencoded" }, body: body.toString() }
      );
      if (!resp.ok) { var data = await resp.json().catch(function () { return {}; }); throw new Error(data.error || "Erro ao salvar padrão."); }
      return resp.json();
    }

    document.querySelectorAll(".alber-style-btn").forEach(function (btn) {
      btn.addEventListener("click", function () {
        activeLeituraId = Number(btn.getAttribute("data-leitura-id") || 0);
        activeOrderId   = btn.getAttribute("data-order-id") || "";
        pendingStyle    = null;
        chatArea.innerHTML = "";
        inputEl.value = "";
        previewHint.textContent = "";
        setUnsaved(false);
        saveBtn.disabled = true;
        if (defaultBtn) defaultBtn.disabled = true;
        leituraName.textContent = btn.getAttribute("data-leitura-name") || ("Leitura #" + activeLeituraId);
        showOverlay(true);
        getAModal().show();
        callAi(null, false).then(function (r) {
          showOverlay(false);
          updatePreview(r.previewHtml);
          pendingStyle = r.styleConfig || null;
          if (defaultBtn) defaultBtn.disabled = !pendingStyle;
          previewHint.textContent = "Envie uma instrução para personalizar";
          addBubble("ai", "Olá! Descreva o que deseja alterar: cores do cabeçalho, fontes, bordas, fundo das células, estatísticas. Use os atalhos abaixo ou escreva livremente.");
        }).catch(function (err) {
          showOverlay(false);
          previewContent.innerHTML = "<p style='color:#dc2626;font-size:12px;'>Erro ao carregar preview: " + (err.message || "") + "</p>";
        });
      });
    });

    function sendInstruction() {
      var instruction = (inputEl.value || "").trim();
      if (!instruction || sendBtn.disabled) return;
      setInputBusy(true);
      addBubble("user", instruction);
      inputEl.value = "";
      showTyping();
      previewHint.textContent = "Aplicando alterações...";
      callAi(instruction, false).then(function (r) {
        removeTyping();
        updatePreview(r.previewHtml);
        pendingStyle = r.styleConfig || null;
        setUnsaved(true);
        saveBtn.disabled = false;
        if (defaultBtn) defaultBtn.disabled = false;
        previewHint.textContent = "Preview atualizado — salve quando estiver satisfeito";
        addBubble("ai", "Feito! Verifique o preview ao lado. Você pode continuar ajustando ou salvar.");
      }).catch(function (err) {
        removeTyping();
        addBubble("err", "Erro: " + (err.message || "Falha na IA."));
        previewHint.textContent = "";
      }).finally(function () {
        setInputBusy(false);
        inputEl.focus();
      });
    }

    sendBtn.addEventListener("click", sendInstruction);
    inputEl.addEventListener("keydown", function (e) { if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); sendInstruction(); } });

    aModal.querySelectorAll(".msm-chip").forEach(function (chip) {
      chip.addEventListener("click", function () { inputEl.value = chip.getAttribute("data-s") || ""; inputEl.focus(); });
    });

    saveBtn.addEventListener("click", function () {
      if (!pendingStyle) return;
      setInputBusy(true);
      saveBtn.disabled = true;
      callAi(null, true).then(function () {
        var styleBtn = document.querySelector('.alber-style-btn[data-leitura-id="' + activeLeituraId + '"]');
        if (styleBtn) {
          styleBtn.setAttribute("data-has-style", "1");
          var badge = styleBtn.querySelector(".badge");
          if (badge) badge.remove();
          styleBtn.insertAdjacentHTML("beforeend", ' <span class="badge text-bg-success" style="font-size:9px;">custom</span>');
        }
        setUnsaved(false);
        getAModal().hide();
      }).catch(function (err) {
        addBubble("err", "Erro ao salvar: " + (err.message || "Tente novamente."));
        saveBtn.disabled = false;
      }).finally(function () {
        setInputBusy(false);
      });
    });

    if (defaultBtn) {
      defaultBtn.addEventListener("click", function () {
        if (!pendingStyle) return;
        setInputBusy(true);
        defaultBtn.disabled = true;
        callDefault().then(function (r) {
          updatePreview(r.previewHtml);
          pendingStyle = r.styleConfig || pendingStyle;
          var styleBtn = document.querySelector('.alber-style-btn[data-leitura-id="' + activeLeituraId + '"]');
          if (styleBtn) {
            styleBtn.setAttribute("data-has-style", "1");
            var badge = styleBtn.querySelector(".badge");
            if (badge) badge.remove();
            styleBtn.insertAdjacentHTML("beforeend", ' <span class="badge text-bg-success" style="font-size:9px;">custom</span>');
          }
          setUnsaved(false);
          saveBtn.disabled = true;
          previewHint.textContent = "Estilo salvo como padrão para novas leituras";
          addBubble("ai", "Este visual foi salvo como padrão. Outras leituras Alber sem estilo próprio usarão este visual automaticamente.");
        }).catch(function (err) {
          addBubble("err", "Erro ao salvar padrão: " + (err.message || "Tente novamente."));
        }).finally(function () {
          setInputBusy(false);
          defaultBtn.disabled = !pendingStyle;
        });
      });
    }

    resetBtn.addEventListener("click", function () {
      if (!confirm("Restaurar o visual padrão desta leitura Alber?")) return;
      setInputBusy(true);
      callReset().then(function (r) {
        updatePreview(r.previewHtml);
        pendingStyle = r.styleConfig || null;
        chatArea.innerHTML = "";
        setUnsaved(false);
        saveBtn.disabled = true;
        if (defaultBtn) defaultBtn.disabled = !pendingStyle;
        previewHint.textContent = "Visual padrão restaurado";
        addBubble("ai", "Visual restaurado para o padrão. Envie novas instruções para personalizar novamente.");
        var styleBtn = document.querySelector('.alber-style-btn[data-leitura-id="' + activeLeituraId + '"]');
        if (styleBtn) {
          styleBtn.setAttribute("data-has-style", "0");
          var badge = styleBtn.querySelector(".badge");
          if (badge) badge.remove();
          if (pendingStyle) {
            styleBtn.insertAdjacentHTML("beforeend", ' <span class="badge text-bg-secondary" style="font-size:9px;">padrão</span>');
          }
        }
      }).catch(function (err) {
        addBubble("err", "Erro ao restaurar: " + (err.message || "Tente novamente."));
      }).finally(function () {
        setInputBusy(false);
      });
    });
  })();
</script>

<script>
(function () {
  // ---- Import via fetch ----
  var importBtn = document.getElementById("alberImportBtn");
  var fileInput = document.getElementById("alberFileInput");
  var fileNameLabel = document.getElementById("alberFileName");
  var spinner = document.getElementById("alberImportSpinner");
  var msgEl = document.getElementById("alberImportMsg");
  var csrfToken = "<%= csrfToken %>";
  var orderId = "<%= order.id %>";

  importBtn.addEventListener("click", function () {
    fileInput.value = "";
    fileInput.click();
  });

  fileInput.addEventListener("change", function () {
    var file = fileInput.files[0];
    if (!file) return;
    fileNameLabel.textContent = file.name;
    spinner.classList.remove("d-none");
    msgEl.textContent = "";
    importBtn.disabled = true;

    fetch("/admin/report-service/orders/" + orderId + "/alber/import", {
      method: "POST",
      headers: {
        "Content-Type": "application/octet-stream",
        "X-CSRF-Token": csrfToken,
        "X-File-Name": encodeURIComponent(file.name)
      },
      body: file
    }).then(function (resp) {
      return resp.json().then(function (data) {
        spinner.classList.add("d-none");
        importBtn.disabled = false;
        if (!resp.ok || !data.ok) {
          msgEl.textContent = (data && data.error) ? data.error : "Erro ao importar.";
          msgEl.style.color = "red";
        } else {
          window.location.reload();
        }
      });
    }).catch(function (err) {
      spinner.classList.add("d-none");
      importBtn.disabled = false;
      msgEl.textContent = "Erro de rede: " + err.message;
      msgEl.style.color = "red";
    });
  });

  // ---- Toggle dados (cards + tabela) ----
  window.toggleAlberData = function (leituraId) {
    var dataEl   = document.getElementById("alberData_"   + leituraId);
    var editorEl = document.getElementById("alberEditor_" + leituraId);
    var viewBtn  = document.getElementById("alberViewBtn_" + leituraId);
    if (!dataEl) return;
    var showing = !dataEl.classList.contains("d-none");
    if (!showing) {
      // Fechar editor se estiver aberto
      if (editorEl) {
        editorEl.classList.add("d-none");
        var ch = document.getElementById("alberEditorChevron_" + leituraId);
        if (ch) ch.textContent = "✏️ Editar";
      }
      dataEl.classList.remove("d-none");
      if (viewBtn) viewBtn.textContent = "Ocultar dados";
    } else {
      dataEl.classList.add("d-none");
      if (viewBtn) viewBtn.textContent = "Ver dados";
    }
  };

  // ---- Toggle editor ----
  window.toggleAlberEditor = function (leituraId) {
    var editorEl = document.getElementById("alberEditor_" + leituraId);
    var dataEl   = document.getElementById("alberData_"   + leituraId);
    var viewBtn  = document.getElementById("alberViewBtn_" + leituraId);
    var ch       = document.getElementById("alberEditorChevron_" + leituraId);
    if (!editorEl) return;
    var editorOpen = !editorEl.classList.contains("d-none");
    if (!editorOpen) {
      // Abrir editor: ocultar tabela de dados
      if (dataEl) {
        dataEl.classList.add("d-none");
        if (viewBtn) viewBtn.textContent = "Ver dados";
      }
      editorEl.classList.remove("d-none");
      if (ch) ch.textContent = "✖ Fechar editor";
    } else {
      editorEl.classList.add("d-none");
      if (ch) ch.textContent = "✏️ Editar";
    }
  };

  // ---- Cancelar editor: fecha editor e mostra dados ----
  window.cancelAlberEditor = function (leituraId) {
    var editorEl = document.getElementById("alberEditor_" + leituraId);
    var dataEl   = document.getElementById("alberData_"   + leituraId);
    var viewBtn  = document.getElementById("alberViewBtn_" + leituraId);
    var ch       = document.getElementById("alberEditorChevron_" + leituraId);
    if (editorEl) editorEl.classList.add("d-none");
    if (ch)       ch.textContent = "✏️ Editar";
    if (dataEl)   { dataEl.classList.remove("d-none"); }
    if (viewBtn)  { viewBtn.textContent = "Ocultar dados"; }
  };

  // ---- Auto-expand após salvar ----
  (function () {
    var params = new URLSearchParams(window.location.search);
    var savedLid = params.get("lid");
    if (params.get("saved") === "1" && savedLid) {
      var dataEl  = document.getElementById("alberData_"    + savedLid);
      var viewBtn = document.getElementById("alberViewBtn_" + savedLid);
      if (dataEl)  { dataEl.classList.remove("d-none"); }
      if (viewBtn) { viewBtn.textContent = "Ocultar dados"; }
      // Scroll suave até o card
      var card = dataEl && dataEl.closest(".border-bottom");
      if (card) { setTimeout(function () { card.scrollIntoView({ behavior: "smooth", block: "start" }); }, 100); }
    }
  })();

  // ---- Sync editor state to hidden JSON inputs before submit ----
  window.syncAlberEditor = function (leituraId) {
    var labels = {};
    document.querySelectorAll(".string-label-input[data-leitura-id='" + leituraId + "']").forEach(function (inp) {
      var sNum = inp.getAttribute("data-string-num");
      labels[sNum] = inp.value.trim() || ("Banco " + sNum);
    });
    var labelsInput = document.getElementById("stringLabelsJson_" + leituraId);
    if (labelsInput) labelsInput.value = JSON.stringify(labels);

    var hiddenColumns = [];
    document.querySelectorAll(".alber-col-toggle[data-leitura-id='" + leituraId + "']").forEach(function (chk) {
      if (!chk.checked) hiddenColumns.push(chk.getAttribute("data-col"));
    });
    var displayConfigInput = document.getElementById("displayConfigJson_" + leituraId);
    if (displayConfigInput) {
      var displayConfig = {};
      try { displayConfig = JSON.parse(displayConfigInput.value || "{}") || {}; } catch (_err) { displayConfig = {}; }
      if (hiddenColumns.length) displayConfig.hiddenColumns = hiddenColumns;
      else delete displayConfig.hiddenColumns;

      var ranges = {};
      document.querySelectorAll(".alber-range-input[data-leitura-id='" + leituraId + "']").forEach(function (inp) {
        var key = inp.getAttribute("data-range");
        var raw = String(inp.value || "").trim();
        if (!key || !raw) return;
        var num = Number(raw);
        if (Number.isFinite(num)) ranges[key] = num;
      });
      if (Object.keys(ranges).length) displayConfig.ranges = ranges;
      else delete displayConfig.ranges;

      displayConfigInput.value = JSON.stringify(displayConfig);
    }

    var celulas = [];
    document.querySelectorAll("tr[data-leitura-id='" + leituraId + "'][data-string-num]").forEach(function (row) {
      var sNum = Number(row.getAttribute("data-string-num"));
      var cNum = Number(row.getAttribute("data-celula-num"));
      var voltagemEl = row.querySelector(".cell-voltagem[data-leitura-id='" + leituraId + "']");
      var resistenciaEl = row.querySelector(".cell-resistencia[data-leitura-id='" + leituraId + "']");
      var ativaEl = row.querySelector(".cell-ativa[data-leitura-id='" + leituraId + "']");
      if (!voltagemEl || !resistenciaEl) return;
      celulas.push({
        stringNum: sNum,
        celulaNum: cNum,
        voltagem: parseFloat(voltagemEl.value) || 0,
        resistencia: parseInt(resistenciaEl.value, 10) || 0,
        ativa: ativaEl ? ativaEl.checked : true
      });
    });
    var celulasInput = document.getElementById("celulasJson_" + leituraId);
    if (celulasInput) celulasInput.value = JSON.stringify(celulas);
  };
})();
</script>
<%- include("../partials/footer") %>
