<%- include("../partials/head", { pageTitle }) %>
<link href="/public/css/report-editor.css?v=<%= appVersion %>" rel="stylesheet" />
<%
  function formatDateShort(value) {
    if (!value) return "-";
    const raw = String(value).trim();
    const iso = raw.match(/^(\d{4})-(\d{2})-(\d{2})/);
    if (iso) return `${iso[3]}/${iso[2]}/${iso[1]}`;
    const date = new Date(raw);
    if (Number.isNaN(date.getTime())) return "-";
    return `${String(date.getDate()).padStart(2,"0")}/${String(date.getMonth()+1).padStart(2,"0")}/${date.getFullYear()}`;
  }

  function formatDateTime(value) {
    if (!value) return "-";
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return "-";
    return `${String(date.getDate()).padStart(2,"0")}/${String(date.getMonth()+1).padStart(2,"0")}/${date.getFullYear()} ${String(date.getHours()).padStart(2,"0")}:${String(date.getMinutes()).padStart(2,"0")}`;
  }
%>

<style>
  .alber-info-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 6px 6px 0 0;
    border-bottom: none;
    padding: 10px 16px;
    align-items: center;
    font-size: 13px;
  }
  .alber-info-pair {
    display: flex;
    align-items: center;
    gap: 6px;
    padding-right: 20px;
  }
  .alber-info-pair + .alber-info-pair {
    border-left: 1px solid #e2e8f0;
    padding-left: 20px;
  }
  .alber-info-label { color: #64748b; font-size: 12px; }
  .alber-info-value { font-weight: 600; color: #1e293b; }

  .alber-stats-row {
    display: flex;
    gap: 12px;
    padding: 12px 16px;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-bottom: none;
    flex-wrap: wrap;
  }
  .alber-stat-card {
    flex: 1;
    min-width: 120px;
    max-width: 200px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 10px 14px;
  }
  .alber-stat-label { font-size: 11px; color: #64748b; margin-bottom: 2px; }
  .alber-stat-value { font-size: 20px; font-weight: 700; color: #1e293b; letter-spacing: -0.02em; }
  .alber-stat-unit { font-size: 13px; font-weight: 400; color: #64748b; margin-left: 2px; }

  .alber-table-wrap {
    border: 1px solid #e2e8f0;
    border-radius: 0 0 6px 6px;
    overflow: hidden;
  }
  .alber-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }
  .alber-table thead th {
    background: #5d8f3d;
    color: #fff;
    padding: 8px 12px;
    text-align: left;
    font-size: 12px;
    font-weight: 600;
    border: 1px solid #87b86a;
    letter-spacing: 0.03em;
  }
  .alber-table thead th.alber-th-title {
    font-size: 13px;
    padding: 7px 12px;
    letter-spacing: 0.01em;
  }
  .alber-table tbody td {
    padding: 6px 12px;
    border: 1px solid #87b86a;
    color: #1e293b;
    vertical-align: middle;
  }
  .alber-table tbody tr:nth-child(even) td { background: #f0f5e8; }
  .alber-table tbody tr.alber-stats-tr td {
    background: #d4e6c3;
    font-weight: 600;
    font-size: 11px;
  }
</style>

<section class="token-console">
  <div class="card app-card token-hero-card">
    <div class="card-body token-hero-body">
      <div class="token-hero-copy">
        <span class="token-hero-eyebrow">LEITURAS ALBER (BCT)</span>
        <h1 class="h4 app-card-title mb-1"><%= order.service_order_display || "-" %></h1>
        <p class="text-muted mb-0"><%= order.title %> - <%= order.customer_name %></p>
      </div>
      <div class="token-hero-actions">
        <span class="badge text-bg-secondary">Status: <%= order.status || "draft" %></span>
        <a class="btn btn-outline-secondary btn-sm" href="/admin/report-service/orders/<%= order.id %>/measurements">← Ensaios/Medições</a>
        <a class="btn btn-outline-secondary btn-sm" href="/admin/report-service/orders/<%= order.id %>/discharge">Teste de Descarga</a>
        <a class="btn btn-outline-secondary btn-sm" href="/admin/report-service/orders/<%= order.id %>/fluke521">Leituras Fluke BT521</a>
        <a class="btn btn-outline-secondary btn-sm" href="/admin/report-service/orders/<%= order.id %>">Editar OS</a>
        <a class="btn btn-outline-secondary btn-sm" href="/admin/report-service/orders/<%= order.id %>/preview-html" target="_blank" rel="noopener"><%= t("rs.nav.previewReport") %></a>
      </div>
    </div>
  </div>

  <% if (saved) { %><div class="alert alert-success mb-0">Leitura Alber salva com sucesso.</div><% } %>
  <% if (importError) { %><div class="alert alert-danger mb-0"><strong>Erro ao importar:</strong> <%= importError %></div><% } %>

  <!-- Import card -->
  <div class="card app-card">
    <div class="card-body">
      <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div>
          <h2 class="h6 app-card-title mb-1">Importar Arquivo Alber (CSV)</h2>
          <div class="text-muted small">Após importar, use a tag <code>@alber=ID</code> nos capítulos do relatório para inserir as tabelas de medição.</div>
        </div>
      </div>
      <div class="d-flex align-items-center gap-3 flex-wrap">
        <button class="btn btn-primary btn-sm" type="button" id="alberImportBtn">Importar Arquivo Alber</button>
        <input type="file" accept=".csv,.txt" id="alberFileInput" class="d-none" />
        <span class="text-muted small" id="alberFileName"></span>
        <div id="alberImportSpinner" class="spinner-border spinner-border-sm text-primary d-none" role="status"></div>
        <span id="alberImportMsg" class="small"></span>
      </div>
    </div>
  </div>

  <!-- Leituras list -->
  <div class="card app-card">
    <div class="card-body p-0">
      <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
        <h2 class="h6 app-card-title mb-0">Leituras importadas (<%= (alberLeituras || []).length %>)</h2>
      </div>

      <% if (!(alberLeituras || []).length) { %>
        <div class="p-4 text-center text-muted">Nenhuma leitura Alber importada para esta OS.</div>
      <% } %>

      <% (alberLeituras || []).forEach(function(leitura) {
        var celulas = Array.isArray(leitura.celulas) ? leitura.celulas : [];
        var stringLabels = (leitura.string_labels && typeof leitura.string_labels === 'object') ? leitura.string_labels : {};
        var stringNums = [...new Set(celulas.map(function(c){ return Number(c.string_num); }))].sort(function(a,b){return a-b;});
        var ativasCelulas = celulas.filter(function(c){ return c.ativa !== false; });
        var _dc = (leitura.display_config && typeof leitura.display_config === 'object') ? leitura.display_config : {};
        var hiddenCols = Array.isArray(_dc.hiddenColumns) ? _dc.hiddenColumns : [];
        var _ranges = (_dc.ranges && typeof _dc.ranges === 'object') ? _dc.ranges : {};
        function rangeValue(name, fallback) {
          var value = _ranges[name];
          if (value === undefined || value === null || value === '') return fallback;
          var num = Number(value);
          return Number.isFinite(num) ? num : fallback;
        }

        var tensaoMedia = ativasCelulas.length
          ? (ativasCelulas.reduce(function(s,c){return s+Number(c.voltagem);},0) / ativasCelulas.length).toFixed(3)
          : "-";
        var resistMedia = ativasCelulas.length
          ? Math.round(ativasCelulas.reduce(function(s,c){return s+Number(c.resistencia_interna);},0) / ativasCelulas.length)
          : "-";
        var tensoesAtivas = ativasCelulas.map(function(c){ return Number(c.voltagem); });
        var resistenciasAtivas = ativasCelulas.map(function(c){ return Number(c.resistencia_interna); });
        var tensaoMin = tensoesAtivas.length ? Math.min.apply(null, tensoesAtivas).toFixed(3) : "-";
        var tensaoMax = tensoesAtivas.length ? Math.max.apply(null, tensoesAtivas).toFixed(3) : "-";
        var resistMin = resistenciasAtivas.length ? Math.round(Math.min.apply(null, resistenciasAtivas)) : "-";
        var resistMax = resistenciasAtivas.length ? Math.round(Math.max.apply(null, resistenciasAtivas)) : "-";
        var editVoltageMin = rangeValue('voltageMin', '');
        var editVoltageMax = rangeValue('voltageMax', '');
        var editResistanceMin = rangeValue('resistanceMin', '');
        var editResistanceMax = rangeValue('resistanceMax', '');
        var displayTensaoMin = editVoltageMin !== '' ? Number(editVoltageMin).toFixed(3) : tensaoMin;
        var displayTensaoMax = editVoltageMax !== '' ? Number(editVoltageMax).toFixed(3) : tensaoMax;
        var displayResistMin = editResistanceMin !== '' ? Math.round(Number(editResistanceMin)) : resistMin;
        var displayResistMax = editResistanceMax !== '' ? Math.round(Number(editResistanceMax)) : resistMax;
      %>
      <div class="border-bottom p-3">

        <!-- Info bar -->
        <div class="alber-info-bar">
          <div class="alber-info-pair">
            <span class="alber-info-label">Local</span>
            <span class="alber-info-value"><%= leitura.location_name || "-" %></span>
          </div>
          <div class="alber-info-pair">
            <span class="alber-info-label">Banco</span>
            <span class="alber-info-value"><%= leitura.battery_name || "-" %></span>
          </div>
          <% if (leitura.model_number) { %>
          <div class="alber-info-pair">
            <span class="alber-info-label">Modelo</span>
            <span class="alber-info-value"><%= leitura.model_number %></span>
          </div>
          <% } %>
          <div class="alber-info-pair">
            <span class="alber-info-label">Instalação</span>
            <span class="alber-info-value"><%= leitura.install_date || "-" %></span>
          </div>
          <% if (leitura.manufacture_date) { %>
          <div class="alber-info-pair">
            <span class="alber-info-label">Fab. bateria</span>
            <span class="alber-info-value"><%= leitura.manufacture_date %></span>
          </div>
          <% } %>
          <div class="ms-auto d-flex gap-2 align-items-center">
            <code class="small text-primary">@alber=<%= leitura.seq_id %></code>
            <button class="btn btn-outline-secondary btn-sm" type="button" id="alberViewBtn_<%= leitura.id %>" onclick="toggleAlberData(<%= leitura.id %>)">Ver dados</button>
            <button class="btn btn-outline-success btn-sm alber-style-btn"
              data-leitura-id="<%= leitura.id %>"
              data-order-id="<%= order.id %>"
              data-leitura-name="<%= (leitura.battery_name || ('Leitura #' + leitura.id)).replace(/"/g, '&quot;') %>"
              data-has-style="<%= leitura.style_config && !leitura._uses_default_alber_style ? '1' : '0' %>">
              🎨 Visual<% if (leitura.style_config && leitura._uses_default_alber_style) { %> <span class="badge text-bg-secondary" style="font-size:9px;">padrão</span><% } else if (leitura.style_config) { %> <span class="badge text-bg-success" style="font-size:9px;">custom</span><% } %>
            </button>
            <button class="btn btn-outline-secondary btn-sm" type="button" onclick="toggleAlberEditor(<%= leitura.id %>)">
              <span id="alberEditorChevron_<%= leitura.id %>">✏️ Editar</span>
            </button>
            <form method="post" action="/admin/report-service/orders/<%= order.id %>/alber/<%= leitura.id %>/delete" class="m-0" onsubmit="return confirm('Excluir esta leitura Alber e todas as suas células?');">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <button class="btn btn-outline-danger btn-sm" type="submit">Excluir</button>
            </form>
          </div>
        </div>

        <!-- Summary cards + data table (ocultos por padrão) -->
        <div id="alberData_<%= leitura.id %>" class="d-none">

        <!-- Summary cards -->
        <div class="alber-stats-row">
          <div class="alber-stat-card">
            <div class="alber-stat-label">Tensão média</div>
            <div class="alber-stat-value"><%= tensaoMedia %><span class="alber-stat-unit">V</span></div>
          </div>
          <div class="alber-stat-card">
            <div class="alber-stat-label">Resist. média</div>
            <div class="alber-stat-value"><%= resistMedia %><span class="alber-stat-unit">mΩ</span></div>
          </div>
          <div class="alber-stat-card">
            <div class="alber-stat-label">Tensão mínima</div>
            <div class="alber-stat-value"><%= displayTensaoMin %><span class="alber-stat-unit">V</span></div>
          </div>
          <div class="alber-stat-card">
            <div class="alber-stat-label">Tensão máxima</div>
            <div class="alber-stat-value"><%= displayTensaoMax %><span class="alber-stat-unit">V</span></div>
          </div>
          <div class="alber-stat-card">
            <div class="alber-stat-label">Resistência mínima</div>
            <div class="alber-stat-value"><%= displayResistMin %><span class="alber-stat-unit">mΩ</span></div>
          </div>
          <div class="alber-stat-card">
            <div class="alber-stat-label">Resistência máxima</div>
            <div class="alber-stat-value"><%= displayResistMax %><span class="alber-stat-unit">mΩ</span></div>
          </div>
          <div class="alber-stat-card">
            <div class="alber-stat-label">Células ativas</div>
            <div class="alber-stat-value"><%= ativasCelulas.length %><span class="alber-stat-unit">/ <%= celulas.length %></span></div>
          </div>
        </div>

        <!-- Data table(s) per string -->
        <%
          var allColDefs = [
            { key: 'string_num',         label: 'String',               width: '90px' },
            { key: 'celula_num',         label: 'Célula',               width: '90px' },
            { key: 'voltagem',           label: 'Tensão (V)',           width: '130px' },
            { key: 'resistencia_interna',label: 'Resist. Interna (mΩ)', width: null }
          ];
          var visColDefs = allColDefs.filter(function(col){ return hiddenCols.indexOf(col.key) === -1; });
          var visCount = visColDefs.length;
          var showVoltagem = hiddenCols.indexOf('voltagem') === -1;
          var showResist  = hiddenCols.indexOf('resistencia_interna') === -1;
          var idColCount2 = visColDefs.filter(function(c){ return c.key === 'string_num' || c.key === 'celula_num'; }).length;
        %>
        <div class="alber-table-wrap" id="alberPreview_<%= leitura.id %>">
          <% stringNums.forEach(function(sNum) {
            var strCells = celulas.filter(function(c){ return Number(c.string_num) === sNum; });
            var strAtivas = strCells.filter(function(c){ return c.ativa !== false; });
            var label = stringLabels[String(sNum)] || ('Banco ' + sNum);
            var vMedia = strAtivas.length && showVoltagem ? (strAtivas.reduce(function(s,c){return s+Number(c.voltagem);},0)/strAtivas.length).toFixed(3) : null;
            var irMedia = strAtivas.length && showResist ? Math.round(strAtivas.reduce(function(s,c){return s+Number(c.resistencia_interna);},0)/strAtivas.length) : null;
          %>
          <table class="alber-table">
            <thead>
              <tr>
                <th colspan="<%= visCount %>" class="alber-th-title"><%= label %></th>
              </tr>
              <tr>
                <% visColDefs.forEach(function(col) { %>
                <th<%= col.width ? ' style="width:' + col.width + '"' : '' %>><%= col.label %></th>
                <% }); %>
              </tr>
            </thead>
            <tbody>
              <% strCells.forEach(function(c) {
                var inativo = c.ativa === false;
              %>
              <tr<%= inativo ? ' style="opacity:0.45;"' : '' %>>
                <% if (hiddenCols.indexOf('string_num') === -1) { %><td><%= c.string_num %></td><% } %>
                <% if (hiddenCols.indexOf('celula_num') === -1) { %><td><%= c.celula_num %><% if (inativo) { %> <span class="text-muted" style="font-size:10px;">(inativa)</span><% } %></td><% } %>
                <% if (showVoltagem) { %><td><%= Number(c.voltagem).toFixed(3) %></td><% } %>
                <% if (showResist)  { %><td><%= Number(c.resistencia_interna) %></td><% } %>
              </tr>
              <% }); %>
              <% if (strAtivas.length > 0 && (vMedia !== null || irMedia !== null)) { %>
              <tr class="alber-stats-tr">
                <% if (idColCount2 > 0) { %><td colspan="<%= idColCount2 %>">Média — <%= label %></td><% } %>
                <% if (vMedia  !== null) { %><td><%= vMedia %></td><% } %>
                <% if (irMedia !== null) { %><td><%= irMedia %></td><% } %>
              </tr>
              <% } %>
            </tbody>
          </table>
          <% }); %>
        </div>

        </div><!-- /alberData -->

        <!-- Inline editor (collapsed) -->
        <div id="alberEditor_<%= leitura.id %>" class="d-none mt-3 border rounded bg-light p-3">
          <form method="post" action="/admin/report-service/orders/<%= order.id %>/alber/<%= leitura.id %>/update">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <input type="hidden" name="celulas_json" id="celulasJson_<%= leitura.id %>" value="" />
            <input type="hidden" name="string_labels" id="stringLabelsJson_<%= leitura.id %>" value="<%= JSON.stringify(stringLabels).replace(/"/g, '&quot;') %>" />
            <input type="hidden" name="display_config" id="displayConfigJson_<%= leitura.id %>" value="<%= JSON.stringify(leitura.display_config || {}).replace(/"/g, '&quot;') %>" />

            <!-- Colunas visíveis -->
            <div class="mb-3">
              <label class="form-label form-label-sm fw-semibold mb-1">Colunas visíveis na tabela</label>
              <div class="d-flex flex-wrap gap-3">
                <div class="form-check">
                  <input class="form-check-input alber-col-toggle" type="checkbox" id="col_string_<%= leitura.id %>" data-leitura-id="<%= leitura.id %>" data-col="string_num" <%= hiddenCols.indexOf('string_num') === -1 ? 'checked' : '' %> />
                  <label class="form-check-label small" for="col_string_<%= leitura.id %>">Nº String</label>
                </div>
                <div class="form-check">
                  <input class="form-check-input alber-col-toggle" type="checkbox" id="col_celula_<%= leitura.id %>" data-leitura-id="<%= leitura.id %>" data-col="celula_num" <%= hiddenCols.indexOf('celula_num') === -1 ? 'checked' : '' %> />
                  <label class="form-check-label small" for="col_celula_<%= leitura.id %>">Nº Célula</label>
                </div>
                <div class="form-check">
                  <input class="form-check-input alber-col-toggle" type="checkbox" id="col_voltagem_<%= leitura.id %>" data-leitura-id="<%= leitura.id %>" data-col="voltagem" <%= hiddenCols.indexOf('voltagem') === -1 ? 'checked' : '' %> />
                  <label class="form-check-label small" for="col_voltagem_<%= leitura.id %>">Tensão (V)</label>
                </div>
                <div class="form-check">
                  <input class="form-check-input alber-col-toggle" type="checkbox" id="col_resist_<%= leitura.id %>" data-leitura-id="<%= leitura.id %>" data-col="resistencia_interna" <%= hiddenCols.indexOf('resistencia_interna') === -1 ? 'checked' : '' %> />
                  <label class="form-check-label small" for="col_resist_<%= leitura.id %>">Resist. Interna (mΩ)</label>
                </div>
              </div>
            </div>

            <div class="row g-2 mb-3">
              <div class="col-12 col-md-3">
                <label class="form-label form-label-sm mb-1">Local (Location Name)</label>
                <input class="form-control form-control-sm" name="location_name" value="<%= leitura.location_name || '' %>" />
              </div>
              <div class="col-12 col-md-3">
                <label class="form-label form-label-sm mb-1">Banco de Baterias (Battery Name)</label>
                <input class="form-control form-control-sm" name="battery_name" value="<%= leitura.battery_name || '' %>" />
              </div>
              <div class="col-12 col-md-3">
                <label class="form-label form-label-sm mb-1">Modelo (Model Number)</label>
                <input class="form-control form-control-sm" name="model_number" value="<%= leitura.model_number || '' %>" />
              </div>
              <div class="col-12 col-md-3">
                <label class="form-label form-label-sm mb-1">Data de Instalação</label>
                <input class="form-control form-control-sm" name="install_date" value="<%= leitura.install_date || '' %>" />
              </div>
              <div class="col-12 col-md-3">
                <label class="form-label form-label-sm mb-1">Data de Fabricação da Bateria</label>
                <input class="form-control form-control-sm" name="manufacture_date" value="<%= leitura.manufacture_date || '' %>" />
              </div>
            </div>

            <div class="mb-3 border rounded bg-white p-3">
              <label class="form-label form-label-sm fw-semibold mb-2">Faixas para destaque em vermelho</label>
              <div class="row g-2">
                <div class="col-12 col-md-3">
                  <label class="form-label form-label-sm mb-1">Tensão mínima (V)</label>
                  <input type="number" step="0.001" class="form-control form-control-sm alber-range-input" data-leitura-id="<%= leitura.id %>" data-range="voltageMin" value="<%= editVoltageMin %>" placeholder="<%= tensaoMin %>" />
                </div>
                <div class="col-12 col-md-3">
                  <label class="form-label form-label-sm mb-1">Tensão máxima (V)</label>
                  <input type="number" step="0.001" class="form-control form-control-sm alber-range-input" data-leitura-id="<%= leitura.id %>" data-range="voltageMax" value="<%= editVoltageMax %>" placeholder="<%= tensaoMax %>" />
                </div>
                <div class="col-12 col-md-3">
                  <label class="form-label form-label-sm mb-1">Resistência mínima (mΩ)</label>
                  <input type="number" step="1" class="form-control form-control-sm alber-range-input" data-leitura-id="<%= leitura.id %>" data-range="resistanceMin" value="<%= editResistanceMin %>" placeholder="<%= resistMin %>" />
                </div>
                <div class="col-12 col-md-3">
                  <label class="form-label form-label-sm mb-1">Resistência máxima (mΩ)</label>
                  <input type="number" step="1" class="form-control form-control-sm alber-range-input" data-leitura-id="<%= leitura.id %>" data-range="resistanceMax" value="<%= editResistanceMax %>" placeholder="<%= resistMax %>" />
                </div>
              </div>
            </div>

            <% stringNums.forEach(function(sNum) {
              var strCells = celulas.filter(function(c){ return Number(c.string_num) === sNum; });
              var defaultLabel = 'Banco ' + sNum;
              var label = stringLabels[String(sNum)] || defaultLabel;
            %>
            <div class="mb-3 border rounded" data-string-num="<%= sNum %>" data-leitura-id="<%= leitura.id %>">
              <div class="p-2 bg-white border-bottom d-flex align-items-center gap-2">
                <label class="form-label form-label-sm mb-0 fw-semibold" style="min-width:80px;">Rótulo:</label>
                <input class="form-control form-control-sm string-label-input"
                  style="max-width:220px;"
                  data-leitura-id="<%= leitura.id %>"
                  data-string-num="<%= sNum %>"
                  value="<%= label %>"
                  placeholder="<%= defaultLabel %>" />
              </div>
              <div class="table-responsive">
                <table class="table table-sm app-table mb-0 alber-cells-table" data-leitura-id="<%= leitura.id %>" data-string-num="<%= sNum %>">
                  <thead>
                    <tr>
                      <th style="width:80px;">Nº String</th>
                      <th style="width:90px;">Nº Célula</th>
                      <th style="width:130px;">Voltagem (V)</th>
                      <th style="width:160px;">Resist. Interna (mΩ)</th>
                      <th style="width:70px;">Ativa</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% strCells.forEach(function(c) { %>
                    <tr data-leitura-id="<%= leitura.id %>" data-string-num="<%= c.string_num %>" data-celula-num="<%= c.celula_num %>">
                      <td><%= c.string_num %></td>
                      <td><%= c.celula_num %></td>
                      <td><input type="number" step="0.001" class="form-control form-control-sm cell-voltagem" data-leitura-id="<%= leitura.id %>" value="<%= Number(c.voltagem).toFixed(3) %>" style="width:110px;" /></td>
                      <td><input type="number" step="1" class="form-control form-control-sm cell-resistencia" data-leitura-id="<%= leitura.id %>" value="<%= Number(c.resistencia_interna) %>" style="width:120px;" /></td>
                      <td><input type="checkbox" class="form-check-input cell-ativa" data-leitura-id="<%= leitura.id %>" <%= c.ativa !== false ? 'checked' : '' %> /></td>
                    </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>
            </div>
            <% }); %>

            <div class="d-flex justify-content-end gap-2 mt-2">
              <button type="button" class="btn btn-outline-secondary btn-sm" onclick="cancelAlberEditor(<%= leitura.id %>)">Cancelar</button>
              <button type="submit" class="btn btn-primary btn-sm" onclick="syncAlberEditor(<%= leitura.id %>)">Salvar alterações</button>
            </div>
          </form>
        </div>

      </div>
      <% }); %>
    </div>
  </div>
</section>

