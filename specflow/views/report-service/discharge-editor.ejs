<script>
(function () {
  var dModal = document.getElementById("dStyleModal");
  if (!dModal) return;
  var bsDModal = null;
  function getDModal() { if (!bsDModal) bsDModal = new bootstrap.Modal(dModal); return bsDModal; }

  var previewContent = document.getElementById("dsmPreviewContent");
  var chatArea      = document.getElementById("dsmChatArea");
  var overlay       = document.getElementById("dsmOverlay");
  var inputEl       = document.getElementById("dsmInput");
  var sendBtn       = document.getElementById("dsmSendBtn");
  var saveBtn       = document.getElementById("dsmSaveBtn");
  var defaultBtn    = document.getElementById("dsmDefaultBtn");
  var resetBtn      = document.getElementById("dsmResetBtn");
  var unsavedBadge  = document.getElementById("dsmUnsavedBadge");
  var testNameEl    = document.getElementById("dsmTestName");
  var previewHint   = document.getElementById("dsmPreviewHint");

  var activeTestId = null, activeOrderId = null, pendingStyle = null;
  var csrfToken = (document.querySelector('[name="_csrf"]') || {}).value || "";
  var typingEl = null;

  function setUnsaved(on) { unsavedBadge.classList.toggle("d-none", !on); saveBtn.disabled = !on && !pendingStyle; }
  function showOverlay(on) { overlay.style.display = on ? "flex" : "none"; }
  function setInputBusy(on) {
    sendBtn.disabled = on;
    inputEl.disabled = on;
    resetBtn.disabled = on;
    if (defaultBtn) defaultBtn.disabled = on;
  }

  function addBubble(type, text) {
    removeTyping();
    var div = document.createElement("div");
    div.className = "msm-bubble " + type;
    div.textContent = text;
    chatArea.appendChild(div);
    chatArea.scrollTop = chatArea.scrollHeight;
    return div;
  }

  function showTyping() {
    removeTyping();
    typingEl = document.createElement("div");
    typingEl.className = "msm-bubble ai msm-typing";
    typingEl.innerHTML = "<span></span><span></span><span></span>";
    chatArea.appendChild(typingEl);
    chatArea.scrollTop = chatArea.scrollHeight;
  }

  function removeTyping() { if (typingEl && typingEl.parentNode) typingEl.parentNode.removeChild(typingEl); typingEl = null; }
  function updatePreview(html) { previewContent.innerHTML = html || ""; }

  function apiUrl(path) {
    return "/admin/report-service/orders/" + activeOrderId + "/discharge/" + activeTestId + "/" + path;
  }

  async function callAi(instruction, apply) {
    var body = new URLSearchParams();
    body.set("_csrf", csrfToken);
    if (instruction) body.set("instruction", instruction);
    if (pendingStyle) body.set("current_style", JSON.stringify(pendingStyle));
    if (apply) body.set("apply", "true");
    var resp = await fetch(apiUrl("style-ai"), { method: "POST", headers: { "Content-Type": "application/x-www-form-urlencoded" }, body: body.toString() });
    if (!resp.ok) { var data = await resp.json().catch(function () { return {}; }); throw new Error(data.error || "Erro na requisição."); }
    return resp.json();
  }

  async function callReset() {
    var body = new URLSearchParams();
    body.set("_csrf", csrfToken);
    var resp = await fetch(apiUrl("style-reset"), { method: "POST", headers: { "Content-Type": "application/x-www-form-urlencoded" }, body: body.toString() });
    if (!resp.ok) throw new Error("Erro ao resetar.");
    return resp.json();
  }

  async function callDefault() {
    var body = new URLSearchParams();
    body.set("_csrf", csrfToken);
    if (pendingStyle) body.set("current_style", JSON.stringify(pendingStyle));
    var resp = await fetch(apiUrl("style-default"), { method: "POST", headers: { "Content-Type": "application/x-www-form-urlencoded" }, body: body.toString() });
    if (!resp.ok) { var data = await resp.json().catch(function () { return {}; }); throw new Error(data.error || "Erro ao salvar padrão."); }
    return resp.json();
  }

  document.querySelectorAll(".discharge-style-btn").forEach(function (btn) {
    btn.addEventListener("click", function () {
      activeTestId  = Number(btn.getAttribute("data-test-id") || 0);
      activeOrderId = btn.getAttribute("data-order-id") || "";
      pendingStyle  = null;
      chatArea.innerHTML = "";
      inputEl.value = "";
      previewHint.textContent = "";
      setUnsaved(false);
      saveBtn.disabled = true;
      if (defaultBtn) defaultBtn.disabled = true;
      testNameEl.textContent = btn.getAttribute("data-test-name") || ("Teste #" + activeTestId);
      showOverlay(true);
      getDModal().show();
      callAi(null, false).then(function (r) {
        showOverlay(false);
        updatePreview(r.previewHtml);
        pendingStyle = r.styleConfig || null;
        if (defaultBtn) defaultBtn.disabled = !pendingStyle;
        previewHint.textContent = "Envie uma instrução para personalizar";
        addBubble("ai", "Olá! Descreva o que deseja alterar: cores do cabeçalho, fontes, bordas, fundo das células, coluna de célula em destaque. Use os atalhos abaixo ou escreva livremente.");
      }).catch(function (err) {
        showOverlay(false);
        previewContent.innerHTML = "<p style='color:#dc2626;font-size:12px;'>Erro ao carregar preview: " + (err.message || "") + "</p>";
      });
    });
  });

  function sendInstruction() {
    var instruction = (inputEl.value || "").trim();
    if (!instruction || sendBtn.disabled) return;
    setInputBusy(true);
    addBubble("user", instruction);
    inputEl.value = "";
    showTyping();
    previewHint.textContent = "Aplicando alterações...";
    callAi(instruction, false).then(function (r) {
      removeTyping();
      updatePreview(r.previewHtml);
      pendingStyle = r.styleConfig || null;
      setUnsaved(true);
      saveBtn.disabled = false;
      if (defaultBtn) defaultBtn.disabled = false;
      previewHint.textContent = "Preview atualizado — salve quando estiver satisfeito";
      addBubble("ai", "Feito! Verifique o preview ao lado. Você pode continuar ajustando ou salvar.");
    }).catch(function (err) {
      removeTyping();
      addBubble("err", "Erro: " + (err.message || "Falha na IA."));
      previewHint.textContent = "";
    }).finally(function () {
      setInputBusy(false);
      inputEl.focus();
    });
  }

  sendBtn.addEventListener("click", sendInstruction);
  inputEl.addEventListener("keydown", function (e) { if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); sendInstruction(); } });

  dModal.querySelectorAll(".msm-chip").forEach(function (chip) {
    chip.addEventListener("click", function () { inputEl.value = chip.getAttribute("data-s") || ""; inputEl.focus(); });
  });

  saveBtn.addEventListener("click", function () {
    if (!pendingStyle) return;
    setInputBusy(true);
    saveBtn.disabled = true;
    callAi(null, true).then(function () {
      var styleBtn = document.querySelector('.discharge-style-btn[data-test-id="' + activeTestId + '"]');
      if (styleBtn) {
        styleBtn.setAttribute("data-has-style", "1");
        var badge = styleBtn.querySelector(".badge");
        if (badge) badge.remove();
        styleBtn.insertAdjacentHTML("beforeend", ' <span class="badge text-bg-primary" style="font-size:9px;">custom</span>');
      }
      setUnsaved(false);
      getDModal().hide();
    }).catch(function (err) {
      addBubble("err", "Erro ao salvar: " + (err.message || "Tente novamente."));
      saveBtn.disabled = false;
    }).finally(function () {
      setInputBusy(false);
    });
  });

  if (defaultBtn) {
    defaultBtn.addEventListener("click", function () {
      if (!pendingStyle) return;
      setInputBusy(true);
      defaultBtn.disabled = true;
      callDefault().then(function (r) {
        updatePreview(r.previewHtml);
        pendingStyle = r.styleConfig || pendingStyle;
        var styleBtn = document.querySelector('.discharge-style-btn[data-test-id="' + activeTestId + '"]');
        if (styleBtn) {
          styleBtn.setAttribute("data-has-style", "1");
          var badge = styleBtn.querySelector(".badge");
          if (badge) badge.remove();
          styleBtn.insertAdjacentHTML("beforeend", ' <span class="badge text-bg-primary" style="font-size:9px;">custom</span>');
        }
        setUnsaved(false);
        saveBtn.disabled = true;
        previewHint.textContent = "Estilo salvo como padrão para novos testes de descarga";
        addBubble("ai", "Este visual foi salvo como padrão. Outros testes de descarga sem estilo próprio usarão este visual automaticamente.");
      }).catch(function (err) {
        addBubble("err", "Erro ao salvar padrão: " + (err.message || "Tente novamente."));
      }).finally(function () {
        setInputBusy(false);
        defaultBtn.disabled = !pendingStyle;
      });
    });
  }

  resetBtn.addEventListener("click", function () {
    if (!confirm("Restaurar o visual padrão deste teste de descarga?")) return;
    setInputBusy(true);
    callReset().then(function (r) {
      updatePreview(r.previewHtml);
      pendingStyle = r.styleConfig || null;
      chatArea.innerHTML = "";
      setUnsaved(false);
      saveBtn.disabled = true;
      if (defaultBtn) defaultBtn.disabled = !pendingStyle;
      previewHint.textContent = "Visual padrão restaurado";
      addBubble("ai", "Visual restaurado para o padrão. Envie novas instruções para personalizar novamente.");
      var styleBtn = document.querySelector('.discharge-style-btn[data-test-id="' + activeTestId + '"]');
      if (styleBtn) {
        styleBtn.setAttribute("data-has-style", "0");
        var badge = styleBtn.querySelector(".badge");
        if (badge) badge.remove();
        if (pendingStyle) {
          styleBtn.insertAdjacentHTML("beforeend", ' <span class="badge text-bg-secondary" style="font-size:9px;">padrão</span>');
        }
      }
    }).catch(function (err) {
      addBubble("err", "Erro ao restaurar: " + (err.message || "Tente novamente."));
    }).finally(function () {
      setInputBusy(false);
    });
  });
})();
</script>

