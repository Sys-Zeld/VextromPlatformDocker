<%- include("../partials/head", { pageTitle }) %>
<link href="/public/css/report-editor.css?v=<%= appVersion %>" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>

<style>
  .discharge-table-wrap {
    border: 1px solid #e2e8f0;
    border-radius: 0 0 6px 6px;
    overflow-x: auto;
  }
  .discharge-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 12px;
    white-space: nowrap;
  }
  .discharge-table thead th {
    background: #1e3a5f;
    color: #fff;
    padding: 7px 10px;
    text-align: center;
    font-size: 11px;
    font-weight: 600;
    border: 1px solid #2d5a8e;
    letter-spacing: 0.03em;
    position: sticky;
    top: 0;
    z-index: 2;
  }
  .discharge-table thead th.th-celula { text-align: left; min-width: 70px; position: sticky; left: 0; z-index: 3; }
  .discharge-table thead th.th-flutuacao { min-width: 90px; }
  .discharge-table thead th.th-hora { min-width: 80px; }
  .discharge-table tbody td {
    padding: 5px 10px;
    border: 1px solid #cbd5e1;
    color: #1e293b;
    vertical-align: middle;
    text-align: center;
  }
  .discharge-table tbody td.td-celula { text-align: left; font-weight: 600; background: #f8fafc; position: sticky; left: 0; z-index: 1; border-right: 2px solid #cbd5e1; }
  .discharge-table tbody tr:nth-child(even) td { background: #f0f4fa; }
  .discharge-table tbody tr:nth-child(even) td.td-celula { background: #edf2f9; }
  /* Grade editável: célula da tabela mais justa, já que o input traz o próprio padding. */
  .discharge-edit-table tbody td { padding: 3px 5px; }
  .discharge-edit-table input { text-align: center; }
  .discharge-edit-table input:invalid { border-color: #dc2626; background: #fef2f2; }
  /* Botão ✕ de excluir coluna, no cabeçalho da grade de edição. */
  .discharge-edit-table thead th { position: relative; }
  .discharge-edit-table .dcol-del {
    border: none; background: rgba(255,255,255,0.22); color: #fff;
    border-radius: 3px; line-height: 1; cursor: pointer;
    font-size: 10px; padding: 1px 4px; margin-left: 6px;
  }
  .discharge-edit-table .dcol-del:hover { background: #dc2626; }
  /* Coluna marcada para exclusão: riscada e com os campos desativados. Os inputs
     permanecem no DOM (só desabilitados) para que os índices de coluna não mudem
     antes do envio — é por esse índice que o servidor identifica a coluna. */
  .discharge-edit-table th.dcol-doomed .dcol-label { text-decoration: line-through; opacity: 0.6; }
  .discharge-edit-table th.dcol-doomed { background: #7f1d1d !important; border-color: #7f1d1d !important; }
  .discharge-edit-table th.dcol-doomed .dcol-del { background: #dc2626; }
  .discharge-edit-table td.dcol-doomed { background: #fee2e2 !important; }
  .discharge-edit-table td.dcol-doomed input { text-decoration: line-through; color: #991b1b; }
  .discharge-edit-table .dcol-collapsed { display: none; }
  /* Título do teste, acima dos cards — mesmo visual do .discharge-block-title do relatório. */
  .discharge-block-title {
    font-size: 12px; font-weight: 700; color: #1e3a5f; text-transform: uppercase;
    letter-spacing: 0.04em; margin: 0 0 6px 0; padding-bottom: 3px;
    border-bottom: 2px solid #1e3a5f;
  }
  /* Cards de estatística por período, acima da tabela. Mesmo visual do relatório: faixa
     de título no azul-marinho do cabeçalho da tabela, corpo claro, número à direita.
     A mínima em âmbar por ser o valor diagnóstico (denuncia a célula fraca). */
  .discharge-stats-cards { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 10px; }
  .discharge-stat-card {
    flex: 1 1 128px; min-width: 128px; max-width: 210px;
    border: 1px solid #2d5a8e; border-radius: 6px; background: #fff; overflow: hidden;
    box-shadow: 0 1px 2px rgba(15, 42, 74, 0.08);
  }
  .discharge-stat-card .dsc-period {
    background: #1e3a5f; color: #fff; font-size: 9.5px; font-weight: 700;
    letter-spacing: 0.06em; text-transform: uppercase; padding: 4px 9px;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .discharge-stat-card .dsc-body { padding: 4px 9px 5px; }
  .discharge-stat-card .dsc-line {
    display: flex; align-items: center; justify-content: space-between;
    line-height: 1.5; white-space: nowrap;
  }
  .discharge-stat-card .dsc-line + .dsc-line { border-top: 1px solid #eef2f7; }
  .discharge-stat-card .dsc-key {
    color: #64748b; font-size: 9px; font-weight: 600;
    letter-spacing: 0.05em; text-transform: uppercase;
  }
  .discharge-stat-card .dsc-val {
    color: #1e3a5f; font-size: 11.5px; font-weight: 700; font-variant-numeric: tabular-nums;
  }
  .discharge-stat-card .dsc-line-min .dsc-val { color: #b45309; }
  .discharge-stat-card .dsc-line-avg .dsc-val { color: #334155; }
  /* Cards do editor: recalculados a cada tecla, ainda não gravados. O selo "prévia" e a
     borda tracejada distinguem do card do painel "Ver dados", que mostra o que está no banco. */
  .discharge-stats-cards.discharge-stats-live { margin-bottom: 8px; }
  .discharge-stat-card.dsc-preview { border-style: dashed; }
  .discharge-stat-card .dsc-badge {
    float: right; font-size: 8px; font-weight: 600; letter-spacing: 0.04em;
    background: rgba(255, 255, 255, 0.22); border-radius: 3px; padding: 0 4px; margin-left: 6px;
  }
  .discharge-stat-card.dsc-doomed { opacity: 0.5; border-color: #dc2626; }
  .discharge-stat-card.dsc-doomed .dsc-period { background: #7f1d1d; text-decoration: line-through; }
  .discharge-stat-card.dsc-doomed .dsc-val { text-decoration: line-through; }
  .discharge-stat-card.dcol-collapsed { display: none; }
  .discharge-info-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 6px 6px 0 0;
    border-bottom: none;
    padding: 10px 16px;
    align-items: center;
    font-size: 13px;
  }
  .discharge-info-pair {
    display: flex;
    align-items: center;
    gap: 6px;
    padding-right: 20px;
  }
  .discharge-info-pair + .discharge-info-pair {
    border-left: 1px solid #e2e8f0;
    padding-left: 20px;
  }
  .discharge-info-label { color: #64748b; font-size: 12px; }
  .discharge-info-value { font-weight: 600; color: #1e293b; }
</style>

<section class="token-console">
  <div class="card app-card token-hero-card">
    <div class="card-body token-hero-body">
      <div class="token-hero-copy">
        <span class="token-hero-eyebrow">TESTE DE DESCARGA</span>
        <h1 class="h4 app-card-title mb-1"><%= order.service_order_display || "-" %></h1>
        <p class="text-muted mb-0"><%= order.title %> - <%= order.customer_name %></p>
      </div>
      <div class="token-hero-actions">
        <span class="badge text-bg-secondary">Status: <%= order.status || "draft" %></span>
        <a class="btn btn-outline-secondary btn-sm" href="/admin/report-service/orders/<%= order.id %>/measurements">← Ensaios/Medições</a>
        <a class="btn btn-outline-secondary btn-sm" href="/admin/report-service/orders/<%= order.id %>/alber">Leituras Alber</a>
        <a class="btn btn-outline-secondary btn-sm" href="/admin/report-service/orders/<%= order.id %>/fluke521">Leituras Fluke BT521</a>
        <a class="btn btn-outline-secondary btn-sm" href="/admin/report-service/orders/<%= order.id %>">Editar OS</a>
        <a class="btn btn-outline-secondary btn-sm" href="/admin/report-service/orders/<%= order.id %>/preview-html" target="_blank" rel="noopener"><%= t("rs.nav.previewReport") %></a>
      </div>
    </div>
  </div>

  <% if (saved) { %><div class="alert alert-success mb-0">Teste de Descarga salvo com sucesso.</div><% } %>
  <% if (importError) { %><div class="alert alert-danger mb-0"><strong>Erro ao importar:</strong> <%= importError %></div><% } %>

  <!-- Import card -->
  <div class="card app-card">
    <div class="card-body">
      <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div>
          <h2 class="h6 app-card-title mb-1">Importar CSV de Descarga</h2>
          <div class="text-muted small">
            Formato esperado: <code>Célula;Flutuação;1º Hora;2º Hora;...</code> (separado por <code>;</code> ou <code>,</code>).
            Após importar, use a tag <code>@discharge=ID</code> nos capítulos do relatório.
          </div>
        </div>
      </div>
      <div class="d-flex align-items-center gap-3 flex-wrap">
        <button class="btn btn-primary btn-sm" type="button" id="dischargeImportBtn">Importar CSV</button>
        <input type="file" accept=".csv,.txt" id="dischargeFileInput" class="d-none" />
        <span class="text-muted small" id="dischargeFileName"></span>
        <div id="dischargeImportSpinner" class="spinner-border spinner-border-sm text-primary d-none" role="status"></div>
        <span id="dischargeImportMsg" class="small"></span>
      </div>
    </div>
  </div>

  <!-- Tests list -->
  <div class="card app-card">
    <div class="card-body p-0">
      <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
        <h2 class="h6 app-card-title mb-0">Testes importados (<%= (dischargeTests || []).length %>)</h2>
      </div>

      <% if (!(dischargeTests || []).length) { %>
        <div class="p-4 text-center text-muted">Nenhum teste de descarga importado para esta OS.</div>
      <% } %>

      <% (dischargeTests || []).forEach(function(test) {
        var hourLabels = Array.isArray(test.hour_labels) ? test.hour_labels : [];
        var readings = Array.isArray(test.readings) ? test.readings : [];
        var totalCelulas = readings.length;
        var totalHoras = hourLabels.length;
      %>
      <%
        // Testes importados do Fluke BT521 só com a tabela de descarga não têm tensão de
        // flutuação (ela vem do VDC da tabela "mΩ-Volt"). Somar nulos daria 0 e criaria um
        // primeiro ponto falso, então a coluna sai do gráfico e da tabela quando vazia.
        var hasFlutuacao = readings.some(function(r) { return r.flutuacao !== null && r.flutuacao !== undefined && !isNaN(parseFloat(r.flutuacao)); });
        var chartLabels = hasFlutuacao ? [(test.col_flutuacao_label || 'Flutuação')] : [];
        var chartValues = [];
        if (hasFlutuacao) {
          var fSum = 0;
          readings.forEach(function(r) { var v = parseFloat(r.flutuacao); if (!isNaN(v)) fSum += v; });
          chartValues.push(parseFloat(fSum.toFixed(3)));
        }
        hourLabels.forEach(function(label, idx) {
          chartLabels.push(label);
          var hSum = 0;
          readings.forEach(function(r) { var h = Array.isArray(r.horas) ? r.horas : []; var v = parseFloat(h[idx]); if (!isNaN(v)) hSum += v; });
          chartValues.push(parseFloat(hSum.toFixed(3)));
        });
        var cellSeries = readings.map(function(r) {
          var cv = [];
          if (hasFlutuacao) {
            var fv = parseFloat(r.flutuacao);
            cv.push(isNaN(fv) ? null : parseFloat(fv.toFixed(3)));
          }
          var horas = Array.isArray(r.horas) ? r.horas : [];
          horas.forEach(function(v) { var hv = parseFloat(v); cv.push(isNaN(hv) ? null : parseFloat(hv.toFixed(3))); });
          return { name: String(r.celula || ''), values: cv };
        });
        var safeChartJson = JSON.stringify({labels:chartLabels,values:chartValues,cells:cellSeries,title:test.title||('Teste #'+test.id),nominal:test.nominal_voltage||null})
          .replace(/</g,'\\u003C').replace(/>/g,'\\u003E').replace(/&/g,'\\u0026');
      %>
      <script type="application/json" id="dischargeChartData_<%= test.id %>"><%- safeChartJson %></script>
      <div class="border-bottom p-3">

        <!-- Info bar -->
        <div class="discharge-info-bar">
          <% if (test.fluke_leitura_id) { %>
          <div class="discharge-info-pair">
            <span class="badge text-bg-info">via Fluke BT521</span>
          </div>
          <% } %>
          <div class="discharge-info-pair">
            <span class="discharge-info-label">Células</span>
            <span class="discharge-info-value"><%= totalCelulas %></span>
          </div>
          <div class="discharge-info-pair">
            <span class="discharge-info-label">Horas de medição</span>
            <span class="discharge-info-value"><%= totalHoras %></span>
          </div>
          <% if (test.nominal_voltage) { %>
          <div class="discharge-info-pair">
            <span class="discharge-info-label">Tensão nominal</span>
            <span class="discharge-info-value"><%= test.nominal_voltage %> V</span>
          </div>
          <% } %>
          <% if (test.measurement_date) { %>
          <div class="discharge-info-pair">
            <span class="discharge-info-label">Data</span>
            <span class="discharge-info-value"><%= test.measurement_date %></span>
          </div>
          <% } %>
          <div class="ms-auto d-flex gap-2 align-items-center">
            <code class="small text-primary">@discharge=<%= test.seq_id %></code>
            <% if (readings.length > 0) { %><code class="small text-success">@grafo=<%= test.seq_id %></code><% } %>
            <button class="btn btn-outline-secondary btn-sm" type="button" id="dischargeViewBtn_<%= test.id %>" onclick="toggleDischargeData(<%= test.id %>)">Ver dados</button>
            <% if (readings.length > 0) { %>
            <button class="btn btn-outline-info btn-sm" type="button" onclick="openDischargeChart(<%= test.id %>)">📈 Ver gráfico</button>
            <% } %>
            <button class="btn btn-outline-secondary btn-sm" type="button" onclick="toggleDischargeEditor(<%= test.id %>)">
              <span id="dischargeEditorChevron_<%= test.id %>">✏️ Editar</span>
            </button>
            <button class="btn btn-outline-primary btn-sm discharge-style-btn"
              type="button"
              data-test-id="<%= test.id %>"
              data-order-id="<%= order.id %>"
              data-test-name="<%= test.title || ('Teste #' + test.id) %>"
              data-has-style="<%= test.style_config ? '1' : '0' %>">
              🎨 Visual<% if (test.style_config) { %> <span class="badge text-bg-primary" style="font-size:9px;">custom</span><% } %>
            </button>
            <% if (readings.length > 0) { %>
            <button class="btn btn-outline-success btn-sm discharge-chart-style-btn"
              type="button"
              data-test-id="<%= test.id %>"
              data-order-id="<%= order.id %>"
              data-test-name="<%= test.title || ('Teste #' + test.id) %>"
              data-has-chart-style="<%= (test.style_config && test.style_config.chartCustomCss) ? '1' : '0' %>">
              📊 Gráfico<% if (test.style_config && test.style_config.chartCustomCss) { %> <span class="badge text-bg-success" style="font-size:9px;">custom</span><% } %>
            </button>
            <% } %>
            <form method="post" action="/admin/report-service/orders/<%= order.id %>/discharge/<%= test.id %>/delete" class="m-0" onsubmit="return confirm('Excluir este teste de descarga?');">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <button class="btn btn-outline-danger btn-sm" type="submit">Excluir</button>
            </form>
          </div>
        </div>

        <!-- Data table (oculta por padrão) -->
        <div id="dischargeData_<%= test.id %>" class="d-none mt-2">
          <% if (readings.length > 0) { %>
          <%
            // Cards de estatística por período — os números vêm calculados pelo controller
            // com a MESMA função do relatório (buildDischargeColumnStats), para a tela não
            // divergir do PDF.
            var st = statsByTest && statsByTest.get ? statsByTest.get(Number(test.id)) : null;
            // fmtDischargeValue vem do controller: é a MESMA função do relatório (x,xxx).
            var fmtStat = fmtDischargeValue;
            var statCards = [];
            if (st) {
              if (hasFlutuacao) statCards.push({ label: (test.col_flutuacao_label || 'Flutuação (V)'), s: st.flutuacao });
              (st.horas || []).forEach(function(s, h) { statCards.push({ label: String(hourLabels[h] || ('T' + (h + 1))), s: s }); });
            }
          %>
          <% if (test.title && String(test.title).trim()) { %>
          <div class="discharge-block-title"><%= test.title %></div>
          <% } %>
          <% if (statCards.length) { %>
          <div class="discharge-stats-cards">
            <% statCards.forEach(function(card) { %>
            <div class="discharge-stat-card">
              <div class="dsc-period"><%= card.label %></div>
              <div class="dsc-body">
                <div class="dsc-line dsc-line-max"><span class="dsc-key">Máx</span><span class="dsc-val"><%= fmtStat(card.s ? card.s.max : null) %></span></div>
                <div class="dsc-line dsc-line-min"><span class="dsc-key">Mín</span><span class="dsc-val"><%= fmtStat(card.s ? card.s.min : null) %></span></div>
                <div class="dsc-line dsc-line-avg"><span class="dsc-key">Méd</span><span class="dsc-val"><%= fmtStat(card.s ? card.s.avg : null) %></span></div>
              </div>
            </div>
            <% }); %>
          </div>
          <% } %>
          <div class="discharge-table-wrap">
            <table class="discharge-table">
              <thead>
                <tr>
                  <th class="th-celula">Célula</th>
                  <% if (hasFlutuacao) { %><th class="th-flutuacao">Flutuação (V)</th><% } %>
                  <% hourLabels.forEach(function(h) { %>
                    <th class="th-hora"><%= h %></th>
                  <% }); %>
                </tr>
              </thead>
              <tbody>
                <%
                  // Mesmas funções do relatório: a tela destaca exatamente o que o PDF destaca.
                  var vLim = dischargeLimitsOf(test);
                  var bStyle = function(breach) {
                    return breach ? ' style="background:' + vLim.colors[breach] + ';font-weight:700;"' : '';
                  };
                %>
                <% readings.forEach(function(row) {
                  var horas = Array.isArray(row.horas) ? row.horas : [];
                  var fB = hasFlutuacao ? dischargeBreachOf(row.flutuacao, vLim) : null;
                  var hB = horas.map(function(v) { return dischargeBreachOf(v, vLim); });
                  var rowB = fB || hB.filter(function(b) { return b; })[0] || null;
                %>
                <tr>
                  <td class="td-celula"<%- bStyle(rowB) %>><%= row.celula %></td>
                  <% if (hasFlutuacao) { %><td<%- bStyle(fB) %>><%= fmtDischargeValue(row.flutuacao) %></td><% } %>
                  <% horas.forEach(function(v, hi) { %>
                    <td<%- bStyle(hB[hi]) %>><%= fmtDischargeValue(v) %></td>
                  <% }); %>
                </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
          <% } else { %>
            <div class="text-muted small p-2">Sem leituras.</div>
          <% } %>
        </div>

        <!-- Edit form (oculto por padrão) -->
        <div id="dischargeEditor_<%= test.id %>" class="d-none mt-2">
          <form method="post" action="/admin/report-service/orders/<%= order.id %>/discharge/<%= test.id %>/update" class="row g-2"
            data-discharge-form="<%= test.id %>">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <div class="col-12 col-md-5">
              <label class="form-label form-label-sm mb-1">Título</label>
              <input class="form-control form-control-sm" name="title" value="<%= test.title || '' %>" placeholder="Ex: 4.3 Teste de Descarga — Banco A" />
            </div>
            <div class="col-6 col-md-2">
              <label class="form-label form-label-sm mb-1">Data da medição</label>
              <input class="form-control form-control-sm" name="measurement_date" value="<%= test.measurement_date || '' %>" placeholder="DD/MM/AAAA" />
            </div>
            <div class="col-6 col-md-2">
              <label class="form-label form-label-sm mb-1">Tensão nominal (V)</label>
              <input class="form-control form-control-sm" name="nominal_voltage" type="number" step="0.01" value="<%= test.nominal_voltage !== null && test.nominal_voltage !== undefined ? test.nominal_voltage : '' %>" placeholder="Ex: 48" />
            </div>
            <div class="col-12 col-md-3">
              <label class="form-label form-label-sm mb-1">Observações</label>
              <input class="form-control form-control-sm" name="notes" value="<%= test.notes || '' %>" placeholder="Observações opcionais" />
            </div>

            <%
              // Limites já gravados, normalizados pela MESMA função do relatório.
              var lim = dischargeLimitsOf(test);
            %>
            <div class="col-12">
              <div class="border rounded p-2 bg-light">
                <div class="fw-semibold small mb-2">
                  Limites de comparação
                  <span class="text-muted fw-normal" style="font-size:11px;">
                    — valores fora da faixa ficam destacados na tabela e no relatório.
                    Deixe em branco para não comparar daquele lado.
                  </span>
                </div>
                <div class="row g-2 align-items-end">
                  <div class="col-6 col-md-3">
                    <label class="form-label form-label-sm mb-1">Valor mínimo</label>
                    <input class="form-control form-control-sm" name="limit_min" type="number" step="any"
                      value="<%= lim.min !== null ? lim.min : '' %>" placeholder="Ex: 1.900" />
                  </div>
                  <div class="col-6 col-md-2">
                    <label class="form-label form-label-sm mb-1">Cor do mínimo</label>
                    <input class="form-control form-control-sm form-control-color" name="limit_color_min"
                      type="color" value="<%= lim.colors.min %>" title="Cor de destaque para abaixo do mínimo" />
                  </div>
                  <div class="col-6 col-md-3">
                    <label class="form-label form-label-sm mb-1">Valor máximo</label>
                    <input class="form-control form-control-sm" name="limit_max" type="number" step="any"
                      value="<%= lim.max !== null ? lim.max : '' %>" placeholder="Ex: 2.300" />
                  </div>
                  <div class="col-6 col-md-2">
                    <label class="form-label form-label-sm mb-1">Cor do máximo</label>
                    <input class="form-control form-control-sm form-control-color" name="limit_color_max"
                      type="color" value="<%= lim.colors.max %>" title="Cor de destaque para acima do máximo" />
                  </div>
                </div>
              </div>
            </div>

            <% var hourLabels = Array.isArray(test.hour_labels) ? test.hour_labels : []; %>
            <% if (hourLabels.length > 0) { %>
            <div class="col-12">
              <div class="border rounded p-2 bg-light">
                <div class="fw-semibold small mb-2">Nomes das colunas</div>
                <div class="row g-2">
                  <div class="col-6 col-md-3">
                    <label class="form-label form-label-sm mb-1">Coluna "Célula"</label>
                    <input class="form-control form-control-sm" name="col_celula_label"
                      value="<%= test.col_celula_label || '' %>" placeholder="Célula" />
                  </div>
                  <div class="col-6 col-md-3">
                    <label class="form-label form-label-sm mb-1">Coluna "Flutuação"</label>
                    <input class="form-control form-control-sm" name="col_flutuacao_label"
                      value="<%= test.col_flutuacao_label || '' %>" placeholder="Flutuação (V)" />
                  </div>
                  <% hourLabels.forEach(function(label, idx) { %>
                  <div class="col-6 col-md-3">
                    <label class="form-label form-label-sm mb-1">Coluna <%= idx + 1 %></label>
                    <input class="form-control form-control-sm" name="hour_label_<%= idx %>"
                      value="<%= label %>" placeholder="<%= label %>" />
                  </div>
                  <% }); %>
                </div>
              </div>
            </div>
            <% } %>

            <!-- Grade de leituras: os valores medidos, editáveis célula × checkpoint.
                 Vai num campo JSON único (readings_json) e não em inputs nomeados porque
                 express.urlencoded limita o corpo a 1000 parâmetros — um banco de 180
                 células × 6 checkpoints geraria 1260 campos e a requisição seria recusada. -->
            <% if (readings.length > 0) { %>
            <input type="hidden" name="readings_json" id="readingsJson_<%= test.id %>" value="" />
            <!-- Colunas marcadas para exclusão: {"flutuacao":bool,"horas":[índices]}. A
                 exclusão é aplicada no Salvar, junto com as edições de valor, para que
                 marcar uma coluna não descarte o que já foi digitado na grade. -->
            <input type="hidden" name="deleted_cols_json" id="deletedColsJson_<%= test.id %>" value="" />
            <div class="col-12">
              <div class="border rounded p-2 bg-light">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                  <div class="fw-semibold small">
                    Leituras medidas
                    <span class="text-muted fw-normal">(<%= readings.length %> células × <%= hourLabels.length %> checkpoints)</span>
                  </div>
                  <div class="text-muted" style="font-size:11px;">
                    Campo vazio = não medido (sai como &quot;-&quot; no relatório). Aceita valor negativo.
                    Use <strong>✕</strong> no cabeçalho para excluir a coluna inteira.
                  </div>
                  <% if (!hasFlutuacao) { %>
                  <button type="button" class="btn btn-outline-secondary btn-sm" style="font-size:11px;"
                    id="dischargeShowFlut_<%= test.id %>" onclick="showDischargeFlutuacao(<%= test.id %>)">
                    + Mostrar flutuação
                  </button>
                  <% } %>
                </div>
                <div id="dischargeDelWarn_<%= test.id %>" class="alert alert-warning py-1 px-2 mb-2 d-none" style="font-size:12px;">
                  <span id="dischargeDelWarnText_<%= test.id %>"></span>
                  <button type="button" class="btn btn-link btn-sm p-0 ms-2" style="font-size:12px;"
                    onclick="clearDischargeColDeletes(<%= test.id %>)">Desfazer</button>
                </div>

                <!-- Os mesmos cards do painel "Ver dados", agora dentro do editor: abrir o
                     editor esconde aquele painel, então sem esta cópia não haveria card
                     nenhum à vista enquanto se digita. Estes recalculam a cada tecla, a
                     partir dos inputs — por isso trazem o selo "prévia", para não confundir
                     o que está na tela com o que já foi gravado.
                     A coluna de flutuação sempre existe aqui (só recolhida quando vazia),
                     para o card aparecer assim que o primeiro valor for digitado. -->
                <div class="discharge-stats-cards discharge-stats-live" data-test-id="<%= test.id %>">
                  <div class="discharge-stat-card dsc-preview<%= hasFlutuacao ? '' : ' dcol-collapsed' %>" data-stat-kind="flutuacao">
                    <div class="dsc-period"><%= test.col_flutuacao_label || 'Flutuação (V)' %><span class="dsc-badge">prévia</span></div>
                    <div class="dsc-body">
                      <div class="dsc-line dsc-line-max"><span class="dsc-key">Máx</span><span class="dsc-val" data-stat="max">-</span></div>
                      <div class="dsc-line dsc-line-min"><span class="dsc-key">Mín</span><span class="dsc-val" data-stat="min">-</span></div>
                      <div class="dsc-line dsc-line-avg"><span class="dsc-key">Méd</span><span class="dsc-val" data-stat="avg">-</span></div>
                    </div>
                  </div>
                  <% hourLabels.forEach(function(h, hIdx) { %>
                  <div class="discharge-stat-card dsc-preview" data-stat-kind="hora" data-stat-idx="<%= hIdx %>">
                    <div class="dsc-period"><%= h %><span class="dsc-badge">prévia</span></div>
                    <div class="dsc-body">
                      <div class="dsc-line dsc-line-max"><span class="dsc-key">Máx</span><span class="dsc-val" data-stat="max">-</span></div>
                      <div class="dsc-line dsc-line-min"><span class="dsc-key">Mín</span><span class="dsc-val" data-stat="min">-</span></div>
                      <div class="dsc-line dsc-line-avg"><span class="dsc-key">Méd</span><span class="dsc-val" data-stat="avg">-</span></div>
                    </div>
                  </div>
                  <% }); %>
                </div>
                <div class="discharge-table-wrap" style="max-height:420px;overflow-y:auto;">
                  <table class="discharge-table discharge-edit-table" data-test-id="<%= test.id %>">
                    <thead>
                      <tr>
                        <th class="th-celula"><%= test.col_celula_label || 'Célula' %></th>
                        <!-- Coluna de flutuação: fica recolhida quando nenhuma célula tem o
                             valor (import só de descarga, ou a coluna foi excluída antes).
                             Continua no DOM, e o botão "Mostrar flutuação" a revela, para
                             que dê para preencher à mão o que não veio no CSV. -->
                        <th class="th-flutuacao<%= hasFlutuacao ? '' : ' dcol-collapsed' %>" data-col-kind="flutuacao">
                          <span class="dcol-label"><%= test.col_flutuacao_label || 'Flutuação (V)' %></span>
                          <button type="button" class="dcol-del" title="Excluir esta coluna"
                            onclick="toggleDischargeColDelete(<%= test.id %>, 'flutuacao', -1)">✕</button>
                        </th>
                        <% hourLabels.forEach(function(h, hIdx) { %>
                        <th class="th-hora" data-col-kind="hora" data-col-idx="<%= hIdx %>">
                          <span class="dcol-label"><%= h %></span>
                          <button type="button" class="dcol-del" title="Excluir esta coluna"
                            onclick="toggleDischargeColDelete(<%= test.id %>, 'hora', <%= hIdx %>)">✕</button>
                        </th>
                        <% }); %>
                      </tr>
                    </thead>
                    <tbody>
                      <% readings.forEach(function(row, rIdx) {
                        var horas = Array.isArray(row.horas) ? row.horas : [];
                      %>
                      <tr data-test-id="<%= test.id %>" data-row-idx="<%= rIdx %>">
                        <td class="td-celula"><%= row.celula %></td>
                        <td class="<%= hasFlutuacao ? '' : 'dcol-collapsed' %>" data-col-kind="flutuacao">
                          <!-- step="any": com um step fixo o browser recusa o submit inteiro
                               ("Please enter a valid value") se um valor gravado não cair na
                               grade do step — ex.: leitura com 4 decimais. -->
                          <input type="number" step="any" class="form-control form-control-sm d-flutuacao"
                            value="<%= row.flutuacao !== null && row.flutuacao !== undefined ? row.flutuacao : '' %>"
                            style="width:96px;" />
                        </td>
                        <% hourLabels.forEach(function(_h, hIdx) { %>
                        <td data-col-kind="hora" data-col-idx="<%= hIdx %>">
                          <input type="number" step="any" class="form-control form-control-sm d-hora" data-hora-idx="<%= hIdx %>"
                            value="<%= horas[hIdx] !== null && horas[hIdx] !== undefined ? horas[hIdx] : '' %>"
                            style="width:96px;" />
                        </td>
                        <% }); %>
                      </tr>
                      <% }); %>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
            <% } %>

            <div class="col-12 d-flex gap-2">
              <button class="btn btn-success btn-sm" type="submit">Salvar</button>
              <button class="btn btn-outline-secondary btn-sm" type="button" onclick="cancelDischargeEditor(<%= test.id %>)">Cancelar</button>
            </div>
          </form>
        </div>

      </div>
      <% }); %>

    </div>
  </div>

</section>

