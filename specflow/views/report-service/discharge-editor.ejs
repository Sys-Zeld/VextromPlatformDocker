  });

  function sendInstruction() {
    var instruction = (inputEl.value || "").trim();
    if (!instruction || sendBtn.disabled) return;
    setInputBusy(true);
    addBubble("user", instruction);
    inputEl.value = "";
    showTyping();
    previewHint.textContent = "Aplicando alterações...";
    callAi(instruction, false).then(function (r) {
      removeTyping();
      updatePreview(r.previewHtml);
      pendingStyle = r.styleConfig || null;
      setUnsaved(true);
      saveBtn.disabled = false;
      if (defaultBtn) defaultBtn.disabled = false;
      previewHint.textContent = "Preview atualizado — salve quando estiver satisfeito";
      addBubble("ai", "Feito! Verifique o preview ao lado. Você pode continuar ajustando ou salvar.");
    }).catch(function (err) {
      removeTyping();
      addBubble("err", "Erro: " + (err.message || "Falha na IA."));
      previewHint.textContent = "";
    }).finally(function () {
      setInputBusy(false);
      inputEl.focus();
    });
  }

  sendBtn.addEventListener("click", sendInstruction);
  inputEl.addEventListener("keydown", function (e) { if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); sendInstruction(); } });

  dcModal.querySelectorAll(".msm-chip").forEach(function (chip) {
    chip.addEventListener("click", function () { inputEl.value = chip.getAttribute("data-s") || ""; inputEl.focus(); });
  });

  saveBtn.addEventListener("click", function () {
    if (!pendingStyle) return;
    setInputBusy(true);
    saveBtn.disabled = true;
    callAi(null, true).then(function () {
      var btn = document.querySelector('.discharge-chart-style-btn[data-test-id="' + activeTestId + '"]');
      if (btn) {
        btn.setAttribute("data-has-chart-style", "1");
        var badge = btn.querySelector(".badge");
        if (badge) badge.remove();
        btn.insertAdjacentHTML("beforeend", ' <span class="badge text-bg-success" style="font-size:9px;">custom</span>');
      }
      setUnsaved(false);
      getDcModal().hide();
    }).catch(function (err) {
      addBubble("err", "Erro ao salvar: " + (err.message || "Tente novamente."));
      saveBtn.disabled = false;
    }).finally(function () { setInputBusy(false); });
  });

  if (defaultBtn) {
    defaultBtn.addEventListener("click", function () {
      if (!pendingStyle) return;
      setInputBusy(true);
      defaultBtn.disabled = true;
      callDefault().then(function (r) {
        updatePreview(r.previewHtml);
        pendingStyle = r.styleConfig || pendingStyle;
        setUnsaved(false);
        saveBtn.disabled = true;
        previewHint.textContent = "Estilo salvo como padrão para novos gráficos de descarga";
        addBubble("ai", "Visual salvo como padrão. Novos gráficos de descarga usarão este visual automaticamente.");
      }).catch(function (err) {
        addBubble("err", "Erro ao salvar padrão: " + (err.message || "Tente novamente."));
      }).finally(function () { setInputBusy(false); defaultBtn.disabled = !pendingStyle; });
    });
  }

  resetBtn.addEventListener("click", function () {
    if (!confirm("Restaurar o visual padrão deste gráfico?")) return;
    setInputBusy(true);
    callReset().then(function (r) {
      updatePreview(r.previewHtml);
      pendingStyle = r.styleConfig || null;
      chatArea.innerHTML = "";
      setUnsaved(false);
      saveBtn.disabled = true;
      if (defaultBtn) defaultBtn.disabled = !pendingStyle;
      previewHint.textContent = "Visual padrão restaurado";
      addBubble("ai", "Visual restaurado para o padrão. Envie novas instruções para personalizar novamente.");
      var btn = document.querySelector('.discharge-chart-style-btn[data-test-id="' + activeTestId + '"]');
      if (btn) { btn.setAttribute("data-has-chart-style", "0"); var badge = btn.querySelector(".badge"); if (badge) badge.remove(); }
    }).catch(function (err) {
      addBubble("err", "Erro ao restaurar: " + (err.message || "Tente novamente."));
    }).finally(function () { setInputBusy(false); });
  });
})();
</script>

<script>
(function () {
  // Import CSV
  var importBtn = document.getElementById("dischargeImportBtn");
  var fileInput = document.getElementById("dischargeFileInput");
  var fileNameEl = document.getElementById("dischargeFileName");
  var spinner = document.getElementById("dischargeImportSpinner");
  var msgEl = document.getElementById("dischargeImportMsg");
  var csrfToken = (document.querySelector('[name="_csrf"]') || {}).value || "<%= csrfToken %>";

  if (importBtn && fileInput) {
    importBtn.addEventListener("click", function () { fileInput.click(); });
    fileInput.addEventListener("change", function () {
      var file = fileInput.files && fileInput.files[0];
      if (!file) return;
      fileNameEl.textContent = file.name;
      spinner.classList.remove("d-none");
      msgEl.textContent = "";
      importBtn.disabled = true;

      var reader = new FileReader();
      reader.onload = function (e) {
        fetch("/admin/report-service/orders/<%= order.id %>/discharge/import", {
          method: "POST",
          headers: {
            "Content-Type": "application/octet-stream",
            "X-CSRF-Token": csrfToken
          },
          body: e.target.result
        }).then(function (resp) {
          if (resp.redirected) {
            window.location.href = resp.url;
          } else {
            return resp.text().then(function () {
              spinner.classList.add("d-none");
              importBtn.disabled = false;
              msgEl.textContent = "Erro inesperado.";
            });
          }
        }).catch(function () {
          spinner.classList.add("d-none");
          importBtn.disabled = false;
          msgEl.textContent = "Falha na requisição.";
        });
      };
      reader.readAsArrayBuffer(file);
    });
  }

  window.toggleDischargeData = function (id) {
    var dataEl   = document.getElementById("dischargeData_" + id);
    var editorEl = document.getElementById("dischargeEditor_" + id);
    var ch       = document.getElementById("dischargeEditorChevron_" + id);
    if (!dataEl) return;
    var opening = dataEl.classList.contains("d-none");
    if (opening) {
      // Fechar editor se estiver aberto
      if (editorEl) editorEl.classList.add("d-none");
      if (ch) ch.textContent = "✏️ Editar";
      dataEl.classList.remove("d-none");
    } else {
      dataEl.classList.add("d-none");
    }
  };

  window.toggleDischargeEditor = function (id) {
    var editorEl = document.getElementById("dischargeEditor_" + id);
    var dataEl   = document.getElementById("dischargeData_" + id);
    var ch       = document.getElementById("dischargeEditorChevron_" + id);
    if (!editorEl) return;
    var editorOpen = !editorEl.classList.contains("d-none");
    if (!editorOpen) {
      // Fechar dados se estiverem abertos
      if (dataEl) dataEl.classList.add("d-none");
      editorEl.classList.remove("d-none");
      if (ch) ch.textContent = "✖ Fechar editor";
    } else {
      editorEl.classList.add("d-none");
      if (ch) ch.textContent = "✏️ Editar";
    }
  };

  // Serializa a grade de leituras no campo JSON antes do submit. Manda apenas o índice da
  // linha e os valores — a identidade da célula e o nº de checkpoints são resolvidos no
  // servidor a partir do registro gravado, então esta função não precisa (nem pode) alterá-los.
  // Ligado ao evento submit do form (e não ao clique do botão) para cobrir também o submit
  // por Enter dentro de um campo, que não passa pelo botão e enviaria o JSON vazio.
  document.querySelectorAll("form[data-discharge-form]").forEach(function (form) {
    form.addEventListener("submit", function () {
      window.syncDischargeReadings(form.getAttribute("data-discharge-form"));
    });
  });

  // ── Cards de estatística ao vivo ────────────────────────────────────────────────────
  // Espelham, enquanto se digita, a MESMA conta do servidor (buildDischargeColumnStats):
  // ignoram vazio/não numérico em vez de tratá-los como zero, e mostram "-" na coluna sem
  // nenhum valor. Se estas duas regras divergirem do servidor, a prévia mentiria.
  function dStatsOf(values) {
    var nums = [];
    values.forEach(function (raw) {
      if (raw === null || raw === undefined || String(raw).trim() === "") return;
      var n = parseFloat(String(raw).replace(",", "."));
      if (isFinite(n)) nums.push(n);
    });
    if (!nums.length) return { max: null, min: null, avg: null };
    var sum = 0, max = nums[0], min = nums[0];
    nums.forEach(function (n) { sum += n; if (n > max) max = n; if (n < min) min = n; });
    return { max: max, min: min, avg: sum / nums.length };
  }

  // Espelha formatDischargeValue do servidor: sempre 3 casas e vírgula (x,xxx). Roda no
  // browser, então é a única cópia da função — coberta pelo teste de equivalência.
  function dFmtStat(v) {
    if (v === null || v === undefined || v === "") return "-";
    var n = Number(v);
    if (!isFinite(n)) return "-";
    return n.toFixed(3).replace(".", ",");
  }

  // Recalcula UMA coluna (a que foi editada). Varrer a grade inteira a cada tecla custaria
  // ~1260 leituras de DOM num banco de 180 células; por coluna são ~180.
  function refreshDischargeStatCard(id, kind, idx) {
    var table = document.querySelector(".discharge-edit-table[data-test-id='" + id + "']");
    var wrap = document.querySelector(".discharge-stats-live[data-test-id='" + id + "']");
    if (!table || !wrap) return;

    var selector = kind === "flutuacao" ? ".d-flutuacao" : ".d-hora[data-hora-idx='" + idx + "']";
    var values = [];
    table.querySelectorAll("tbody " + selector).forEach(function (el) { values.push(el.value); });
    var st = dStatsOf(values);

    var cardSel = kind === "flutuacao"
      ? ".discharge-stat-card[data-stat-kind='flutuacao']"
      : ".discharge-stat-card[data-stat-kind='hora'][data-stat-idx='" + idx + "']";
    var card = wrap.querySelector(cardSel);
    if (!card) return;
    ["max", "min", "avg"].forEach(function (k) {
      var el = card.querySelector(".dsc-val[data-stat='" + k + "']");
      if (el) el.textContent = dFmtStat(st[k]);
    });
    // A coluna de flutuação some quando fica vazia e reaparece ao receber o primeiro valor,
    // acompanhando a regra do relatório (coluna só existe quando alguma célula tem o valor).
    if (kind === "flutuacao") card.classList.toggle("dcol-collapsed", st.max === null);
  }

  function refreshAllDischargeStatCards(id) {
    var table = document.querySelector(".discharge-edit-table[data-test-id='" + id + "']");
    if (!table) return;
    refreshDischargeStatCard(id, "flutuacao", -1);
    var seen = {};
    table.querySelectorAll("tbody .d-hora").forEach(function (el) {
      var h = el.getAttribute("data-hora-idx");
      if (seen[h]) return;
      seen[h] = true;
      refreshDischargeStatCard(id, "hora", Number(h));
    });
  }

  // Um único listener delegado por grade, em vez de um por input (seriam 1260).
  document.querySelectorAll(".discharge-edit-table[data-test-id]").forEach(function (table) {
    var id = table.getAttribute("data-test-id");
    table.addEventListener("input", function (ev) {
      var el = ev.target;
      if (!el || !el.classList) return;
      if (el.classList.contains("d-flutuacao")) refreshDischargeStatCard(id, "flutuacao", -1);
      else if (el.classList.contains("d-hora")) refreshDischargeStatCard(id, "hora", Number(el.getAttribute("data-hora-idx")));
    });
    refreshAllDischargeStatCards(id); // estado inicial, a partir dos valores gravados
  });

  // Colunas marcadas para exclusão, por teste: { <testId>: { flutuacao: bool, horas: Set } }.
  var dDoomed = {};

  function dDoomedFor(id) {
    if (!dDoomed[id]) dDoomed[id] = { flutuacao: false, horas: {} };
    return dDoomed[id];
  }

  // Marca/desmarca uma coluna. Nada é excluído aqui — só no Salvar, junto com as edições
  // de valor, para que marcar uma coluna não descarte o que já foi digitado na grade.
  window.toggleDischargeColDelete = function (id, kind, idx) {
    var state = dDoomedFor(id);
    if (kind === "flutuacao") state.flutuacao = !state.flutuacao;
    else if (state.horas[idx]) delete state.horas[idx];
    else state.horas[idx] = true;
    renderDischargeColDeletes(id);
  };

  // Revela a coluna de flutuação recolhida, para preencher à mão valores que não vieram no
  // CSV. Se ficar toda vazia, o próximo carregamento a recolhe de novo — nada a persistir.
  window.showDischargeFlutuacao = function (id) {
    var table = document.querySelector(".discharge-edit-table[data-test-id='" + id + "']");
    if (table) {
      table.querySelectorAll("[data-col-kind='flutuacao']").forEach(function (cell) {
        cell.classList.remove("dcol-collapsed");
      });
    }
    var btn = document.getElementById("dischargeShowFlut_" + id);
    if (btn) btn.classList.add("d-none");
  };

  window.clearDischargeColDeletes = function (id) {
    dDoomed[id] = { flutuacao: false, horas: {} };
    renderDischargeColDeletes(id);
  };

  function renderDischargeColDeletes(id) {
    var state = dDoomedFor(id);
    var table = document.querySelector(".discharge-edit-table[data-test-id='" + id + "']");
    if (!table) return;

    var names = [];
    table.querySelectorAll("th[data-col-kind], td[data-col-kind]").forEach(function (cell) {
      var kind = cell.getAttribute("data-col-kind");
      var doomed = kind === "flutuacao"
        ? state.flutuacao
        : Boolean(state.horas[Number(cell.getAttribute("data-col-idx"))]);
      cell.classList.toggle("dcol-doomed", doomed);
      var input = cell.querySelector("input");
      if (input) input.disabled = doomed;
      if (doomed && cell.tagName === "TH") {
        var label = cell.querySelector(".dcol-label");
        names.push(label ? label.textContent.trim() : kind);
      }
    });

    // O card da coluna marcada também fica riscado: a prévia tem de mostrar o que será
    // o resultado do Salvar, e uma coluna prestes a sumir não deve parecer intacta.
    var wrap = document.querySelector(".discharge-stats-live[data-test-id='" + id + "']");
    if (wrap) {
      wrap.querySelectorAll(".discharge-stat-card[data-stat-kind]").forEach(function (card) {
        var doomed = card.getAttribute("data-stat-kind") === "flutuacao"
          ? state.flutuacao
          : Boolean(state.horas[Number(card.getAttribute("data-stat-idx"))]);
        card.classList.toggle("dsc-doomed", doomed);
      });
    }

    var warn = document.getElementById("dischargeDelWarn_" + id);
    var text = document.getElementById("dischargeDelWarnText_" + id);
    if (warn && text) {
      if (names.length) {
        text.innerHTML = "Ao salvar, " + (names.length === 1 ? "a coluna" : "as " + names.length + " colunas")
          + " <strong>" + names.join("</strong>, <strong>") + "</strong> "
          + (names.length === 1 ? "será excluída" : "serão excluídas")
          + " com todos os seus valores. Só a reimportação do CSV recupera.";
        warn.classList.remove("d-none");
      } else {
        warn.classList.add("d-none");
      }
    }
  }

  window.syncDischargeReadings = function (id) {
    var state = dDoomedFor(id);
    var delInput = document.getElementById("deletedColsJson_" + id);
    if (delInput) {
      delInput.value = JSON.stringify({
        flutuacao: state.flutuacao,
        horas: Object.keys(state.horas).map(Number)
      });
    }

    var input = document.getElementById("readingsJson_" + id);
    if (!input) return;
    var rows = [];
    document.querySelectorAll(".discharge-edit-table[data-test-id='" + id + "'] tbody tr[data-row-idx]").forEach(function (tr) {
      var fEl = tr.querySelector(".d-flutuacao");
      var horas = [];
      tr.querySelectorAll(".d-hora").forEach(function (el) { horas.push(el.value); });
      rows.push({
        idx: Number(tr.getAttribute("data-row-idx")),
        flutuacao: fEl ? fEl.value : "",
        horas: horas
      });
    });
    input.value = JSON.stringify(rows);
  };

  window.cancelDischargeEditor = function (id) {
    var editorEl = document.getElementById("dischargeEditor_" + id);
    var ch       = document.getElementById("dischargeEditorChevron_" + id);
    if (editorEl) editorEl.classList.add("d-none");
    if (ch) ch.textContent = "✏️ Editar";
  };
})();
</script>

<script>
(function () {
  if (typeof Chart === "undefined") return;
  var modal = document.getElementById("dischargeChartModal");
  if (!modal) return;

  var bsModal = null;
  function getModal() { if (!bsModal) bsModal = new bootstrap.Modal(modal); return bsModal; }

  var chartInstance = null;
  var currentData   = null;
  var canvas        = document.getElementById("dischargeChartCanvas");
  var titleEl       = document.getElementById("dChartTitle");
  var statsEl       = document.getElementById("dChartStats");
  var footnoteEl    = document.getElementById("dChartFootnote");
  var cellListEl    = document.getElementById("dChartCellList");

  function esc(str) {
    return String(str || "").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;");
  }

  function statCard(label, mainText, unit, color) {
    return '<div class="dch-stat-card">'
      + '<div class="dch-stat-label">' + label + '</div>'
      + '<div class="dch-stat-value" style="color:' + (color || "#1e293b") + ';">'
      + mainText
      + (unit ? '<span class="dch-stat-unit">' + unit + "</span>" : "")
      + "</div></div>";
  }

  function updateStats(values, isTotal, seriesLabel, nominal) {
    var valid   = values.filter(function(v) { return v !== null && !isNaN(v); });
    if (!valid.length) return;
    var initial  = values[0];
    var finalVal = values[values.length - 1];
    var dropV    = initial - finalVal;
    var dropPct  = initial > 0 ? (dropV / initial * 100) : 0;
    var signV    = dropV >= 0 ? "−" : "+";
    var dropColor = dropV > 0.001 ? "#dc2626" : (dropV < -0.001 ? "#16a34a" : "#1e293b");
    var decimals  = isTotal ? 2 : 3;

    statsEl.innerHTML =
      statCard("Tensão inicial", initial.toFixed(decimals), "V", "#4a7a30") +
      statCard("Tensão final",   finalVal.toFixed(decimals), "V", dropV > 0.001 ? "#b45309" : "#4a7a30") +
      statCard("Queda total", signV + Math.abs(dropV).toFixed(decimals) + " V", "(" + Math.abs(dropPct).toFixed(1) + "%)", dropColor) +
      (isTotal ? statCard("Pontos", values.length, "", "#1e293b") : statCard("Célula", esc(seriesLabel), "", "#4a7a30")) +
      (isTotal && nominal !== null && !isNaN(nominal) ? statCard("V nominal", nominal.toFixed(0), "V", "#4a7a30") : "");
  }

  function plotChart(labels, values, seriesLabel, isTotal) {
    if (chartInstance) { chartInstance.destroy(); chartInstance = null; }

    var valid  = values.filter(function(v) { return v !== null && !isNaN(v); });
    if (!valid.length) return;

    var seriesInit = values[0];
    var minVal = Math.min.apply(null, valid);
    var maxVal = Math.max.apply(null, valid);
    var range  = maxVal - minVal;
    var yPad   = range > 0 ? range * 0.18 : (maxVal * 0.05 || 1);
    var decimals = isTotal ? 2 : 3;

    var lineColor  = isTotal ? "#4a7a30" : "#6aaa42";
    var hoverColor = isTotal ? "#5d8f3d" : "#4a7a30";

    var ctx = canvas.getContext("2d");
    var gradient = ctx.createLinearGradient(0, 0, 0, 300);
    gradient.addColorStop(0,   isTotal ? "rgba(74,122,48,0.30)"  : "rgba(106,170,66,0.24)");
    gradient.addColorStop(0.5, isTotal ? "rgba(93,143,61,0.10)"  : "rgba(106,170,66,0.08)");
    gradient.addColorStop(1,   "rgba(0,0,0,0)");

    chartInstance = new Chart(ctx, {
      type: "line",
      data: {
        labels: labels,
        datasets: [{
          label: seriesLabel,
          data: values,
          borderColor: lineColor,
          borderWidth: 2.5,
          pointBackgroundColor: lineColor,
          pointBorderColor: "#ffffff",
          pointBorderWidth: 2,
          pointRadius: 5,
          pointHoverRadius: 8,
          pointHoverBackgroundColor: hoverColor,
          pointHoverBorderColor: "#ffffff",
          fill: true,
          backgroundColor: gradient,
          tension: 0.35,
          spanGaps: true
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: true,
        aspectRatio: 2.3,
        interaction: { mode: "index", intersect: false },
        animation: { duration: 380, easing: "easeOutQuart" },
        plugins: {
          legend: { display: false },
          tooltip: {
            backgroundColor: "#1a2e0a",
            titleColor: "#87b86a",
            bodyColor: "#d4e6c3",
            borderColor: "#4a7a30",
            borderWidth: 1,
            padding: 12,
            cornerRadius: 9,
            displayColors: false,
            callbacks: {
              title: function(items) { return items[0].label; },
              label: function(item) {
                var val = item.parsed.y;
                if (val === null || val === undefined) return ["  —"];
                var dV   = seriesInit - val;
                var dPct = seriesInit > 0 ? (dV / seriesInit * 100) : 0;
                var sg   = dV >= 0 ? "−" : "+";
                return [
                  "  " + esc(seriesLabel) + ": " + val.toFixed(decimals) + " V",
                  "  Queda: " + sg + Math.abs(dV).toFixed(decimals) + " V  (" + Math.abs(dPct).toFixed(1) + "%)"
                ];
              }
            }
          }
        },
        scales: {
          x: {
            grid: { color: "#eef2f7" },
            border: { color: "#e2e8f0" },
            ticks: { font: { size: 11 }, color: "#64748b", maxRotation: 40 }
          },
          y: {
            min: Math.max(0, parseFloat((minVal - yPad).toFixed(3))),
            max: parseFloat((maxVal + yPad).toFixed(3)),
            grid: { color: "#eef2f7" },
            border: { color: "#e2e8f0" },
            ticks: {
              font: { size: 11 },
              color: "#64748b",
              callback: function(v) { return v.toFixed(decimals) + " V"; }
            },
            title: {
              display: true,
              text: (isTotal ? "Tensão Total" : esc(seriesLabel)) + " (V)",
              font: { size: 11 },
              color: "#94a3b8"
            }
          }
        }
      }
    });
  }

  function buildCellList(cells) {
    var html = '<div class="dch-cell-header">SÉRIES</div>';
    html += '<div class="dch-cell-item dch-cell-total dch-selected" data-idx="-1">&#8721; Tensão Total</div>';
    cells.forEach(function(cell, idx) {
      html += '<div class="dch-cell-item" data-idx="' + idx + '">' + esc(cell.name) + '</div>';
    });
    cellListEl.innerHTML = html;

    cellListEl.querySelectorAll(".dch-cell-item").forEach(function(item) {
      item.addEventListener("click", function() {
        cellListEl.querySelectorAll(".dch-cell-item").forEach(function(i) { i.classList.remove("dch-selected"); });
        item.classList.add("dch-selected");

        var idx = parseInt(item.getAttribute("data-idx"), 10);
        if (idx === -1) {
          updateStats(currentData.values, true, "Tensão Total", currentData.nominal);
          plotChart(currentData.labels, currentData.values, "Tensão Total", true);
          footnoteEl.innerHTML = "Cada ponto &eacute; o <strong>somatório de todas as células</strong> naquele instante. Selecione uma célula na lista para ver sua curva individual.";
        } else {
          var cell = currentData.cells[idx];
          updateStats(cell.values, false, cell.name, null);
          plotChart(currentData.labels, cell.values, cell.name, false);
          footnoteEl.innerHTML = "Curva individual da <strong>c&eacute;lula " + esc(cell.name) + "</strong>. Eixo Y em escala de célula única.";
        }
      });
    });
  }

  window.openDischargeChart = function(testId) {
    var el = document.getElementById("dischargeChartData_" + testId);
    if (!el) return;
    try { currentData = JSON.parse(el.textContent || "{}"); } catch(e) { return; }

    currentData.nominal = currentData.nominal != null ? parseFloat(currentData.nominal) : null;
    if (!Array.isArray(currentData.values) || !currentData.values.length) return;

    titleEl.textContent = currentData.title || "Teste de Descarga";

    buildCellList(Array.isArray(currentData.cells) ? currentData.cells : []);
    updateStats(currentData.values, true, "Tensão Total", currentData.nominal);
    plotChart(currentData.labels, currentData.values, "Tensão Total", true);

    footnoteEl.innerHTML = "Cada ponto &eacute; o <strong>somatório de todas as c&eacute;lulas</strong> naquele instante. Selecione uma c&eacute;lula na lista para ver sua curva individual.";

    getModal().show();
  };

  modal.addEventListener("hidden.bs.modal", function() {
    if (chartInstance) { chartInstance.destroy(); chartInstance = null; }
    currentData = null;
  });
})();
</script>

