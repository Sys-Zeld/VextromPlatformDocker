<%- include("partials/head", { pageTitle }) %>

<div class="card app-card mb-4">
  <div class="card-body d-flex justify-content-between align-items-center gap-2 flex-wrap">
    <div>
      <h1 class="h4 app-card-title mb-1"><%= t("admin.mspec.pageTitle") %></h1>
      <p class="text-muted mb-0"><%= t("admin.mspec.pageSubtitle") %></p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
      <a class="btn btn-outline-secondary btn-sm" href="/admin/maintenance/system"><%= t("admin.sys.pageTitle") %></a>
      <a class="btn btn-outline-secondary btn-sm" href="/admin/hub"><%= t("admin.sys.backToHub") %></a>
    </div>
  </div>
</div>

<% if (commandResult) { %>
  <div class="alert <%= commandResult.ok ? 'alert-success' : 'alert-danger' %>">
    <div><strong><%= t("admin.maint.commandLabel") %>:</strong> <code><%= commandResult.label %></code></div>
    <div><strong><%= t("admin.maint.exitCodeLabel") %>:</strong> <%= commandResult.code %></div>
  </div>
  <div class="card app-card mb-4">
    <div class="card-body">
      <h2 class="h6 app-card-title"><%= t("admin.sys.outputTitle") %></h2>
      <pre class="mb-0" style="white-space: pre-wrap;"><%= commandResult.output || t("admin.maint.noOutput") %></pre>
    </div>
  </div>
<% } %>

<div class="card app-card">
  <div class="card-body">
    <h2 class="h6 app-card-title mb-3"><%= t("admin.mspec.dbCommandsTitle") %></h2>
    <div class="d-flex gap-2 flex-wrap">
      <form method="post" action="/admin/maintenance/module-spec/command" class="maintenance-command-form" data-confirm="<%= t('admin.mspec.dbBackupConfirm') %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <input type="hidden" name="action" value="db_backup" />
        <button class="btn btn-outline-primary btn-sm" type="submit"><%= t("admin.mspec.dbBackupButton") %></button>
      </form>
      <form method="post" action="/admin/maintenance/module-spec/command" class="maintenance-command-form" data-confirm="<%= t('admin.mspec.dbResetConfirm') %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <input type="hidden" name="action" value="db_reset" />
        <button class="btn btn-outline-danger btn-sm" type="submit"><%= t("admin.mspec.dbResetButton") %></button>
      </form>
    </div>
  </div>
</div>

<script>
  (function () {
    var defaultConfirm = <%- JSON.stringify(t("admin.sys.confirmExecuteCommand")) %>;
    var forms = document.querySelectorAll(".maintenance-command-form");
    forms.forEach(function (form) {
      form.addEventListener("submit", function (event) {
        var message = form.getAttribute("data-confirm") || defaultConfirm;
        if (!window.confirm(message)) {
          event.preventDefault();
        }
      });
    });
  })();
</script>

<%- include("partials/footer") %>
