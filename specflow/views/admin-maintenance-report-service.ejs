<%- include("partials/head", { pageTitle }) %>

<div class="card app-card mb-4">
  <div class="card-body d-flex justify-content-between align-items-center gap-2 flex-wrap">
    <div>
      <h1 class="h4 app-card-title mb-1"><%= t("admin.rs.pageTitle") %></h1>
      <p class="text-muted mb-0"><%= t("admin.rs.pageSubtitle") %></p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
      <a class="btn btn-outline-secondary btn-sm" href="/admin/maintenance/system"><%= t("admin.sys.pageTitle") %></a>
      <a class="btn btn-outline-secondary btn-sm" href="/admin/hub"><%= t("admin.sys.backToHub") %></a>
    </div>
  </div>
</div>

<% if (commandResult) { %>
  <div class="alert <%= commandResult.ok ? 'alert-success' : 'alert-danger' %>">
    <div><strong><%= t("admin.maint.commandLabel") %>:</strong> <code><%= commandResult.label %></code></div>
    <div><strong><%= t("admin.maint.exitCodeLabel") %>:</strong> <%= commandResult.code %></div>
  </div>
  <div class="card app-card mb-4">
    <div class="card-body">
      <h2 class="h6 app-card-title"><%= t("admin.sys.outputTitle") %></h2>
      <pre class="mb-0" style="white-space: pre-wrap;"><%= commandResult.output || t("admin.maint.noOutput") %></pre>
    </div>
  </div>
<% } %>

<% if (smtpUpdateResult) { %>
  <div class="alert <%= smtpUpdateResult.ok ? 'alert-success' : 'alert-danger' %>"><%= smtpUpdateResult.message %></div>
<% } %>
<% if (emailTemplatesUpdateResult) { %>
  <div class="alert <%= emailTemplatesUpdateResult.ok ? 'alert-success' : 'alert-danger' %>"><%= emailTemplatesUpdateResult.message %></div>
<% } %>
<% if (defaultRecipientsUpdateResult) { %>
  <div class="alert <%= defaultRecipientsUpdateResult.ok ? 'alert-success' : 'alert-danger' %>"><%= defaultRecipientsUpdateResult.message %></div>
<% } %>

<div class="card app-card mb-4">
  <div class="card-body">
    <h2 class="h6 app-card-title mb-3"><%= t("admin.rs.dbCommandsTitle") %></h2>
    <div class="d-flex gap-2 flex-wrap">
      <form method="post" action="/admin/maintenance/report-service/command" class="maintenance-command-form" data-confirm="<%= t('admin.rs.dbBackupConfirm') %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <input type="hidden" name="action" value="db_backup" />
        <button class="btn btn-outline-primary btn-sm" type="submit"><%= t("admin.rs.dbBackupButton") %></button>
      </form>
      <form method="post" action="/admin/maintenance/report-service/command" class="maintenance-command-form" data-confirm="<%= t('admin.rs.dbResetConfirm') %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <input type="hidden" name="action" value="db_reset" />
        <button class="btn btn-outline-danger btn-sm" type="submit"><%= t("admin.rs.dbResetButton") %></button>
      </form>
    </div>
  </div>
</div>

<div class="card app-card mb-4">
  <div class="card-body">
    <h2 class="h6 app-card-title mb-2"><%= t("admin.rs.defaultRecipientsTitle") %></h2>
    <p class="text-muted mb-3"><%= t("admin.rs.defaultRecipientsSubtitle") %></p>
    <form method="post" action="/admin/maintenance/report-service/default-recipients" class="row g-3">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <div class="col-12">
        <label class="form-label" for="default_email_recipients"><%= t("admin.maint.defaultRecipientsLabel") %></label>
        <textarea
          id="default_email_recipients"
          name="default_email_recipients"
          class="form-control"
          rows="4"
          maxlength="4000"
          placeholder="relatorios@empresa.com; engenharia@empresa.com"
        ><%= emailSettings && emailSettings.defaultRecipientsRaw ? emailSettings.defaultRecipientsRaw : "" %></textarea>
      </div>
      <div class="col-12">
        <button class="btn btn-primary btn-sm" type="submit"><%= t("admin.rs.saveRecipientsButton") %></button>
      </div>
    </form>
  </div>
</div>

<div class="card app-card mb-4">
  <div class="card-body">
    <h2 class="h6 app-card-title mb-2"><%= t("admin.rs.smtpTitle") %></h2>
    <p class="text-muted mb-3"><%= t("admin.rs.smtpSubtitle") %></p>
    <form method="post" action="/admin/maintenance/report-service/smtp" class="row g-3">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

      <div class="col-12 col-md-6">
        <label class="form-label" for="smtp_host">SMTP Host</label>
        <input id="smtp_host" name="smtp_host" type="text" class="form-control" required value="<%= emailSettings && emailSettings.smtp ? emailSettings.smtp.host : '' %>" />
      </div>
      <div class="col-12 col-md-3">
        <label class="form-label" for="smtp_port">SMTP Port</label>
        <input id="smtp_port" name="smtp_port" type="number" class="form-control" min="1" max="65535" required value="<%= emailSettings && emailSettings.smtp ? emailSettings.smtp.port : 587 %>" />
      </div>
      <div class="col-12 col-md-3 d-flex align-items-end">
        <div class="form-check mb-2">
          <input id="smtp_secure" name="smtp_secure" type="checkbox" class="form-check-input" value="true" <%= emailSettings && emailSettings.smtp && emailSettings.smtp.secure ? "checked" : "" %> />
          <label class="form-check-label" for="smtp_secure"><%= t("admin.rs.smtpSslLabel") %></label>
        </div>
      </div>

      <div class="col-12 col-md-6">
        <label class="form-label" for="smtp_user">SMTP User</label>
        <input id="smtp_user" name="smtp_user" type="text" class="form-control" value="<%= emailSettings && emailSettings.smtp ? emailSettings.smtp.user : '' %>" />
      </div>
      <div class="col-12 col-md-6">
        <label class="form-label" for="smtp_from">SMTP From</label>
        <input id="smtp_from" name="smtp_from" type="email" class="form-control" required value="<%= emailSettings && emailSettings.smtp ? emailSettings.smtp.from : '' %>" />
      </div>

      <div class="col-12 col-md-6">
        <label class="form-label" for="smtp_pass">SMTP Password</label>
        <input id="smtp_pass" name="smtp_pass" type="password" class="form-control" autocomplete="new-password" placeholder="<%= t('admin.maint.smtpPassPlaceholder') %>" />
        <small class="text-muted"><%= t("admin.rs.smtpPassCurrentLabel", { status: emailSettings && emailSettings.hasEffectiveSmtpPass ? t("admin.maint.smtpPassConfigured") : t("admin.maint.smtpPassNotConfigured") }) %></small>
      </div>
      <div class="col-12 col-md-6 d-flex align-items-end">
        <div class="form-check mb-2">
          <input id="smtp_pass_clear" name="smtp_pass_clear" type="checkbox" class="form-check-input" value="true" />
          <label class="form-check-label" for="smtp_pass_clear"><%= t("admin.maint.smtpPassClearLabel") %></label>
        </div>
      </div>

      <div class="col-12">
        <button class="btn btn-primary btn-sm" type="submit"><%= t("admin.maint.saveSmtpButton") %></button>
      </div>
    </form>
  </div>
</div>

<div class="card app-card mb-4">
  <div class="card-body">
    <h2 class="h6 app-card-title mb-2"><%= t("admin.rs.emailTemplatesTitle") %></h2>
    <p class="text-muted mb-3"><%= t("admin.rs.emailTemplatesSubtitle") %></p>
    <form method="post" action="/admin/maintenance/report-service/email-templates/save" class="row g-3" id="email-template-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <input type="hidden" id="template_id" name="template_id" value="<%= emailTemplateEditorValues && emailTemplateEditorValues.template_id ? emailTemplateEditorValues.template_id : '' %>" />
      <div class="col-12 col-md-4">
        <label class="form-label" for="template_name"><%= t("admin.maint.emailTemplateNameLabel") %></label>
        <input
          id="template_name"
          name="template_name"
          type="text"
          class="form-control"
          required
          maxlength="120"
          value="<%= emailTemplateEditorValues && emailTemplateEditorValues.template_name ? emailTemplateEditorValues.template_name : '' %>"
        />
      </div>
      <div class="col-12 col-md-3">
        <label class="form-label" for="template_purpose"><%= t("admin.rs.purposeLabel") %></label>
        <select id="template_purpose" name="template_purpose" class="form-select">
          <option value="general" <%= (!emailTemplateEditorValues || !emailTemplateEditorValues.template_purpose || emailTemplateEditorValues.template_purpose === 'general') ? 'selected' : '' %>><%= t("admin.rs.purposeGeneral") %></option>
          <option value="nova_os" <%= (emailTemplateEditorValues && emailTemplateEditorValues.template_purpose === 'nova_os') ? 'selected' : '' %>><%= t("admin.rs.purposeNovaOs") %></option>
          <option value="relatorio_assinado" <%= (emailTemplateEditorValues && emailTemplateEditorValues.template_purpose === 'relatorio_assinado') ? 'selected' : '' %>><%= t("admin.rs.purposeRelatorioAssinado") %></option>
          <option value="envio_assinatura" <%= (emailTemplateEditorValues && emailTemplateEditorValues.template_purpose === 'envio_assinatura') ? 'selected' : '' %>><%= t("admin.rs.purposeEnvioAssinatura") %></option>
          <option value="notificacao_envio_assinatura" <%= (emailTemplateEditorValues && emailTemplateEditorValues.template_purpose === 'notificacao_envio_assinatura') ? 'selected' : '' %>><%= t("admin.rs.purposeNotificacaoEnvioAssinatura") %></option>
        </select>
      </div>
      <div class="col-12 col-md-5">
        <label class="form-label" for="template_subject"><%= t("admin.maint.emailTemplateSubjectLabel") %></label>
        <input
          id="template_subject"
          name="template_subject"
          type="text"
          class="form-control"
          required
          maxlength="200"
          value="<%= emailTemplateEditorValues && emailTemplateEditorValues.template_subject ? emailTemplateEditorValues.template_subject : '' %>"
        />
      </div>
      <div class="col-12 col-md-8">
        <label class="form-label" for="template_html"><%= t("admin.maint.emailTemplateHtmlLabel") %></label>
        <textarea
          id="template_html"
          name="template_html"
          class="form-control"
          rows="12"
          required
          maxlength="120000"
        ><%= emailTemplateEditorValues && emailTemplateEditorValues.template_html ? emailTemplateEditorValues.template_html : "" %></textarea>
      </div>
      <div class="col-12 col-md-4">
        <label class="form-label" for="template_html_file"><%= t("admin.maint.emailTemplateFileLabel") %></label>
        <input id="template_html_file" type="file" class="form-control mb-3" accept=".html,text/html" />
        <div class="form-check mb-3">
          <input
            id="set_default_template"
            name="set_default_template"
            type="checkbox"
            value="true"
            class="form-check-input"
            <%= emailTemplateEditorValues && emailTemplateEditorValues.set_default_template ? "checked" : "" %>
          />
          <label class="form-check-label" for="set_default_template"><%= t("admin.maint.setDefaultTemplateLabel") %></label>
        </div>
        <div class="d-flex gap-2 flex-wrap">
          <button class="btn btn-primary btn-sm" type="submit"><%= t("admin.maint.saveEmailTemplateButton") %></button>
          <button class="btn btn-outline-secondary btn-sm" id="email-template-reset" type="button"><%= t("admin.maint.newEmailTemplateButton") %></button>
        </div>
      </div>
    </form>

    <hr class="my-4" />

    <h3 class="h6 app-card-title mb-2"><%= t("admin.rs.emailTemplatesListTitle") %></h3>
    <div class="table-responsive">
      <table class="table table-sm align-middle mb-0 app-table">
        <thead>
          <tr>
            <th><%= t("admin.maint.colEmailTemplateName") %></th>
            <th><%= t("admin.rs.colPurpose") %></th>
            <th><%= t("admin.maint.colEmailTemplateSubject") %></th>
            <th><%= t("admin.maint.colUpdatedAt") %></th>
            <th><%= t("admin.maint.colActions") %></th>
          </tr>
        </thead>
        <tbody>
          <% if (!emailSettings || !emailSettings.emailTemplates || !emailSettings.emailTemplates.length) { %>
            <tr>
              <td colspan="5" class="text-muted"><%= t("admin.maint.noEmailTemplates") %></td>
            </tr>
          <% } %>
          <% (emailSettings && emailSettings.emailTemplates ? emailSettings.emailTemplates : []).forEach((template) => { %>
            <tr>
              <td>
                <strong><%= template.name %></strong>
                <% if (emailSettings.defaultTemplateId === template.id) { %>
                  <span class="badge text-bg-success ms-1"><%= t("admin.maint.defaultBadge") %></span>
                <% } %>
              </td>
              <td>
                <%
                  var purposeKeyMap = {
                    nova_os: "admin.rs.purposeNovaOsShort",
                    relatorio_assinado: "admin.rs.purposeRelatorioAssinadoShort",
                    envio_assinatura: "admin.rs.purposeEnvioAssinaturaShort",
                    notificacao_envio_assinatura: "admin.rs.purposeNotificacaoEnvioAssinaturaShort"
                  };
                  var purposeKey = purposeKeyMap[template.purpose] || "admin.rs.purposeGeneral";
                  var purposeBadgeClass = template.purpose === 'nova_os' ? 'text-bg-primary' : template.purpose === 'relatorio_assinado' ? 'text-bg-info text-dark' : template.purpose === 'envio_assinatura' ? 'text-bg-warning text-dark' : template.purpose === 'notificacao_envio_assinatura' ? 'text-bg-dark' : 'text-bg-secondary';
                %>
                <span class="badge <%= purposeBadgeClass %>"><%= t(purposeKey) %></span>
              </td>
              <td><code><%= template.subject %></code></td>
              <td><%= template.updatedAt ? new Date(template.updatedAt).toLocaleString(lang === "pt" ? "pt-BR" : "en-US") : "-" %></td>
              <td>
                <div class="d-flex gap-2 flex-wrap">
                  <button
                    class="btn btn-outline-primary btn-sm email-template-edit-btn"
                    type="button"
                    data-template-id="<%= template.id %>"
                    data-template-name="<%= template.name %>"
                    data-template-subject="<%= template.subject %>"
                    data-template-purpose="<%= template.purpose || 'general' %>"
                    data-template-default="<%= emailSettings.defaultTemplateId === template.id ? '1' : '0' %>"
                  >
                    <%= t("admin.maint.editEmailTemplateButton") %>
                  </button>
                  <form method="post" action="/admin/maintenance/report-service/email-templates/default" class="maintenance-command-form" data-confirm="<%= t('admin.maint.confirmSetDefaultEmail') %>">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <input type="hidden" name="template_id" value="<%= template.id %>" />
                    <button class="btn btn-outline-success btn-sm" type="submit" <%= emailSettings.defaultTemplateId === template.id ? "disabled" : "" %>><%= t("admin.maint.setDefaultEmailButton") %></button>
                  </form>
                  <form method="post" action="/admin/maintenance/report-service/email-templates/<%= template.id %>/delete" class="maintenance-command-form" data-confirm="<%= t('admin.maint.confirmDeleteEmail') %>">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <button class="btn btn-outline-danger btn-sm" type="submit"><%= t("admin.maint.deleteButton") %></button>
                  </form>
                </div>
                <textarea id="email-template-html-<%= template.id %>" class="d-none"><%= template.html %></textarea>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  (function () {
    var defaultConfirm = <%- JSON.stringify(t("admin.sys.confirmExecuteCommand")) %>;
    var selectHtmlFile = <%- JSON.stringify(t("admin.maint.selectHtmlFile")) %>;
    var htmlReadError = <%- JSON.stringify(t("admin.maint.htmlReadError")) %>;

    var forms = document.querySelectorAll(".maintenance-command-form");
    forms.forEach(function (form) {
      form.addEventListener("submit", function (event) {
        var message = form.getAttribute("data-confirm") || defaultConfirm;
        if (!window.confirm(message)) {
          event.preventDefault();
        }
      });
    });

    var templateForm = document.getElementById("email-template-form");
    var templateIdInput = document.getElementById("template_id");
    var templateNameInput = document.getElementById("template_name");
    var templateSubjectInput = document.getElementById("template_subject");
    var templatePurposeSelect = document.getElementById("template_purpose");
    var templateHtmlInput = document.getElementById("template_html");
    var templateSetDefaultInput = document.getElementById("set_default_template");
    var templateFileInput = document.getElementById("template_html_file");
    var templateResetBtn = document.getElementById("email-template-reset");
    var templateEditButtons = document.querySelectorAll(".email-template-edit-btn");

    function resetTemplateEditor() {
      if (templateIdInput) templateIdInput.value = "";
      if (templateNameInput) templateNameInput.value = "";
      if (templateSubjectInput) templateSubjectInput.value = "";
      if (templatePurposeSelect) templatePurposeSelect.value = "general";
      if (templateHtmlInput) templateHtmlInput.value = "";
      if (templateSetDefaultInput) templateSetDefaultInput.checked = false;
      if (templateFileInput) templateFileInput.value = "";
    }

    if (templateFileInput && templateHtmlInput) {
      templateFileInput.addEventListener("change", function () {
        var file = templateFileInput.files && templateFileInput.files[0] ? templateFileInput.files[0] : null;
        if (!file) return;
        if (!String(file.name || "").toLowerCase().endsWith(".html")) {
          window.alert(selectHtmlFile);
          templateFileInput.value = "";
          return;
        }
        var reader = new FileReader();
        reader.onload = function () {
          templateHtmlInput.value = typeof reader.result === "string" ? reader.result : "";
        };
        reader.onerror = function () {
          window.alert(htmlReadError);
        };
        reader.readAsText(file, "utf-8");
      });
    }

    if (templateResetBtn) {
      templateResetBtn.addEventListener("click", function () {
        resetTemplateEditor();
      });
    }

    templateEditButtons.forEach(function (button) {
      button.addEventListener("click", function () {
        if (!templateForm) return;
        var templateId = button.getAttribute("data-template-id") || "";
        var templateName = button.getAttribute("data-template-name") || "";
        var templateSubject = button.getAttribute("data-template-subject") || "";
        var templatePurpose = button.getAttribute("data-template-purpose") || "general";
        var isDefault = button.getAttribute("data-template-default") === "1";
        var htmlSourceEl = document.getElementById("email-template-html-" + templateId);
        var templateHtml = htmlSourceEl ? htmlSourceEl.value : "";

        if (templateIdInput) templateIdInput.value = templateId;
        if (templateNameInput) templateNameInput.value = templateName;
        if (templateSubjectInput) templateSubjectInput.value = templateSubject;
        if (templatePurposeSelect) templatePurposeSelect.value = templatePurpose;
        if (templateHtmlInput) templateHtmlInput.value = templateHtml;
        if (templateSetDefaultInput) templateSetDefaultInput.checked = isDefault;
        if (templateFileInput) templateFileInput.value = "";

        templateForm.scrollIntoView({ behavior: "smooth", block: "start" });
      });
    });
  })();
</script>

<%- include("partials/footer") %>
