<%- include("partials/head", { pageTitle }) %>

<div class="card app-card mb-4">
  <div class="card-body d-flex justify-content-between align-items-center gap-2 flex-wrap">
    <div>
      <h1 class="h4 app-card-title mb-1"><%= t("admin.sys.pageTitle") %></h1>
      <p class="text-muted mb-0"><%= t("admin.sys.pageSubtitle") %></p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
      <a class="btn btn-outline-secondary btn-sm" href="/admin/hub"><%= t("admin.sys.backToHub") %></a>
      <form method="post" action="/admin/logout">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <button class="btn btn-outline-secondary btn-sm" type="submit"><%= t("admin.logoutSessionButton") %></button>
      </form>
    </div>
  </div>
</div>

<% if (commandResult) { %>
  <div class="alert <%= commandResult.ok ? 'alert-success' : 'alert-danger' %>">
    <div><strong><%= t("admin.maint.commandLabel") %>:</strong> <code><%= commandResult.label %></code></div>
    <div><strong><%= t("admin.maint.exitCodeLabel") %>:</strong> <%= commandResult.code %></div>
  </div>
  <div class="card app-card mb-4">
    <div class="card-body">
      <h2 class="h6 app-card-title"><%= t("admin.sys.outputTitle") %></h2>
      <% if (commandResult.downloadPath) { %>
        <div class="mb-2">
          <a class="btn btn-sm btn-outline-primary" href="<%= commandResult.downloadPath %>">
            <%= commandResult.downloadPath.includes('/assets-backup/') ? t("admin.sys.downloadZipButton") : t("admin.sys.downloadSqlButton") %>
          </a>
        </div>
      <% } %>
      <pre class="mb-0" style="white-space: pre-wrap;"><%= commandResult.output || t("admin.sys.noOutput") %></pre>
    </div>
  </div>
<% } %>
<% if (userCreateResult) { %>
  <div class="alert <%= userCreateResult.ok ? 'alert-success' : 'alert-danger' %>">
    <%= userCreateResult.message %>
    <% if (userCreateResult.link) { %>
      <hr class="my-2">
      <div class="small">
        Se o e-mail não chegar, entregue este link ao usuário (vale uma única vez):
        <div class="mt-1"><code class="user-select-all" style="word-break:break-all;"><%= userCreateResult.link %></code></div>
      </div>
    <% } %>
  </div>
<% } %>
<% if (userUpdateResult) { %>
  <div class="alert <%= userUpdateResult.ok ? 'alert-success' : 'alert-danger' %>">
    <%= userUpdateResult.message %>
    <% if (userUpdateResult.link) { %>
      <hr class="my-2">
      <div class="small">
        Se o e-mail não chegar, entregue este link ao usuário (vale uma única vez):
        <div class="mt-1"><code class="user-select-all" style="word-break:break-all;"><%= userUpdateResult.link %></code></div>
      </div>
    <% } %>
  </div>
<% } %>
<% if (userDeleteResult) { %>
  <div class="alert <%= userDeleteResult.ok ? 'alert-success' : 'alert-danger' %>"><%= userDeleteResult.message %></div>
<% } %>
<% if (systemFontResult) { %>
  <div class="alert <%= systemFontResult.ok ? 'alert-success' : 'alert-danger' %>"><%= systemFontResult.message %></div>
<% } %>
<% if (datetimeResult) { %>
  <div class="alert <%= datetimeResult.ok ? 'alert-success' : 'alert-danger' %>"><%= datetimeResult.message %></div>
<% } %>
<% if (selfPasswordResult) { %>
  <div class="alert <%= selfPasswordResult.ok ? 'alert-success' : 'alert-danger' %>"><%= selfPasswordResult.message %></div>
<% } %>

<% if (!canManageSystem) { %>
  <div class="card app-card mb-4">
    <div class="card-body">
      <h2 class="h6 app-card-title mb-3"><%= t("admin.sys.myAccountTitle") %></h2>
      <p class="text-muted mb-3"><%= t("admin.sys.myAccountSubtitle") %></p>
      <form method="post" action="/admin/maintenance/system/password" class="row g-3">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <div class="col-12 col-md-4">
          <label class="form-label"><%= t("admin.sys.currentPasswordLabel") %></label>
          <input class="form-control" type="password" name="current_password" minlength="8" required />
        </div>
        <div class="col-12 col-md-4">
          <label class="form-label"><%= t("admin.sys.newPasswordLabel") %></label>
          <input class="form-control" type="password" name="new_password" minlength="8" required />
        </div>
        <div class="col-12 col-md-4">
          <label class="form-label"><%= t("admin.sys.confirmPasswordLabel") %></label>
          <input class="form-control" type="password" name="new_password_confirm" minlength="8" required />
        </div>
        <div class="col-12">
          <button class="btn btn-outline-primary btn-sm" type="submit"><%= t("admin.sys.savePasswordButton") %></button>
        </div>
      </form>
    </div>
  </div>
<% } %>

<div class="card app-card mb-4">
  <div class="card-body">
    <h2 class="h6 app-card-title mb-3"><%= t("admin.sys.typographyTitle") %></h2>
    <p class="text-muted mb-3"><%= t("admin.sys.typographySubtitle") %></p>
    <form method="post" action="/admin/maintenance/system/font" class="row g-3 align-items-end">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <div class="col-12 col-lg-6">
        <label class="form-label"><%= t("admin.sys.fontLabel") %></label>
        <select class="form-select" name="system_font" required>
          <% (systemFontOptions || []).forEach((fontOption) => { %>
            <option value="<%= fontOption.key %>" <%= currentSystemFont === fontOption.key ? "selected" : "" %>>
              <%= fontOption.name %>
            </option>
          <% }) %>
        </select>
      </div>
      <div class="col-12 col-lg-6">
        <div class="small text-muted">
          <% (systemFontOptions || []).forEach((fontOption) => { %>
            <div><strong><%= fontOption.name %>:</strong> <%= fontOption.description %></div>
          <% }) %>
        </div>
      </div>
      <div class="col-12">
        <button class="btn btn-outline-primary btn-sm" type="submit"><%= t("admin.sys.saveFontButton") %></button>
      </div>
    </form>
  </div>
</div>

<% if (!canManageSystem) { %>
  <div class="alert alert-info"><%= t("admin.sys.userLimitedNotice") %></div>
<% } %>

<% if (canManageSystem) { %>
<div class="card app-card mb-4">
  <div class="card-body">
    <h2 class="h6 app-card-title mb-3"><%= t("admin.sys.datetimeTitle") %></h2>
    <p class="text-muted mb-3">
      <%= t("admin.sys.datetimeCurrentLabel") %> <strong id="sysClockDisplay"><%= systemDatetimeNow %></strong>
      <% if (timezoneOffsetLabel) { %><span class="text-muted small ms-1">(<%= timezoneOffsetLabel %>)</span><% } %>
    </p>
    <form method="post" action="/admin/maintenance/system/datetime" class="row g-3 align-items-end">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <div class="col-12 col-lg-5">
        <label class="form-label"><%= t("admin.sys.timezoneLabel") %></label>
        <select class="form-select" name="timezone" required>
          <% (timezoneOptions || []).forEach(function(tz) { %>
            <option value="<%= tz.value %>" <%= systemTimezone === tz.value ? "selected" : "" %>><%= tz.label %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-12">
        <button class="btn btn-outline-primary btn-sm" type="submit"><%= t("admin.sys.saveTimezoneButton") %></button>
      </div>
    </form>
  </div>
</div>

<div class="card app-card mb-4">
  <div class="card-body">
    <h2 class="h6 app-card-title mb-3"><%= t("admin.sys.globalCommandsTitle") %></h2>
    <div class="d-flex gap-2 flex-wrap">
      <form method="post" action="/admin/maintenance/system/command" class="maintenance-command-form" data-confirm="<%= t('admin.sys.backupAllConfirm') %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <input type="hidden" name="action" value="backup_all" />
        <button class="btn btn-outline-primary btn-sm" type="submit"><%= t("admin.sys.backupAllButton") %></button>
      </form>
      <form method="post" action="/admin/maintenance/system/command" class="maintenance-command-form" data-confirm="<%= t('admin.sys.migrateAllConfirm') %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <input type="hidden" name="action" value="migrate_all" />
        <button class="btn btn-outline-primary btn-sm" type="submit"><%= t("admin.sys.migrateAllButton") %></button>
      </form>
      <form method="post" action="/admin/maintenance/system/command" class="maintenance-command-form" data-confirm="<%= t('admin.sys.seedAllConfirm') %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <input type="hidden" name="action" value="seed_all" />
        <button class="btn btn-outline-primary btn-sm" type="submit"><%= t("admin.sys.seedAllButton") %></button>
      </form>
      <form method="post" action="/admin/maintenance/system/command" class="maintenance-command-form" data-confirm="<%= t('admin.sys.clearSessionsConfirm') %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <input type="hidden" name="action" value="admin_sessions_clear" />
        <button class="btn btn-outline-warning btn-sm" type="submit"><%= t("admin.sys.clearSessionsButton") %></button>
      </form>
    </div>
  </div>
</div>

<div class="card app-card mb-4">
  <div class="card-body">
    <h2 class="h6 app-card-title mb-3"><%= t("admin.sys.backupRestoreTitle") %></h2>
    <div class="row g-3 mt-1">
      <div class="col-12 col-lg-4">
        <form
          id="maintenance-import-restore-form"
          class="border rounded p-3"
          data-url="/admin/maintenance/system/restore-import"
          data-confirm="<%= t('admin.sys.importSqlLabel') %>"
        >
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <label class="form-label"><%= t("admin.sys.importSqlLabel") %></label>
          <div class="d-flex flex-column gap-2">
            <input class="form-control" type="file" name="sqlFile" accept=".sql" required />
            <button class="btn btn-outline-primary" type="submit"><%= t("admin.sys.importBackupButton") %></button>
            <div id="maintenance-import-progress-wrap" style="display:none;">
              <div class="progress" role="progressbar" aria-label="Progresso de upload" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
                <div
                  id="maintenance-import-progress-bar"
                  class="progress-bar progress-bar-striped progress-bar-animated"
                  style="width: 0%;"
                >0%</div>
              </div>
              <small id="maintenance-import-progress-text" class="text-muted"><%= t("admin.sys.importProgress") %></small>
            </div>
            <small class="text-muted"><%= t("admin.sys.importSqlHint") %></small>
            <pre id="maintenance-import-restore-output" class="mb-0 small" style="white-space: pre-wrap; display:none;"></pre>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<div class="card app-card mb-4">
  <div class="card-body">
    <h2 class="h6 app-card-title mb-3"><%= t("admin.sys.assetsTitle") %></h2>
    <p class="text-muted mb-3"><%= t("admin.sys.assetsSubtitle") %></p>
    <div class="row g-3">
      <div class="col-12 col-lg-4">
        <div class="border rounded p-3 d-flex flex-column gap-2">
          <div class="fw-semibold small"><%= t("admin.sys.exportAssetsTitle") %></div>
          <form method="post" action="/admin/maintenance/system/command" class="maintenance-command-form" data-confirm="<%= t('admin.sys.exportAssetsConfirm') %>">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <input type="hidden" name="action" value="assets_backup" />
            <button class="btn btn-outline-primary btn-sm w-100" type="submit"><%= t("admin.sys.exportAssetsButton") %></button>
          </form>
          <small class="text-muted"><%= t("admin.sys.exportAssetsHint") %></small>
        </div>
      </div>
      <div class="col-12 col-lg-4">
        <div class="border rounded p-3 d-flex flex-column gap-2">
          <div class="fw-semibold small"><%= t("admin.sys.restoreAssetsTitle") %></div>
          <form method="post" action="/admin/maintenance/system/command" class="maintenance-command-form" data-confirm="<%= t('admin.sys.restoreAssetsConfirm') %>">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <input type="hidden" name="action" value="assets_restore" />
            <button class="btn btn-outline-danger btn-sm w-100" type="submit"><%= t("admin.sys.restoreAssetsButton") %></button>
          </form>
          <small class="text-muted"><%= t("admin.sys.restoreAssetsHint") %></small>
        </div>
      </div>
      <div class="col-12 col-lg-4">
        <form
          id="maintenance-assets-import-form"
          class="border rounded p-3"
          data-url="/admin/maintenance/system/assets-restore-import"
          data-confirm="<%= t('admin.sys.importRestoreZipConfirm') %>"
        >
          <div class="fw-semibold small mb-2"><%= t("admin.sys.importRestoreZipTitle") %></div>
          <div class="d-flex flex-column gap-2">
            <input class="form-control form-control-sm" type="file" name="zipFile" accept=".zip" required />
            <button class="btn btn-outline-primary btn-sm" type="submit"><%= t("admin.sys.importRestoreZipButton") %></button>
            <div id="maintenance-assets-import-progress-wrap" style="display:none;">
              <div class="progress" role="progressbar" aria-label="Progresso de upload" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
                <div
                  id="maintenance-assets-import-progress-bar"
                  class="progress-bar progress-bar-striped progress-bar-animated"
                  style="width: 0%;"
                >0%</div>
              </div>
              <small id="maintenance-assets-import-progress-text" class="text-muted"><%= t("admin.sys.importProgress") %></small>
            </div>
            <small class="text-muted"><%= t("admin.sys.importZipHint") %></small>
            <pre id="maintenance-assets-import-output" class="mb-0 small" style="white-space: pre-wrap; display:none;"></pre>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<div class="card app-card mb-4">
  <div class="card-body">
    <h2 class="h6 app-card-title mb-3"><%= t("admin.sys.backupsListTitle") %></h2>
    <div class="table-responsive">
      <table class="table table-sm align-middle mb-0 app-table">
        <thead>
          <tr>
            <th>ID</th>
            <th><%= t("admin.sys.colTimestamp") %></th>
            <th><%= t("admin.sys.colFile") %></th>
            <th><%= t("admin.sys.colFolder") %></th>
            <th><%= t("admin.sys.colSize") %></th>
            <th><%= t("admin.sys.colStatus") %></th>
            <th><%= t("admin.sys.colActions") %></th>
          </tr>
        </thead>
        <tbody>
          <% if (!backups || !backups.length) { %>
            <tr>
              <td colspan="7" class="text-muted"><%= t("admin.sys.noBackups") %></td>
            </tr>
          <% } %>
          <% (backups || []).forEach((backup) => { %>
            <tr>
              <td><code><%= backup.id %></code></td>
              <td><%= backup.backupTimestamp ? new Date(backup.backupTimestamp).toLocaleString(lang === "pt" ? "pt-BR" : "en-US") : "-" %></td>
              <td><code><%= backup.fileName %></code></td>
              <td><small><%= backup.folderPath || "-" %></small></td>
              <td><%= (Number(backup.sizeBytes || 0) / (1024 * 1024)).toFixed(2) %> MB</td>
              <td>
                <% if (backup.existsOnDisk) { %>
                  <span class="badge text-bg-success">OK</span>
                <% } else { %>
                  <span class="badge text-bg-danger"><%= t("admin.sys.statusMissing") %></span>
                <% } %>
              </td>
              <td>
                <div class="d-flex gap-2 flex-wrap">
                  <a class="btn btn-outline-primary btn-sm <%= backup.existsOnDisk ? '' : 'disabled' %>" href="<%= backup.existsOnDisk ? `/admin/backups/${backup.id}/download` : '#' %>" <%= backup.existsOnDisk ? '' : 'tabindex="-1" aria-disabled="true"' %>><%= t("admin.sys.downloadButton") %></a>
                  <form method="post" action="/admin/maintenance/system/command" class="maintenance-command-form" data-confirm="<%= t('admin.sys.restoreConfirm') %>">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <input type="hidden" name="action" value="db_restore_selected" />
                    <input type="hidden" name="backupId" value="<%= backup.id %>" />
                    <button class="btn btn-outline-danger btn-sm" type="submit" <%= backup.existsOnDisk ? "" : "disabled" %>><%= t("admin.sys.restoreButton") %></button>
                  </form>
                  <form method="post" action="/admin/maintenance/system/command" class="maintenance-command-form" data-confirm="<%= t('admin.sys.deleteBackupConfirm') %>">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <input type="hidden" name="action" value="db_delete_selected" />
                    <input type="hidden" name="backupId" value="<%= backup.id %>" />
                    <button class="btn btn-outline-danger btn-sm" type="submit"><%= t("admin.sys.deleteBackupButton") %></button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<div class="row g-3">
  <% maintenanceCards.forEach((card) => { %>
    <div class="col-12 col-md-6 col-xl-4">
      <article class="card app-card h-100">
        <div class="card-body d-flex flex-column gap-3">
          <div>
            <h2 class="h5 app-card-title mb-1"><%= card.title %></h2>
            <p class="text-muted mb-0"><%= card.description %></p>
          </div>
          <div class="mt-auto">
            <a class="btn btn-outline-primary btn-sm" href="<%= card.href %>"><%= t("admin.sys.accessModuleButton") %></a>
          </div>
        </div>
      </article>
    </div>
  <% }) %>
</div>

<div class="card app-card mb-4 mt-4">
  <div class="card-body">
    <h2 class="h6 app-card-title mb-3"><%= t("admin.sys.createUserTitle") %></h2>
    <form method="post" action="/admin/maintenance/system/admin-users/create" class="row g-3">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <div class="col-12 col-md-3">
        <label class="form-label"><%= t("admin.sys.usernameLabel") %></label>
        <input class="form-control" type="text" name="username" minlength="3" required />
        <small class="text-muted"><%= t("admin.sys.usernameHint") %></small>
      </div>
      <div class="col-12 col-md-3">
        <label class="form-label">E-mail</label>
        <input class="form-control" type="email" name="email" placeholder="pessoa@empresa.com" />
        <small class="text-muted">Usado para login e para o convite de criação de senha.</small>
      </div>
      <div class="col-12 col-md-3">
        <label class="form-label"><%= t("admin.sys.roleLabel") %></label>
        <select class="form-select" name="role" required>
          <% (roleOptions || []).forEach((option) => { %>
            <option value="<%= option.value %>" title="<%= option.description %>"><%= option.label %></option>
          <% }) %>
        </select>
        <small class="text-muted d-block mt-1">
          <% (roleOptions || []).forEach((option) => { %>
            <strong><%= option.label %>:</strong> <%= option.description %><br>
          <% }) %>
        </small>
      </div>
      <div class="col-12">
        <label class="form-label d-block mb-2"><%= t("admin.sys.allowedModulesLabel") %></label>
        <div class="d-flex gap-3 flex-wrap">
          <div class="form-check">
            <input class="form-check-input" type="checkbox" name="module_access" id="create_module_specflow" value="specflow" checked />
            <label class="form-check-label" for="create_module_specflow">SpecFlow</label>
          </div>
          <div class="form-check">
            <input class="form-check-input" type="checkbox" name="module_access" id="create_module_module_spec" value="module-spec" checked />
            <label class="form-check-label" for="create_module_module_spec">ModuleSpec</label>
          </div>
          <div class="form-check">
            <input class="form-check-input" type="checkbox" name="module_access" id="create_module_report_service" value="report-service" checked />
            <label class="form-check-label" for="create_module_report_service">Report Service</label>
          </div>
          <div class="form-check">
            <input class="form-check-input" type="checkbox" name="module_access" id="create_module_sentinelgrid" value="sentinelgrid" checked />
            <label class="form-check-label" for="create_module_sentinelgrid">SentinelGrid</label>
          </div>
        </div>
        <small class="text-muted"><%= t("admin.sys.adminAlwaysFullAccess") %></small>
      </div>
      <div class="col-12">
        <div class="alert alert-light border py-2 mb-0 small">
          <strong>Deixe a senha em branco</strong> para enviar um convite por e-mail — o próprio usuário
          define a senha e o e-mail é verificado no processo. Preencha a senha só se precisar criar o acesso na hora.
        </div>
      </div>
      <div class="col-12 col-md-3">
        <label class="form-label"><%= t("admin.sys.passwordLabel") %></label>
        <input class="form-control" type="password" name="password" minlength="<%= passwordMinLength %>" autocomplete="new-password" />
      </div>
      <div class="col-12 col-md-3">
        <label class="form-label"><%= t("admin.sys.passwordConfirmLabel") %></label>
        <input class="form-control" type="password" name="passwordConfirm" minlength="<%= passwordMinLength %>" autocomplete="new-password" />
      </div>
      <div class="col-12 col-md-6">
        <label class="form-label d-none d-md-block">&nbsp;</label>
        <small class="text-muted"><%= passwordRequirements %></small>
      </div>
      <div class="col-12">
        <button class="btn btn-primary" type="submit"><%= t("admin.sys.createUserButton") %></button>
      </div>
    </form>
  </div>
</div>

<div class="card app-card">
  <div class="card-body">
    <h2 class="h6 app-card-title mb-3"><%= t("admin.sys.adminUsersListTitle") %></h2>
    <div class="table-responsive">
      <table class="table table-sm align-middle mb-0 app-table">
        <thead>
          <tr>
            <th><%= t("admin.sys.colUsername") %></th>
            <th>E-mail</th>
            <th><%= t("admin.sys.colRole") %></th>
            <th><%= t("admin.sys.colModules") %></th>
            <th><%= t("admin.sys.colCreatedAt") %></th>
            <th><%= t("admin.sys.colUpdatedAt") %></th>
            <th><%= t("admin.sys.colActions") %></th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><code><%= envAdminUser || "admin" %></code> <span class="badge text-bg-secondary"><%= t("admin.sys.principalBadge") %></span></td>
            <td><small class="text-muted">definido no .env</small></td>
            <td><span class="badge text-bg-danger">Administrador</span></td>
            <td><small>SpecFlow, ModuleSpec, Report Service</small></td>
            <td>-</td>
            <td>-</td>
            <td>-</td>
          </tr>
          <% if (!users || !users.length) { %>
            <tr>
              <td colspan="7" class="text-muted"><%= t("admin.sys.noAdditionalUsers") %></td>
            </tr>
          <% } %>
          <% (users || []).forEach((user) => { %>
            <% var isAdminUser = user.role === "administrator"; %>
            <tr>
              <td><code><%= user.username %></code></td>
              <td>
                <% if (user.email) { %>
                  <small><%= user.email %></small>
                  <% if (user.emailVerifiedAt) { %>
                    <span class="badge text-bg-success" title="E-mail verificado pelo próprio usuário">verificado</span>
                  <% } else { %>
                    <span class="badge text-bg-warning" title="O usuário ainda não clicou no link enviado">não verificado</span>
                  <% } %>
                <% } else { %>
                  <small class="text-muted">sem e-mail</small>
                <% } %>
                <% if (user.status === "invited") { %>
                  <div><span class="badge text-bg-info">aguardando criar senha</span></div>
                <% } %>
              </td>
              <td><span class="badge <%= isAdminUser ? "text-bg-danger" : "text-bg-secondary" %>"><%= user.roleLabel || user.role %></span></td>
              <td><small><%= isAdminUser ? "SpecFlow, ModuleSpec, Report Service" : ((user.moduleAccess || []).join(", ") || "-") %></small></td>
              <td><%= user.createdAt ? new Date(user.createdAt).toLocaleString(lang === "pt" ? "pt-BR" : "en-US") : "-" %></td>
              <td><%= user.updatedAt ? new Date(user.updatedAt).toLocaleString(lang === "pt" ? "pt-BR" : "en-US") : "-" %></td>
              <td>
                <div class="d-flex flex-column gap-2">
                  <form method="post" action="/admin/maintenance/system/admin-users/<%= user.id %>/update" class="maintenance-user-update-form" data-confirm="<%= t('admin.sys.confirmSaveUser') %>">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <div class="d-flex flex-column gap-2">
                      <input class="form-control form-control-sm" type="text" name="username" value="<%= user.username %>" minlength="3" required />
                      <small class="text-muted"><%= t("admin.sys.usernameHint") %></small>
                      <input class="form-control form-control-sm" type="email" name="email" value="<%= user.email || "" %>" placeholder="E-mail (login e recuperação)" />
                      <select class="form-select form-select-sm" name="role" required>
                        <% (roleOptions || []).forEach((option) => { %>
                          <option value="<%= option.value %>" <%= user.role === option.value ? "selected" : "" %>><%= option.label %></option>
                        <% }) %>
                      </select>
                      <div class="border rounded p-2">
                        <div class="small fw-semibold mb-1"><%= t("admin.sys.editUserModulesLabel") %></div>
                        <div class="d-flex gap-2 flex-wrap">
                          <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="module_access" id="user_<%= user.id %>_specflow" value="specflow" <%= isAdminUser || (user.moduleAccess || []).includes("specflow") ? "checked" : "" %> />
                            <label class="form-check-label" for="user_<%= user.id %>_specflow">SpecFlow</label>
                          </div>
                          <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="module_access" id="user_<%= user.id %>_module_spec" value="module-spec" <%= isAdminUser || (user.moduleAccess || []).includes("module-spec") ? "checked" : "" %> />
                            <label class="form-check-label" for="user_<%= user.id %>_module_spec">ModuleSpec</label>
                          </div>
                          <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="module_access" id="user_<%= user.id %>_report_service" value="report-service" <%= isAdminUser || (user.moduleAccess || []).includes("report-service") ? "checked" : "" %> />
                            <label class="form-check-label" for="user_<%= user.id %>_report_service">Report Service</label>
                          </div>
                          <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="module_access" id="user_<%= user.id %>_sentinelgrid" value="sentinelgrid" <%= isAdminUser || (user.moduleAccess || []).includes("sentinelgrid") ? "checked" : "" %> />
                            <label class="form-check-label" for="user_<%= user.id %>_sentinelgrid">SentinelGrid</label>
                          </div>
                        </div>
                      </div>
                      <input class="form-control form-control-sm" type="password" name="password" minlength="<%= passwordMinLength %>" placeholder="<%= t('admin.sys.newPasswordPh') %>" autocomplete="new-password" />
                      <input class="form-control form-control-sm" type="password" name="passwordConfirm" minlength="<%= passwordMinLength %>" placeholder="<%= t('admin.sys.confirmPasswordPh') %>" autocomplete="new-password" />
                      <button class="btn btn-outline-primary btn-sm" type="submit"><%= t("admin.sys.saveUserButton") %></button>
                    </div>
                  </form>
                  <form method="post" action="/admin/maintenance/system/admin-users/<%= user.id %>/invite" class="maintenance-user-update-form" data-confirm="Enviar um link de criação de senha para <%= user.email || "este usuário" %>?">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <button class="btn btn-outline-secondary btn-sm" type="submit" <%= user.email ? "" : "disabled" %>
                            title="<%= user.email ? "Envia um link para o usuário criar a senha (vale 72h)" : "Cadastre um e-mail primeiro" %>">
                      <%= user.status === "invited" ? "Reenviar convite" : "Enviar link de senha" %>
                    </button>
                  </form>
                  <form method="post" action="/admin/maintenance/system/admin-users/<%= user.id %>/delete" class="maintenance-user-update-form" data-confirm="<%= t('admin.sys.confirmDeleteUser') %>">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <button class="btn btn-outline-danger btn-sm" type="submit"><%= t("admin.sys.deleteUserButton") %></button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<% } %>

<script>
  (function () {
    var defaultConfirm = <%- JSON.stringify(t("admin.sys.confirmExecuteCommand")) %>;
    var noOutput = <%- JSON.stringify(t("admin.sys.noOutput")) %>;
    var uploadingStatusTpl = <%- JSON.stringify(t("admin.sys.uploadingStatus")) %>;
    var uploadComplete = <%- JSON.stringify(t("admin.sys.uploadComplete")) %>;
    var importingBackup = <%- JSON.stringify(t("admin.sys.importingBackup")) %>;
    var importingAssets = <%- JSON.stringify(t("admin.sys.importingAssets")) %>;
    var invalidSqlFile = <%- JSON.stringify(t("admin.sys.invalidSqlFile")) %>;
    var onlySqlAllowed = <%- JSON.stringify(t("admin.sys.onlySqlAllowed")) %>;
    var sqlSizeLimitExceeded = <%- JSON.stringify(t("admin.sys.sqlSizeLimitExceeded")) %>;
    var selectZipFile = <%- JSON.stringify(t("admin.sys.selectZipFile")) %>;
    var onlyZipAllowed = <%- JSON.stringify(t("admin.sys.onlyZipAllowed")) %>;
    var zipSizeLimitExceeded = <%- JSON.stringify(t("admin.sys.zipSizeLimitExceeded")) %>;

    var forms = document.querySelectorAll(".maintenance-command-form, .maintenance-user-update-form");
    forms.forEach(function (form) {
      form.addEventListener("submit", function (event) {
        var message = form.getAttribute("data-confirm") || defaultConfirm;
        if (!window.confirm(message)) {
          event.preventDefault();
        }
      });
    });

    var importForm = document.getElementById("maintenance-import-restore-form");
    if (!importForm) return;

    var fileInput = importForm.querySelector('input[name="sqlFile"]');
    var csrfInput = importForm.querySelector('input[name="_csrf"]');
    var outputEl = document.getElementById("maintenance-import-restore-output");
    var progressWrap = document.getElementById("maintenance-import-progress-wrap");
    var progressBar = document.getElementById("maintenance-import-progress-bar");
    var progressText = document.getElementById("maintenance-import-progress-text");
    var submitBtn = importForm.querySelector('button[type="submit"]');
    var maxBytes = 50 * 1024 * 1024;
    var requestTimeoutMs = 25 * 60 * 1000;

    function showImportOutput(text, isError) {
      if (!outputEl) return;
      outputEl.style.display = "block";
      outputEl.style.color = isError ? "#b42318" : "#1f2937";
      outputEl.textContent = String(text || "").trim() || noOutput;
    }

    function formatBytes(bytes) {
      var value = Number(bytes || 0);
      if (value < 1024) return value + " B";
      if (value < 1024 * 1024) return (value / 1024).toFixed(1) + " KB";
      return (value / (1024 * 1024)).toFixed(2) + " MB";
    }

    function showUploadProgress() {
      if (progressWrap) progressWrap.style.display = "block";
    }

    function resetUploadProgress() {
      if (progressWrap) progressWrap.style.display = "none";
      if (progressBar) {
        progressBar.style.width = "0%";
        progressBar.textContent = "0%";
        progressBar.parentElement && progressBar.parentElement.setAttribute("aria-valuenow", "0");
      }
      if (progressText) progressText.textContent = uploadingStatusTpl.replace("{loaded}", "").replace("{total}", "");
    }

    function updateUploadProgress(percent, loaded, total) {
      var normalizedPercent = Math.max(0, Math.min(100, Math.floor(Number(percent || 0))));
      if (progressBar) {
        progressBar.style.width = normalizedPercent + "%";
        progressBar.textContent = normalizedPercent + "%";
        progressBar.parentElement && progressBar.parentElement.setAttribute("aria-valuenow", String(normalizedPercent));
      }
      if (progressText) {
        if (Number(total || 0) > 0) {
          progressText.textContent = uploadingStatusTpl.replace("{loaded}", formatBytes(loaded)).replace("{total}", formatBytes(total));
        } else {
          progressText.textContent = uploadingStatusTpl.replace("{loaded}", formatBytes(loaded)).replace(" de {total}", "");
        }
      }
    }

    function sendImportRequest(endpoint, payload, fileName, csrfTokenValue, timeoutMs, onProgress) {
      return new Promise(function (resolve, reject) {
        var xhr = new XMLHttpRequest();
        xhr.open("POST", endpoint, true);
        xhr.withCredentials = true;
        xhr.timeout = timeoutMs;
        xhr.setRequestHeader("Content-Type", "application/octet-stream");
        xhr.setRequestHeader("x-sql-file-name", fileName);
        xhr.setRequestHeader("csrf-token", csrfTokenValue || "");

        xhr.upload.onprogress = function (event) {
          if (typeof onProgress === "function" && event.lengthComputable) {
            onProgress(event.loaded, event.total);
          }
        };

        xhr.onload = function () {
          var data = null;
          try {
            data = xhr.responseText ? JSON.parse(xhr.responseText) : null;
          } catch (_parseErr) {
            data = null;
          }
          resolve({ status: xhr.status, ok: xhr.status >= 200 && xhr.status < 300, data: data });
        };

        xhr.onerror = function () {
          reject(new Error("Falha de rede durante upload."));
        };
        xhr.ontimeout = function () {
          reject(new Error("Timeout da requisicao no navegador durante a importacao."));
        };

        xhr.send(payload);
      });
    }

    var assetsImportForm = document.getElementById("maintenance-assets-import-form");
    if (assetsImportForm) {
      var assetsFileInput = assetsImportForm.querySelector('input[name="zipFile"]');
      var assetsOutputEl = document.getElementById("maintenance-assets-import-output");
      var assetsProgressWrap = document.getElementById("maintenance-assets-import-progress-wrap");
      var assetsProgressBar = document.getElementById("maintenance-assets-import-progress-bar");
      var assetsProgressText = document.getElementById("maintenance-assets-import-progress-text");
      var assetsSubmitBtn = assetsImportForm.querySelector('button[type="submit"]');
      var assetsMaxBytes = 200 * 1024 * 1024;

      function showAssetsOutput(text, isError) {
        if (!assetsOutputEl) return;
        assetsOutputEl.style.display = "block";
        assetsOutputEl.style.color = isError ? "#b42318" : "#1f2937";
        assetsOutputEl.textContent = String(text || "").trim() || noOutput;
      }

      function resetAssetsProgress() {
        if (assetsProgressWrap) assetsProgressWrap.style.display = "none";
        if (assetsProgressBar) { assetsProgressBar.style.width = "0%"; assetsProgressBar.textContent = "0%"; }
        if (assetsProgressText) assetsProgressText.textContent = uploadingStatusTpl.replace("{loaded}", "").replace("{total}", "");
      }

      function updateAssetsProgress(percent, loaded, total) {
        var p = Math.max(0, Math.min(100, Math.floor(Number(percent || 0))));
        if (assetsProgressBar) { assetsProgressBar.style.width = p + "%"; assetsProgressBar.textContent = p + "%"; }
        if (assetsProgressText && Number(total || 0) > 0) {
          assetsProgressText.textContent = uploadingStatusTpl.replace("{loaded}", formatBytes(loaded)).replace("{total}", formatBytes(total));
        }
      }

      assetsImportForm.addEventListener("submit", async function (event) {
        event.preventDefault();
        var file = assetsFileInput && assetsFileInput.files ? assetsFileInput.files[0] : null;
        if (!file) { showAssetsOutput(selectZipFile, true); return; }
        if (!String(file.name || "").toLowerCase().endsWith(".zip")) { showAssetsOutput(onlyZipAllowed, true); return; }
        if (file.size > assetsMaxBytes) { showAssetsOutput(zipSizeLimitExceeded, true); return; }

        var message = assetsImportForm.getAttribute("data-confirm") || defaultConfirm;
        if (!window.confirm(message)) return;

        if (assetsSubmitBtn) assetsSubmitBtn.disabled = true;
        resetAssetsProgress();
        if (assetsProgressWrap) assetsProgressWrap.style.display = "block";
        updateAssetsProgress(0, 0, file.size);
        showAssetsOutput(importingAssets, false);

        try {
          var endpoint = assetsImportForm.getAttribute("data-url");
          var payload = await file.arrayBuffer();
          var response = await new Promise(function (resolve, reject) {
            var xhr = new XMLHttpRequest();
            xhr.open("POST", endpoint, true);
            xhr.withCredentials = true;
            xhr.timeout = 25 * 60 * 1000;
            xhr.setRequestHeader("Content-Type", "application/octet-stream");
            xhr.setRequestHeader("x-zip-file-name", file.name);
            xhr.upload.onprogress = function (ev) {
              if (ev.lengthComputable) updateAssetsProgress((ev.loaded / ev.total) * 100, ev.loaded, ev.total);
            };
            xhr.onload = function () {
              var data = null;
              try { data = xhr.responseText ? JSON.parse(xhr.responseText) : null; } catch (_) { data = null; }
              resolve({ status: xhr.status, ok: xhr.status >= 200 && xhr.status < 300, data: data });
            };
            xhr.onerror = function () { reject(new Error("Falha de rede durante upload.")); };
            xhr.ontimeout = function () { reject(new Error("Timeout da requisicao.")); };
            xhr.send(payload);
          });
          updateAssetsProgress(100, file.size, file.size);
          var data = response.data;
          if (!response.ok || !data || data.ok !== true) {
            showAssetsOutput(data && data.output ? data.output : "Falha ao importar e restaurar assets.", true);
            return;
          }
          showAssetsOutput(data.output || "Assets restaurados com sucesso.", false);
        } catch (err) {
          showAssetsOutput(err && err.message ? err.message : "Falha inesperada ao enviar arquivo.", true);
        } finally {
          if (assetsSubmitBtn) assetsSubmitBtn.disabled = false;
        }
      });
    }

    importForm.addEventListener("submit", async function (event) {
      event.preventDefault();
      var file = fileInput && fileInput.files ? fileInput.files[0] : null;
      if (!file) {
        showImportOutput(invalidSqlFile, true);
        return;
      }
      if (!String(file.name || "").toLowerCase().endsWith(".sql")) {
        showImportOutput(onlySqlAllowed, true);
        return;
      }
      if (file.size > maxBytes) {
        showImportOutput(sqlSizeLimitExceeded, true);
        return;
      }

      var message = importForm.getAttribute("data-confirm") || defaultConfirm;
      if (!window.confirm(message)) return;

      if (submitBtn) submitBtn.disabled = true;
      resetUploadProgress();
      showUploadProgress();
      updateUploadProgress(0, 0, file.size);
      showImportOutput(importingBackup, false);

      try {
        var endpoint = importForm.getAttribute("data-url");
        var payload = await file.arrayBuffer();
        var response = await sendImportRequest(
          endpoint,
          payload,
          file.name,
          csrfInput ? csrfInput.value : "",
          requestTimeoutMs,
          function (loaded, total) {
            var percent = total > 0 ? (loaded / total) * 100 : 0;
            updateUploadProgress(percent, loaded, total);
          }
        );

        updateUploadProgress(100, file.size, file.size);
        if (progressText) {
          progressText.textContent = uploadComplete;
        }

        var data = response.data;
        if (!response.ok || !data || data.ok !== true) {
          var errorOutput = data && data.output ? data.output : "Falha ao importar o arquivo .sql.";
          showImportOutput(errorOutput, true);
          return;
        }

        showImportOutput(data.output || "Arquivo importado com sucesso.", false);
        window.setTimeout(function () {
          window.location.reload();
        }, 300);
      } catch (err) {
        showImportOutput(err && err.message ? err.message : "Falha inesperada ao enviar arquivo.", true);
      } finally {
        if (submitBtn) submitBtn.disabled = false;
      }
    });
  })();
</script>

<% if (canManageSystem && systemTimezone) { %>
<script>
(function () {
  var tz = <%- JSON.stringify(systemTimezone || '') %>;
  var el = document.getElementById("sysClockDisplay");
  if (!el || !tz) return;
  function tick() {
    try {
      el.textContent = new Intl.DateTimeFormat(<%- JSON.stringify(lang === "pt" ? "pt-BR" : "en-US") %>, {
        timeZone: tz,
        year: "numeric", month: "2-digit", day: "2-digit",
        hour: "2-digit", minute: "2-digit", second: "2-digit",
        hour12: false
      }).format(new Date());
    } catch (_) {}
  }
  tick();
  setInterval(tick, 1000);
})();
</script>
<% } %>

<%- include("partials/footer") %>
