<%- include("partials/head", { pageTitle }) %>

<div class="card app-card admin-login-card mx-auto">
  <div class="card-body">
    <h1 class="h4 app-card-title mb-3">Esqueci minha senha</h1>

    <% if (submitted) { %>
      <div class="alert alert-success">
        Se houver uma conta com esse e-mail, enviamos um link para redefinir a senha.
        Verifique também a caixa de spam. O link vale por 1 hora.
      </div>
      <div class="d-grid">
        <a class="btn btn-outline-secondary" href="/admin/login">Voltar ao login</a>
      </div>
    <% } else { %>
      <% if (rateLimited) { %>
        <div class="alert alert-warning">Muitas tentativas. Aguarde alguns minutos e tente de novo.</div>
      <% } %>

      <p class="text-muted small">
        Informe o e-mail cadastrado na sua conta. Enviaremos um link para você criar uma nova senha.
      </p>

      <form method="post" action="/admin/esqueci-senha" class="row g-3">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <div class="col-12">
          <label for="email" class="form-label">E-mail</label>
          <input id="email" name="email" type="email" class="form-control" required autofocus
                 autocomplete="email" placeholder="voce@empresa.com" />
        </div>
        <div class="col-12 d-grid">
          <button class="btn btn-primary" type="submit">Enviar link de recuperação</button>
        </div>
        <div class="col-12 text-center">
          <a href="/admin/login" class="small">Voltar ao login</a>
        </div>
      </form>
    <% } %>
  </div>
</div>

<%- include("partials/footer") %>
