<%- include("partials/head", { pageTitle }) %>

<div class="card app-card admin-login-card mx-auto">
  <div class="card-body">
    <h1 class="h4 app-card-title mb-3"><%= t("admin.loginTitle") %></h1>

    <% if (invalidCredentials) { %>
      <div class="alert alert-danger"><%= t("admin.invalidCredentials") %></div>
    <% } %>
    <% if (loginRateLimited) { %>
      <div class="alert alert-warning"><%= t("admin.loginRateLimited") %></div>
    <% } %>

    <% if (typeof passwordChanged !== "undefined" && passwordChanged) { %>
      <div class="alert alert-success">Senha definida com sucesso. Entre com suas novas credenciais.</div>
    <% } %>

    <form method="post" action="/admin/login" class="row g-3">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <div class="col-12">
        <label for="username" class="form-label">E-mail ou usuário</label>
        <input id="username" name="username" type="text" class="form-control" required autofocus
               autocomplete="username" placeholder="voce@empresa.com" />
      </div>
      <div class="col-12">
        <label for="password" class="form-label"><%= t("admin.password") %></label>
        <input id="password" name="password" type="password" class="form-control" required autocomplete="current-password" />
      </div>
      <div class="col-12 d-grid">
        <button class="btn btn-primary" type="submit"><%= t("admin.loginButton") %></button>
      </div>
      <div class="col-12 text-center">
        <a href="/admin/esqueci-senha" class="small">Esqueci minha senha</a>
      </div>
    </form>
  </div>
</div>

<%- include("partials/footer") %>
