<%- include("partials/head", { pageTitle }) %>

<div class="card app-card admin-login-card mx-auto">
  <div class="card-body">
    <h1 class="h4 app-card-title mb-3"><%= isInvite ? "Criar sua senha" : "Redefinir sua senha" %></h1>

    <% if (!tokenValid) { %>
      <div class="alert alert-danger">
        Este link é inválido, já foi usado ou expirou.
      </div>
      <div class="d-grid gap-2">
        <a class="btn btn-primary" href="/admin/esqueci-senha">Solicitar um novo link</a>
        <a class="btn btn-outline-secondary" href="/admin/login">Voltar ao login</a>
      </div>
    <% } else { %>
      <% if (errorMessage) { %>
        <div class="alert alert-danger"><%= errorMessage %></div>
      <% } %>

      <p class="text-muted small mb-1">Conta: <strong><%= accountLabel %></strong></p>
      <p class="text-muted small"><%= requirements %></p>

      <form method="post" action="<%= formAction %>" class="row g-3">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <input type="hidden" name="token" value="<%= token %>" />
        <div class="col-12">
          <label for="password" class="form-label">Nova senha</label>
          <input id="password" name="password" type="password" class="form-control" required autofocus
                 autocomplete="new-password" minlength="<%= minLength %>" />
        </div>
        <div class="col-12">
          <label for="passwordConfirm" class="form-label">Repita a nova senha</label>
          <input id="passwordConfirm" name="passwordConfirm" type="password" class="form-control" required
                 autocomplete="new-password" minlength="<%= minLength %>" />
        </div>
        <div class="col-12 d-grid">
          <button class="btn btn-primary" type="submit">Salvar senha</button>
        </div>
      </form>
    <% } %>
  </div>
</div>

<%- include("partials/footer") %>
